#!/bin/sh
# NetworkManager: wired (DHCP by default), Wi-Fi and IPv6. Manage it with
# nmcli. wpa_supplicant is its Wi-Fi backend, reached over D-Bus.

case "$1" in
    start)
        mkdir -p /run/wpa_supplicant /var/lib/NetworkManager
        wpa_supplicant -B -u -s -O /run/wpa_supplicant -P /run/wpa_supplicant.pid
        NetworkManager
        ;;
    stop)
        for pid in /run/NetworkManager/NetworkManager.pid /run/wpa_supplicant.pid; do
            [ -f "$pid" ] && kill "$(cat "$pid")" 2>/dev/null
        done
        ;;
esac
