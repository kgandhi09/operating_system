#!/bin/sh
# Early boot: mount the kernel filesystems, then run /etc/init.d/S??* start.

# /proc, /sys, /dev and /run come mounted from the initramfs (which left the
# boot mode in /run/jk-mode); mount only what is missing.
mnt() { mountpoint -q "$3" || mount -t "$1" "$2" "$3"; }
mnt proc     proc     /proc
mnt sysfs    sysfs    /sys
mnt devtmpfs devtmpfs /dev
mkdir -p /dev/pts /dev/shm
mnt devpts   devpts   /dev/pts
mnt tmpfs    tmpfs    /dev/shm
mnt tmpfs    tmpfs    /run
mnt tmpfs    tmpfs    /tmp
chmod 1777 /tmp

hostname -F /etc/hostname
ip link set lo up

for s in /etc/init.d/S[0-9][0-9]*; do
    [ -x "$s" ] && "$s" start
done
