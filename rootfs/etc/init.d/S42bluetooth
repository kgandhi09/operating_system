#!/bin/sh
# Bluetooth: the adapters' drivers, then BlueZ's bluetoothd (the desktop's
# Bluetooth applet and settings, bluetoothctl, PipeWire's Bluetooth audio).
# The drivers are modules, loaded here rather than by the kernel at boot:
# their firmware is in the image (/lib/firmware), not in the initramfs.
# Once loaded they also take adapters plugged in later.
#
# /etc/jk_os/bluetooth (optional): BLUETOOTH=no leaves it all off.

case "$1" in
    start)
        BLUETOOTH=yes
        [ -f /etc/jk_os/bluetooth ] && . /etc/jk_os/bluetooth
        [ "$BLUETOOTH" = no ] && exit 0
        for m in btusb hci_uart; do
            modprobe "$m" 2>/dev/null
        done
        # Unblock the adapters in software (the hardware switch stays in charge).
        for r in /sys/class/rfkill/rfkill*; do
            [ "$(cat "$r/type" 2>/dev/null)" = bluetooth ] && echo 0 > "$r/soft" 2>/dev/null
        done
        # Controllers that come up without an address of their own (some
        # boards' UART ones: the kernel holds them "unconfigured" and BlueZ
        # never sees them) get a stable, locally administered one, made from
        # the machine id. A device's own script may have set the real one
        # earlier (the Tab S7 FE's S07wireless, from its EFS partition).
        if command -v btmgmt >/dev/null && [ -s /etc/machine-id ]; then
            for h in /sys/class/bluetooth/hci[0-9]*; do
                [ -e "$h" ] || continue
                i=${h##*/hci}
                btmgmt --index "$i" config 2>/dev/null | grep -qi 'missing options:.*public-address' || continue
                id=$(cut -c1-10 /etc/machine-id)
                addr=$(printf '02:%s:%s:%s:%s:%02x' "$(echo "$id" | cut -c1-2)" "$(echo "$id" | cut -c3-4)" \
                    "$(echo "$id" | cut -c5-6)" "$(echo "$id" | cut -c7-8)" "$i")
                btmgmt --index "$i" public-addr "$addr" >/dev/null 2>&1 \
                    || echo "bluetooth: hci$i has no address and won't take $addr"
            done
        fi
        mkdir -p /var/lib/bluetooth
        chmod 0700 /var/lib/bluetooth
        /usr/libexec/bluetooth/bluetoothd &
        ;;
    stop)
        pkill -x bluetoothd 2>/dev/null
        ;;
esac
