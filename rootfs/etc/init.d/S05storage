#!/bin/sh
# Storage of an installed jk_os (see jk-install).
#
# The kernel's initramfs has already picked the boot mode (/run/jk-mode) and
# set up the root: the OS image with a writable layer, in RAM when live, in
# /data/system/root when installed, with the data partition (JK_DATA) on
# /data. This mounts the rest listed in /data/etc/fstab (/boot, /home,
# swap, ...); /home falls back to /data/home.
#
#   S05storage start | stop

FSTAB=/data/etc/fstab
IMAGE_ETC=/run/jk/lower/etc    # the image's own /etc, under the writable layer

# check <device>: repair an ext4 filesystem before mounting it. e2fsck exit
# codes: 0 clean, 1 fixed, 2 fixed (reboot advised), 4+ needs a human.
check() {
    fsck.ext4 -p "$1" >/dev/null 2>&1
    [ $? -lt 4 ] && return 0
    echo "storage: $1 has errors fsck -p cannot fix; run: fsck.ext4 $1" >&2
    return 1
}

# sync_system_accounts: once users exist, the installed system's /etc/passwd
# (and group, shadow, gshadow) hides the image's. System accounts a newer
# image brings (uid/gid below 1000, e.g. messagebus for D-Bus) are added to
# it; users and groups made on the system are never touched.
sync_system_accounts() {
    for pair in passwd:shadow group:gshadow; do
        f=${pair%:*} sf=${pair#*:}
        [ -f "$IMAGE_ETC/$f" ] || continue
        while IFS= read -r line; do
            name=${line%%:*}
            id=$(echo "$line" | cut -d: -f3)
            [ -n "$id" ] && [ "$id" -lt 1000 ] || continue
            grep -q "^$name:" "/etc/$f" && continue
            echo "$line" >> "/etc/$f"
            grep "^$name:" "$IMAGE_ETC/$sf" >> "/etc/$sf"
            echo "storage: added system account $name to /etc/$f"
        done < "$IMAGE_ETC/$f"
    done
}

start() {
    case "$(cat /run/jk-mode 2>/dev/null)" in
        installed|setup) ;;
        *) return 0 ;;    # live: everything is in RAM
    esac
    echo "storage: $(awk '$2 == "/data" { print $1 }' /proc/mounts) on /data"
    sync_system_accounts

    if [ -f "$FSTAB" ]; then
        while read -r spec mnt type opts _; do
            case "$spec" in ""|\#*) continue ;; esac
            dev=$(findfs "$spec" 2>/dev/null) || { echo "storage: $spec ($mnt) not found" >&2; continue; }
            if [ "$type" = swap ]; then
                swapon "$dev" && echo "storage: swap on $dev"
                continue
            fi
            [ "$type" = ext4 ] && { check "$dev" || continue; }
            mkdir -p "$mnt"
            mount -t "$type" -o "$opts" "$dev" "$mnt" && echo "storage: $dev on $mnt"
        done < "$FSTAB"
    fi

    if ! mountpoint -q /home; then
        mkdir -p /data/home
        mount --bind /data/home /home
    fi
}

stop() {
    sync
    swapoff -a 2>/dev/null
    # Reverse name order unmounts nested mounts first. /data stays: the root
    # filesystem's writable layer is on it (init remounts it read-only last).
    for m in $(awk '$2 ~ "^/(boot|home|var/log|srv|opt|mnt)(/|$)" { print $2 }' /proc/mounts | sort -r); do
        umount "$m" 2>/dev/null || mount -o remount,ro "$m" 2>/dev/null
    done
}

case "$1" in
    start) start ;;
    stop)  stop ;;
esac
