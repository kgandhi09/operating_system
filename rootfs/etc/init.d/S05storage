#!/bin/sh
# Boot mode and persistent storage (see jk-install).
#
# The mode, written to /run/jk-mode, decides what the consoles show:
#   live       the installer medium (label JK_OS: the ISO, on a USB stick or
#              CD) is attached: the consoles open the installer menu
#              (/sbin/jk-live) instead of a login prompt, and no disk is
#              mounted, so every disk is free to be partitioned.
#   installed  no installer medium, but an installed system (the ext4
#              partition labeled JK_DATA): it is mounted at /data, then
#              everything in /data/etc/fstab (/boot, /home, swap, ...);
#              /home falls back to /data/home.
#   ram        neither: RAM only, as before any install.
#
#   S05storage start   detect the mode (and mount, when installed)
#   S05storage mount   mount the installed system's storage (jk-live uses
#                      this to start the installed system from a live boot)
#   S05storage stop    unmount it

FSTAB=/data/etc/fstab

# check <device>: repair an ext4 filesystem before mounting it. e2fsck exit
# codes: 0 clean, 1 fixed, 2 fixed (reboot advised), 4+ needs a human.
check() {
    fsck.ext4 -p "$1" >/dev/null 2>&1
    [ $? -lt 4 ] && return 0
    echo "storage: $1 has errors fsck -p cannot fix; run: fsck.ext4 $1" >&2
    return 1
}

# find_labels: set $live and $data to the devices labeled JK_OS / JK_DATA.
find_labels() {
    labels=$(blkid 2>/dev/null)
    live=$(echo "$labels" | sed -n 's/^\([^:]*\):.* LABEL="JK_OS".*/\1/p' | head -n1)
    data=$(echo "$labels" | sed -n 's/^\([^:]*\):.* LABEL="JK_DATA".*/\1/p' | head -n1)
}

start() {
    # USB storage shows up a few seconds after boot. Wait up to 10 s for the
    # installer medium, but only 3 s once an installed system has been found.
    i=0
    while :; do
        find_labels
        [ -n "$live" ] && break
        [ -n "$data" ] && [ $i -ge 12 ] && break
        [ $i -ge 40 ] && break
        sleep 0.25; i=$((i + 1))
    done
    if [ -n "$live" ]; then
        echo live > /run/jk-mode
        echo "storage: booted from the installer medium ($live)"
        return 0
    fi
    if [ -z "$data" ]; then
        echo ram > /run/jk-mode
        echo "storage: no installed system found, running from RAM only"
        return 0
    fi
    echo installed > /run/jk-mode
    mount_storage
}

mount_storage() {
    [ -n "${data:-}" ] || find_labels
    [ -n "$data" ] || { echo "storage: no JK_DATA partition" >&2; return 1; }
    mountpoint -q /data && return 0
    check "$data" || return 1
    mkdir -p /data
    mount -t ext4 -o noatime "$data" /data || return 1
    echo "storage: $data on /data"

    if [ -f "$FSTAB" ]; then
        while read -r spec mnt type opts _; do
            case "$spec" in ""|\#*) continue ;; esac
            dev=$(findfs "$spec" 2>/dev/null) || { echo "storage: $spec ($mnt) not found" >&2; continue; }
            if [ "$type" = swap ]; then
                swapon "$dev" && echo "storage: swap on $dev"
                continue
            fi
            [ "$type" = ext4 ] && { check "$dev" || continue; }
            mkdir -p "$mnt"
            mount -t "$type" -o "$opts" "$dev" "$mnt" && echo "storage: $dev on $mnt"
        done < "$FSTAB"
    fi

    if ! mountpoint -q /home; then
        mkdir -p /data/home
        mount --bind /data/home /home
    fi
}

stop() {
    sync
    swapoff -a 2>/dev/null
    # Reverse name order unmounts /home (a bind of /data/home) before /data.
    for m in $(awk '$2 == "/data" || $2 ~ "^/(boot|home|var/log|srv|opt|mnt)(/|$)" { print $2 }' /proc/mounts | sort -r); do
        umount "$m" 2>/dev/null || mount -o remount,ro "$m" 2>/dev/null
    done
}

case "$1" in
    start) start ;;
    mount) mount_storage ;;
    stop)  stop ;;
esac
