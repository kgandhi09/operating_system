# BusyBox init configuration for jk_os.
# Format: <tty>::<action>:<command>

::sysinit:/etc/init.d/rcS

# Login prompts on six text consoles and on whichever serial console
# exists (PC UART, ARM PL011, or a hypervisor console):
#   tty1-tty6 (Ctrl+Alt+F1-F6)  a plain shell after logging in; jk-dev starts
#                       the dev session (a full-screen terminal) there, jk-gui
#                       the desktop; leaving either comes back to the shell
::respawn:/sbin/jk-getty tty1
::respawn:/sbin/jk-getty tty2
::respawn:/sbin/jk-getty tty3
::respawn:/sbin/jk-getty tty4
::respawn:/sbin/jk-getty tty5
::respawn:/sbin/jk-getty tty6
::respawn:/sbin/jk-getty ttyS0
::respawn:/sbin/jk-getty ttyAMA0
::respawn:/sbin/jk-getty hvc0
# USB serial console (USB device mode, e.g. a tablet's link to a PC)
::respawn:/sbin/jk-getty ttyGS0

::ctrlaltdel:/sbin/reboot
::shutdown:/etc/init.d/rcK
::restart:/sbin/init
