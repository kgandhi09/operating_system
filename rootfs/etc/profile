export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export HOME="${HOME:-/root}"
export TERM="${TERM:-linux}"
# Prompt: user@host in green (red for root), the directory in blue.
# \[ \] mark the colour codes as zero-width so line editing stays aligned.
if [ "$TERM" = dumb ]; then
    PS1='\u@\h:\w\$ '
elif [ "$(id -u)" = 0 ]; then
    PS1='\[\e[1;31m\]\u@\h\[\e[0m\] \[\e[1;34m\]\w\[\e[0m\] \[\e[1;31m\]\$\[\e[0m\] '
else
    PS1='\[\e[1;32m\]\u@\h\[\e[0m\] \[\e[1;34m\]\w\[\e[0m\] \[\e[1;32m\]\$\[\e[0m\] '
fi
export PS1
umask 022
# CMake builds with Ninja unless a project says otherwise (-G).
export CMAKE_GENERATOR=Ninja
# What jk_os's tools add (src/<tool>/data/profile.d, in name order): apt's
# programs and CUDA on PATH, the dev session's banner, the update notice.
for _f in /etc/profile.d/*.sh; do
    [ -r "$_f" ] && . "$_f"
done
unset _f
