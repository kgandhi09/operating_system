export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# Programs installed with apt (/usr/lib/jk_os/apt), after jk_os's own.
[ -d /data/apt/bin ] && PATH="$PATH:/data/apt/bin"
export HOME="${HOME:-/root}"
export TERM="${TERM:-linux}"
# Prompt: user@host in green (red for root), the directory in blue.
# \[ \] mark the colour codes as zero-width so line editing stays aligned.
if [ "$TERM" = dumb ]; then
    PS1='\u@\h:\w\$ '
elif [ "$(id -u)" = 0 ]; then
    PS1='\[\e[1;31m\]\u@\h\[\e[0m\] \[\e[1;34m\]\w\[\e[0m\] \[\e[1;31m\]\$\[\e[0m\] '
else
    PS1='\[\e[1;32m\]\u@\h\[\e[0m\] \[\e[1;34m\]\w\[\e[0m\] \[\e[1;32m\]\$\[\e[0m\] '
fi
export PS1
umask 022
# CMake builds with Ninja unless a project says otherwise (-G).
export CMAKE_GENERATOR=Ninja
# The CUDA toolkit, when installed (sudo jk-cuda install): nvcc on PATH, its
# libraries (cuBLAS, ...) found by the programs built with it.
if [ -x /usr/local/cuda/bin/nvcc ]; then
    export PATH="$PATH:/usr/local/cuda/bin"
    export LD_LIBRARY_PATH="/usr/local/cuda/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
    # jk_os's GCC (16) is newer than the ones CUDA lists as supported.
    export NVCC_APPEND_FLAGS="${NVCC_APPEND_FLAGS:--allow-unsupported-compiler}"
fi
