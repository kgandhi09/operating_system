export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# Programs installed with apt (/usr/lib/jk_os/apt), after jk_os's own.
[ -d /data/apt/bin ] && PATH="$PATH:/data/apt/bin"
export HOME="${HOME:-/root}"
export TERM="${TERM:-linux}"
# Prompt: user@host in green (red for root), the directory in blue.
# \[ \] mark the colour codes as zero-width so line editing stays aligned.
if [ "$TERM" = dumb ]; then
    PS1='\u@\h:\w\$ '
elif [ "$(id -u)" = 0 ]; then
    PS1='\[\e[1;31m\]\u@\h\[\e[0m\] \[\e[1;34m\]\w\[\e[0m\] \[\e[1;31m\]\$\[\e[0m\] '
else
    PS1='\[\e[1;32m\]\u@\h\[\e[0m\] \[\e[1;34m\]\w\[\e[0m\] \[\e[1;32m\]\$\[\e[0m\] '
fi
export PS1
umask 022
# CMake builds with Ninja unless a project says otherwise (-G).
export CMAKE_GENERATOR=Ninja
# Logging in on a text console (tty1-tty3) starts the dev session there (a
# full-screen terminal: jk-dev); leaving it comes back to this shell. Not for
# root, not in terminals (their tty is /dev/pts/N), and not with
# JK_DEV_AUTOSTART=no in ~/.config/jk_os/dev-session. If it can't start (no
# GPU, ...), the plain shell stays.
case "$(tty 2>/dev/null)" in
    /dev/tty[0-9]*)
        JK_DEV_AUTOSTART=yes
        [ -f "$HOME/.config/jk_os/dev-session" ] &&
            eval "$(grep '^JK_DEV_AUTOSTART=' "$HOME/.config/jk_os/dev-session" | tail -n1)"
        if [ "$JK_DEV_AUTOSTART" != no ] && [ "$(id -u)" != 0 ] && [ -x /usr/bin/jk-dev ] &&
           [ "$(cat /run/jk-mode 2>/dev/null)" = installed ]; then
            /usr/bin/jk-dev || echo "jk_os: the dev session did not start (see ~/.local/state/jk-dev.log); run jk-dev to try again" >&2
        fi
        unset JK_DEV_AUTOSTART ;;
esac
# The dev session's terminal opens with jk_os's banner, once: shells started
# inside it (and a ~/.zshrc that shows the banner itself) see JK_BANNER_SHOWN.
case "$-" in
    *i*)
        if [ -n "${JK_DEV_SESSION:-}" ] && [ -z "${JK_BANNER_SHOWN:-}" ] && [ -r /usr/share/jk_os/banner ]; then
            echo
            cat /usr/share/jk_os/banner
            echo
            export JK_BANNER_SHOWN=1
        fi ;;
esac
# The CUDA toolkit, when installed (sudo jk-cuda install): nvcc on PATH, its
# libraries (cuBLAS, ...) found by the programs built with it.
if [ -x /usr/local/cuda/bin/nvcc ]; then
    export PATH="$PATH:/usr/local/cuda/bin"
    export LD_LIBRARY_PATH="/usr/local/cuda/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
    # jk_os's GCC (16) is newer than the ones CUDA lists as supported.
    export NVCC_APPEND_FLAGS="${NVCC_APPEND_FLAGS:--allow-unsupported-compiler}"
fi
