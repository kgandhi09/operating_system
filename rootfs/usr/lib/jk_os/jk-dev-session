#!/bin/sh
# The dev session on a text console, run by jk-session as the user, inside the elogind
# session it opened for this console: one terminal (foot), full screen in
# the kiosk compositor cage (jk-dev starts it). Leaving the terminal ends the
# session, back to the shell jk-dev was run from. Its
# output goes to ~/.local/state/jk-dev.log.
#
# Your settings: ~/.config/jk_os/dev-session, shell variable assignments,
# for example:
#   JK_DEV_COMMAND=herdr     run this in the terminal first (then your shell)
#   XKB_DEFAULT_LAYOUT=de    keyboard layout (also XKB_DEFAULT_VARIANT, _OPTIONS)
#   JK_DEV_OUTPUTS=extend    with an external screen: mirror (default: the
#                            same terminal on every screen), extend (one
#                            terminal across them) or last (the newest only)
# The terminal itself: ~/.config/foot/foot.ini (jk_os's defaults are in
# /etc/xdg/foot/foot.ini).

export XDG_SESSION_TYPE=wayland XDG_CURRENT_DESKTOP=cage XDG_SESSION_DESKTOP=cage
# Tells the shells in its terminal they are in the dev session (/etc/profile
# greets them with jk_os's banner).
export JK_DEV_SESSION=1
export XDG_CONFIG_DIRS=/etc/xdg XDG_DATA_DIRS=/usr/local/share:/usr/share
# Programs from apt (/usr/lib/jk_os/apt), after jk_os's own.
if [ -d /data/apt/bin ]; then
    export PATH="$PATH:/data/apt/bin" XDG_DATA_DIRS="$XDG_DATA_DIRS:/data/apt/share"
fi
# The GPU to render on (NVIDIA or built-in): /usr/lib/jk_os/gpu.sh.
. /usr/lib/jk_os/gpu.sh
jk_gpu_select
# A UTF-8 locale; C.UTF-8 (shipped in /usr/lib/locale) when none is set.
case "${LANG:-}" in *UTF-8*|*utf8*) ;; *) export LANG=C.UTF-8 ;; esac

conf="${XDG_CONFIG_HOME:-$HOME/.config}/jk_os/dev-session"
if [ -f "$conf" ]; then
    set -a
    . "$conf"
    set +a
fi

state="${XDG_STATE_HOME:-$HOME/.local/state}"
mkdir -p "$state"
[ -f "$state/jk-dev.log" ] && mv -f "$state/jk-dev.log" "$state/jk-dev.log.old"

# cage: -s lets Ctrl+Alt+F1-F6 switch consoles, -d keeps foot undecorated,
# -m how several screens are used (mirror: jk_os's patch to cage).
case "${JK_DEV_OUTPUTS:-mirror}" in
    extend|last|mirror) outputs=${JK_DEV_OUTPUTS:-mirror} ;;
    *) outputs=mirror ;;
esac
if [ -n "${JK_DEV_COMMAND:-}" ]; then
    set -- foot -- /bin/sh -lc "$JK_DEV_COMMAND; exec \"\${SHELL:-/bin/sh}\" -l"
else
    set -- foot
fi
# Sound (PipeWire) runs in the session's bus: /usr/lib/jk_os/jk-audio.
exec dbus-run-session /usr/lib/jk_os/jk-audio cage -s -d -m "$outputs" -- "$@" > "$state/jk-dev.log" 2>&1
