#!/bin/sh
# The desktop session, run by jk-session as the user, inside the elogind
# session it opened for this console. Its output goes to
# ~/.local/state/jk-gui.log.

export XDG_SESSION_TYPE=wayland XDG_CURRENT_DESKTOP=KDE XDG_SESSION_DESKTOP=KDE KDE_SESSION_VERSION=6
export XDG_CONFIG_DIRS=/etc/xdg XDG_DATA_DIRS=/usr/local/share:/usr/share
# Programs and menu entries from apt (/usr/lib/jk_os/apt), after jk_os's own.
if [ -d /data/apt/bin ]; then
    export PATH="$PATH:/data/apt/bin" XDG_DATA_DIRS="$XDG_DATA_DIRS:/data/apt/share"
fi
# The GPU to render on (NVIDIA or built-in): /usr/lib/jk_os/gpu.sh.
. /usr/lib/jk_os/gpu.sh
jk_gpu_select
# Qt needs a UTF-8 locale; C.UTF-8 (shipped in /usr/lib/locale) when none is set.
case "${LANG:-}" in *UTF-8*|*utf8*) ;; *) export LANG=C.UTF-8 ;; esac

state="${XDG_STATE_HOME:-$HOME/.local/state}"
mkdir -p "$state"
[ -f "$state/jk-gui.log" ] && mv -f "$state/jk-gui.log" "$state/jk-gui.log.old"
exec dbus-run-session startplasma-wayland > "$state/jk-gui.log" 2>&1
