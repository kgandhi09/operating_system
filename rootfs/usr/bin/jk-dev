#!/bin/sh
# jk-dev: start the dev session on tty1: one full-screen terminal (foot in
# the cage compositor), for Neovim, herdr and the like.
#
# Log in on tty1 (Ctrl+Alt+F1) and run jk-dev; leaving the terminal (exit)
# comes back to the shell there. tty2 is for the desktop (jk-gui), tty3 is
# a plain text console. Settings: see /usr/lib/jk_os/jk-dev-session.

case "$(tty)" in
    /dev/tty1) ;;
    /dev/tty[0-9]*)
        # Take the user there (the keys may not reach this machine, e.g. a VM
        # window on a desktop that keeps Ctrl+Alt+F1 for itself).
        echo "jk-dev: the dev session runs on tty1; switching there: log in and run jk-dev" >&2
        echo "        (to switch yourself: Alt+F1 on a text console, Ctrl+Alt+F1 in the desktop)" >&2
        sleep 2
        chvt 1 2>/dev/null
        exit 1 ;;
    *)
        echo "jk-dev: run this on the tty1 console (Ctrl+Alt+F1), not over a serial line or SSH" >&2
        exit 1 ;;
esac
if [ ! -x /usr/bin/cage ] || [ ! -x /usr/bin/foot ]; then
    echo "jk-dev: the dev session is not installed in this image" >&2
    exit 1
fi
if [ "$(id -u)" = 0 ]; then
    echo "jk-dev: log in as a regular user to start the dev session" >&2
    exit 1
fi
if pidof cage >/dev/null 2>&1; then
    echo "jk-dev: the dev session is already running (Ctrl+Alt+F1)" >&2
    exit 1
fi
/usr/lib/jk_os/jk-session dev
rc=$?
[ "$rc" = 0 ] || echo "jk-dev: the dev session ended with an error; see ~/.local/state/jk-dev.log" >&2
exit "$rc"
