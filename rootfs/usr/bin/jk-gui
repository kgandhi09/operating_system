#!/bin/sh
# jk-gui: start the desktop (KDE Plasma) on this console.
#
# Runs on any text console (tty1-tty6, Ctrl+Alt+F1-F6): log in there and run
# jk-gui; nothing starts it by itself. Logging out of Plasma comes back to the
# shell there. One desktop per user; dev sessions (jk-dev) can run on the
# other consoles.

case "$(tty)" in
    /dev/tty[0-9]*) ;;
    *)
        echo "jk-gui: run this on a text console (tty1-tty6: Ctrl+Alt+F1-F6), not in a terminal, over a serial line or SSH" >&2
        exit 1 ;;
esac
if [ ! -x /usr/bin/startplasma-wayland ]; then
    echo "jk-gui: the desktop is not installed in this image" >&2
    exit 1
fi
if [ "$(id -u)" = 0 ]; then
    echo "jk-gui: log in as a regular user to start the desktop" >&2
    exit 1
fi
# This user's desktop, if it runs already (on which console: its XDG_VTNR).
for pid in $(pidof kwin_wayland 2>/dev/null); do
    [ "$(stat -c %u "/proc/$pid" 2>/dev/null)" = "$(id -u)" ] || continue
    vt=$(tr '\0' '\n' < "/proc/$pid/environ" 2>/dev/null | sed -n 's/^XDG_VTNR=//p')
    echo "jk-gui: your desktop is already running${vt:+ on tty$vt (Ctrl+Alt+F$vt)}" >&2
    exit 1
done
echo "Starting the desktop... (log out from its menu to come back here)"
exec /usr/lib/jk_os/jk-session
