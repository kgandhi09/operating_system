#!/bin/sh
# jk-setup: first-boot setup of an installed jk_os that has no user yet
# (installed with jk-install --auto and no --user). Every console shows it
# instead of a login prompt (/run/jk-mode = setup, see S05storage); getty
# runs it as root. Once the accounts exist, the consoles switch to login.

. /etc/os-release
. /usr/lib/jk_os/accounts.sh
C_B=$(printf '\033[1m'); C_N=$(printf '\033[0m'); C_R=$(printf '\033[1;31m')
say()  { printf '%s\n' "$*"; }
warn() { printf '%swarning:%s %s\n' "$C_R" "$C_N" "$*" >&2; }
die()  { printf '%serror:%s %s\n' "$C_R" "$C_N" "$*" >&2; release; printf 'Press Enter. '; read -r _; exit 1; }
head_line() { printf '\n%s== %s ==%s\n\n' "$C_B" "$*" "$C_N"; }
ask() {
    if [ -n "${2:-}" ]; then printf '%s [%s]: ' "$1" "$2"; else printf '%s: ' "$1"; fi
    read -r ans || exit 0
    [ -n "$ans" ] || ans="${2:-}"
}

LOCK=/run/jk-setup.lock
# release: drop the lock, unless another console took it over meanwhile.
release() {
    [ "$(cut -d' ' -f1 "$LOCK/owner" 2>/dev/null)" = "$$" ] && rm -rf "$LOCK"
}
SETUP_DONE=/data/etc/jk_os-setup-done

clear
echo
cat /usr/share/jk_os/banner
printf '\n  %sWelcome to %s%s\n\n' "$C_B" "$PRETTY_NAME" "$C_N"
say "  This computer has no user yet. Create one to finish the setup."
printf '\n  Press Enter to start. '
read -r _ || exit 0

# One console at a time. The lock names the console that has it, which this
# one can take over: whoever started it may have walked away, or it wasn't a
# person (on the tablet, the PC's ModemManager probing the USB serial port
# answers the prompt above on ttyGS0).
tty=$(tty 2>/dev/null); tty=${tty#/dev/}
while ! mkdir "$LOCK" 2>/dev/null; do
    holder= holder_tty=
    read -r holder holder_tty 2>/dev/null < "$LOCK/owner"
    if [ -n "$holder" ] && ! kill -0 "$holder" 2>/dev/null; then
        rm -rf "$LOCK"; continue        # left behind by a setup that died
    fi
    say "  The setup is already running on ${holder_tty:-another console}."
    ask "  Take it over here? (yes/no)" yes
    [ "$ans" = yes ] || exit 0
    [ -n "$holder" ] && kill "$holder" 2>/dev/null
    rm -rf "$LOCK"
done
echo "$$ ${tty:-console}" > "$LOCK/owner"
trap release EXIT

ACC_HOSTNAME=$(cat /etc/hostname)
accounts_ask
head_line "Summary"
accounts_summary
echo
ask "Create them now? (yes/no)" yes
[ "$ans" = yes ] || exit 0

# /etc is the overlay on /data/system/etc, so the changes are kept.
accounts_apply / /home
hostname -F /etc/hostname
: > "$SETUP_DONE"
sync
echo installed > /run/jk-mode

say ""
say "  Done. Log in as $ACC_USER."
sleep 2
# Every console restarts with a login prompt, this one included.
for pid in $(pidof jk-setup); do
    [ "$pid" = $$ ] || kill "$pid" 2>/dev/null
done
exit 0
