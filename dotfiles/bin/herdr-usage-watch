#!/usr/bin/env python3
"""Live agent usage readout for a Herdr side pane.

Usage: herdr-usage-watch <claude|codex> [refresh-seconds]

claude -> the same numbers Claude Code's /usage shows, read from
          https://api.anthropic.com/api/oauth/usage with the local OAuth token.
codex  -> the same numbers Codex's /status shows, read from the app-server's
          account/rateLimits/read method.
"""

import json
import os
import signal
import subprocess
import sys
import threading
import time
import urllib.error
import urllib.request
from datetime import datetime, timezone

RESET = "\033[0m"
BOLD = "\033[1m"
DIM = "\033[2m"
CYAN = "\033[36m"
GREEN = "\033[32m"
YELLOW = "\033[33m"
RED = "\033[31m"

# The usage endpoints are themselves rate limited, so a tight poll interval
# earns nothing but 429s. Back off hard when one arrives and keep showing the
# last good numbers instead of blanking the pane.
MAX_BACKOFF = 1800.0
CACHE_DIR = os.path.expanduser("~/.cache/herdr-usage-watch")


class RateLimited(Exception):
    def __init__(self, retry_after=0.0):
        Exception.__init__(self, "rate limited by the usage API")
        self.retry_after = retry_after


def cache_path(agent):
    return os.path.join(CACHE_DIR, "%s.json" % agent)


def cache_save(agent, data):
    try:
        os.makedirs(CACHE_DIR, exist_ok=True)
        with open(cache_path(agent), "w") as fh:
            json.dump({"at": time.time(), "data": data}, fh)
    except (OSError, TypeError, ValueError):
        pass


def cache_load(agent):
    try:
        with open(cache_path(agent)) as fh:
            blob = json.load(fh)
        return blob.get("data"), blob.get("at")
    except (OSError, ValueError, AttributeError):
        return None, None


def fmt_secs(seconds):
    seconds = int(round(seconds))
    if seconds < 60:
        return "%ds" % seconds
    if seconds < 3600:
        return "%dm" % (seconds // 60)
    return "%dh %dm" % (seconds // 3600, (seconds % 3600) // 60)


def width():
    try:
        return max(28, min(os.get_terminal_size().columns, 100))
    except OSError:
        return 40


def pct_color(pct):
    if pct >= 90:
        return RED
    if pct >= 70:
        return YELLOW
    return GREEN


def bar(pct, cells):
    cells = max(6, min(cells, 36))
    filled = int(round(pct / 100.0 * cells))
    filled = max(0, min(cells, filled))
    return "%s%s%s%s" % (pct_color(pct), "█" * filled, DIM + "░" * (cells - filled), RESET)


def fmt_reset(dt):
    """'resets 8pm' style, matching what /usage prints."""
    if dt is None:
        return ""
    now = datetime.now(timezone.utc).astimezone()
    local = dt.astimezone()
    hour = local.strftime("%I").lstrip("0") or "12"
    minute = local.strftime(":%M") if local.minute else ""
    ampm = local.strftime("%p").lower()
    clock = "%s%s%s" % (hour, minute, ampm)
    if local.date() == now.date():
        return clock
    if (local.date() - now.date()).days < 7:
        return "%s %s" % (local.strftime("%a"), clock)
    return "%s %s" % (local.strftime("%b %d"), clock)


def fmt_in(dt):
    if dt is None:
        return ""
    delta = (dt - datetime.now(timezone.utc)).total_seconds()
    if delta <= 0:
        return "now"
    d, rem = divmod(int(delta), 86400)
    h, rem = divmod(rem, 3600)
    m = rem // 60
    if d:
        return "%dd %dh" % (d, h)
    if h:
        return "%dh %dm" % (h, m)
    return "%dm" % m


def parse_iso(s):
    if not s:
        return None
    try:
        return datetime.fromisoformat(s.replace("Z", "+00:00"))
    except ValueError:
        return None


def from_epoch(ts):
    if ts is None:
        return None
    return datetime.fromtimestamp(ts, timezone.utc)


def row(label, pct, resets, cols):
    """label / bar / '44% used  resets 8pm'"""
    out = ["%s%s%s" % (BOLD, label, RESET)]
    pct_i = int(pct)
    detail = "%s%d%% used%s" % (pct_color(pct_i), pct_i, RESET)
    when = fmt_reset(resets)
    if when:
        detail += "  %sresets %s (%s)%s" % (DIM, when, fmt_in(resets), RESET)
    out.append("  %s" % bar(pct_i, cols - 4))
    out.append("  %s" % detail)
    return out


# --------------------------------------------------------------------------
# Claude  --  mirrors /usage
# --------------------------------------------------------------------------

CLAUDE_TITLES = [
    ("five_hour", "Current session"),
    ("seven_day", "Current week (all models)"),
    ("seven_day_opus", "Current week (Opus)"),
    ("seven_day_sonnet", "Current week (Sonnet only)"),
]


def claude_fetch():
    path = os.path.expanduser("~/.claude/.credentials.json")
    with open(path) as fh:
        creds = json.load(fh)
    oauth = creds.get("claudeAiOauth") or {}
    token = oauth.get("accessToken")
    if not token:
        raise RuntimeError("no OAuth token in ~/.claude/.credentials.json")
    expires = oauth.get("expiresAt")
    if expires and expires / 1000.0 < time.time():
        raise RuntimeError("OAuth token expired - start or resume a Claude session to refresh it")
    req = urllib.request.Request(
        "https://api.anthropic.com/api/oauth/usage",
        headers={
            "Authorization": "Bearer %s" % token,
            "Content-Type": "application/json",
            "anthropic-beta": "oauth-2025-04-20",
        },
    )
    try:
        with urllib.request.urlopen(req, timeout=10) as resp:
            return json.loads(resp.read().decode())
    except urllib.error.HTTPError as exc:
        if exc.code != 429:
            raise
        try:
            retry_after = float(exc.headers.get("Retry-After") or 0)
        except (TypeError, ValueError):
            retry_after = 0.0
        raise RateLimited(retry_after)


def claude_render(data, cols):
    lines = []
    for key, title in CLAUDE_TITLES:
        limit = data.get(key)
        if not limit or limit.get("utilization") is None:
            continue
        lines += row(title, limit["utilization"], parse_iso(limit.get("resets_at")), cols)
        lines.append("")

    for limit in data.get("limits") or []:
        if limit.get("kind") != "weekly_scoped":
            continue
        model = ((limit.get("scope") or {}).get("model") or {}).get("display_name")
        if not model or limit.get("percent") is None:
            continue
        lines += row("Current week (%s)" % model, limit["percent"], parse_iso(limit.get("resets_at")), cols)
        lines.append("")

    extra = data.get("extra_usage") or {}
    if extra.get("is_enabled") and extra.get("utilization") is not None:
        lines += row("Usage credits", extra["utilization"], None, cols)
        lines.append("")
    elif extra.get("credits_ever_enabled"):
        reason = (extra.get("disabled_reason") or "off").replace("_", " ")
        lines.append("%sUsage credits: %s%s" % (DIM, reason, RESET))
        lines.append("")

    if not lines:
        lines = ["%sNo rate limit data returned.%s" % (DIM, RESET)]
    return lines


# --------------------------------------------------------------------------
# Codex  --  mirrors /status
# --------------------------------------------------------------------------

PLAN_NAMES = {
    "free": "Free", "go": "Go", "plus": "Plus", "pro": "Pro", "prolite": "Pro Lite",
    "team": "Team", "business": "Business", "enterprise": "Enterprise",
    "edu": "Edu", "edu_plus": "Edu Plus", "edu_pro": "Edu Pro",
}


class AppServer:
    """A long-lived `codex app-server` we re-query each tick."""

    def __init__(self):
        self.proc = None
        self.next_id = 1
        self.lock = threading.Lock()

    def _start(self):
        self.proc = subprocess.Popen(
            ["codex", "app-server"],
            stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
            text=True, bufsize=1,
        )
        self._send({"id": 0, "method": "initialize",
                    "params": {"clientInfo": {"name": "herdr-usage-watch", "version": "2"}}})
        self._await(0)
        self._send({"method": "initialized", "params": None})

    def _send(self, obj):
        self.proc.stdin.write(json.dumps(obj) + "\n")
        self.proc.stdin.flush()

    def _await(self, want, timeout=20):
        deadline = time.time() + timeout
        while time.time() < deadline:
            line = self.proc.stdout.readline()
            if not line:
                raise RuntimeError("app-server closed the connection")
            try:
                msg = json.loads(line)
            except ValueError:
                continue
            if msg.get("id") == want:
                if "error" in msg:
                    raise RuntimeError(str(msg["error"]))
                return msg.get("result") or {}
        raise RuntimeError("app-server timed out")

    def rate_limits(self):
        with self.lock:
            for attempt in (1, 2):
                try:
                    if self.proc is None or self.proc.poll() is not None:
                        self._start()
                    rid = self.next_id
                    self.next_id += 1
                    self._send({"id": rid, "method": "account/rateLimits/read",
                                "params": {"excludeResetCreditDetails": False}})
                    return self._await(rid)
                except Exception:
                    if self.proc is not None:
                        self.proc.kill()
                    self.proc = None
                    if attempt == 2:
                        raise
        return {}


def codex_session_tokens():
    """Token counts from the most recent rollout, the same figures /status totals."""
    root = os.path.expanduser("~/.codex/sessions")
    newest, newest_mtime = None, 0
    for dirpath, _dirs, files in os.walk(root):
        for name in files:
            if not name.endswith(".jsonl"):
                continue
            path = os.path.join(dirpath, name)
            try:
                mtime = os.path.getmtime(path)
            except OSError:
                continue
            if mtime > newest_mtime:
                newest, newest_mtime = path, mtime
    if newest is None:
        return None
    last = None
    try:
        with open(newest, errors="replace") as fh:
            for line in fh:
                if '"total_token_usage"' in line:
                    last = line
    except OSError:
        return None
    if last is None:
        return None
    try:
        info = json.loads(last)
    except ValueError:
        return None
    while isinstance(info, dict) and "total_token_usage" not in info:
        nxt = next((v for v in info.values() if isinstance(v, dict)), None)
        if nxt is None:
            return None
        info = nxt
    usage = info.get("total_token_usage") if isinstance(info, dict) else None
    if not usage:
        return None
    usage["_age"] = newest_mtime
    return usage


def human(n):
    if n is None:
        return "-"
    for unit, size in (("M", 1000000), ("K", 1000)):
        if n >= size:
            return "%.1f%s" % (n / float(size), unit)
    return str(n)


def codex_render(data, cols):
    limits = data.get("rateLimits") or {}
    lines = []

    plan = PLAN_NAMES.get(limits.get("planType") or "", (limits.get("planType") or "unknown").title())
    lines.append("%sAccount%s  %sChatGPT · %s%s" % (BOLD, RESET, DIM, plan, RESET))
    lines.append("")

    windows = [("5h limit", limits.get("primary")), ("Weekly limit", limits.get("secondary"))]
    for label, window in windows:
        if not window:
            continue
        mins = window.get("windowDurationMins")
        if mins:
            if mins % 10080 == 0:
                label = "Weekly limit" if mins == 10080 else "%dw limit" % (mins // 10080)
            elif mins % 60 == 0:
                label = "%dh limit" % (mins // 60)
        lines += row(label, window.get("usedPercent") or 0, from_epoch(window.get("resetsAt")), cols)
        lines.append("")

    individual = limits.get("individualLimit")
    if individual:
        used = 100 - (individual.get("remainingPercent") or 0)
        lines += row("Spend limit", used, from_epoch(individual.get("resetsAt")), cols)
        lines.append("  %s%s of %s%s" % (DIM, individual.get("used"), individual.get("limit"), RESET))
        lines.append("")

    credits = limits.get("credits") or {}
    if credits.get("unlimited"):
        lines.append("%sCredits%s   unlimited" % (BOLD, RESET))
    elif credits.get("hasCredits"):
        lines.append("%sCredits%s   %s" % (BOLD, RESET, credits.get("balance")))
    resets = data.get("rateLimitResetCredits") or {}
    if resets.get("availableCount"):
        lines.append("%sResets%s    %d available %s(/status → redeem)%s"
                     % (BOLD, RESET, resets["availableCount"], DIM, RESET))

    usage = codex_session_tokens()
    if usage:
        lines.append("")
        lines.append("%sLatest session tokens%s" % (BOLD, RESET))
        lines.append("  %sin %s · out %s · total %s%s" % (
            DIM, human(usage.get("input_tokens")), human(usage.get("output_tokens")),
            human(usage.get("total_tokens")), RESET))

    if limits.get("rateLimitReachedType"):
        lines.append("")
        lines.append("%s%s%s" % (RED, limits["rateLimitReachedType"].replace("_", " "), RESET))

    return lines


# --------------------------------------------------------------------------

def main():
    agent = sys.argv[1] if len(sys.argv) > 1 else "claude"
    try:
        interval = float(sys.argv[2]) if len(sys.argv) > 2 else 300.0
    except ValueError:
        interval = 300.0
    interval = max(interval, 15.0)

    server = AppServer() if agent == "codex" else None

    def bail(_sig, _frame):
        raise KeyboardInterrupt

    for sig in (signal.SIGTERM, signal.SIGHUP):
        signal.signal(sig, bail)

    render = {"claude": claude_render, "codex": codex_render}.get(agent)
    data, fetched_at = cache_load(agent)
    backoff = 0.0

    sys.stdout.write("\033[?25l")
    try:
        while True:
            cols = width()
            note = None
            try:
                if render is None:
                    raise RuntimeError("unknown agent: %s" % agent)
                data = server.rate_limits() if agent == "codex" else claude_fetch()
                fetched_at = time.time()
                cache_save(agent, data)
                backoff = 0.0
            except RateLimited as exc:
                # Double the wait each time, starting at a minute, so a pane
                # left open overnight stops adding to the problem.
                backoff = min(MAX_BACKOFF,
                              max(exc.retry_after, backoff * 2 if backoff else max(interval, 60.0)))
                note = "%srate limited - retrying in %s%s" % (YELLOW, fmt_secs(backoff), RESET)
            except Exception as exc:  # keep the pane alive across transient failures
                note = "%s%s%s" % (RED, exc, RESET)

            wait = backoff or interval
            if data is not None:
                body = render(data, cols)
                age = time.time() - (fetched_at or 0)
                if age > wait * 1.5:
                    body.append("%slast updated %s ago%s" % (DIM, fmt_secs(age), RESET))
            else:
                body = ["%sno usage data yet%s" % (DIM, RESET)]

            out = ["\033[H\033[2J",
                   "%s%s usage%s  %s%s%s" % (CYAN + BOLD, agent, RESET, DIM,
                                             time.strftime("%H:%M:%S"), RESET)]
            if note:
                out.append(note)
            out.append("")
            out += body
            sys.stdout.write("\n".join(out) + "\n")
            sys.stdout.flush()
            time.sleep(wait)
    except KeyboardInterrupt:
        pass
    finally:
        sys.stdout.write("\033[?25h")
        sys.stdout.flush()
        if server is not None and server.proc is not None:
            server.proc.kill()


if __name__ == "__main__":
    main()
