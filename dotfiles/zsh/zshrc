# Always use steady underline cursor inside Herdr
if [[ "$HERDR_ENV" == "1" ]]; then
    PROMPT_COMMAND='printf "\e[4 q";'"$PROMPT_COMMAND"
fi

# VS Code style Herdr layout:
# Neovim on top + terminal below
code() {
    local dir="${1:-.}"

    cd "$dir" || return 1

    # Create terminal pane below, occupying 25%
    herdr pane split \
        --current \
        --direction down \
        --ratio 0.75 \
        --cwd "$PWD" \
        --no-focus >/dev/null || return 1

    # Open Neovim in the original/top pane
    vi 
}
