+/* A screen built into the machine: a laptop's or a tablet's own. */
+static bool
+output_is_builtin(struct wlr_output *wlr_output)
+{
+	return strncmp(wlr_output->name, "eDP-", 4) == 0 || strncmp(wlr_output->name, "DSI-", 4) == 0 ||
+	       strncmp(wlr_output->name, "LVDS-", 5) == 0;
+}
+
+/* The rotation -r asks for on a built-in screen; otherwise (and with -r auto)
+ * the panel's own, as it is mounted (DRM "panel orientation"; normal for an
+ * external screen). */
+static enum wl_output_transform
+output_rotation(struct cg_server *server, struct wlr_output *wlr_output)
+{
+	if (server->rotation_set && output_is_builtin(wlr_output)) {
+		return server->rotation;
+	}
+#if WLR_HAS_DRM_BACKEND
+	if (wlr_output_is_drm(wlr_output)) {
+		return wlr_drm_connector_get_panel_orientation(wlr_output);
+	}
+#endif
+	return WL_OUTPUT_TRANSFORM_NORMAL;
+}
