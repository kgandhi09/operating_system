# jk_os release and source-tree selection.
# Sourced by scripts/common.sh — keep it plain KEY=value.
#
# All sources live in this repo as plain files, so a build needs no network
# and no git. Versions are whatever those trees contain; see
# scripts/update-source.sh to replace one with a newer release.

OS_NAME=jk_os
OS_VERSION=0.1.0
OS_HOSTNAME=jk-os

# Kernel source tree for each architecture, relative to the repo root.
# Torvalds' mainline kernel supports both, so they share kernel/mainline.
# An arch that mainline can't boot would get its own tree (kernel/<name>).
KERNEL_TREE_x86_64=kernel/mainline
KERNEL_TREE_aarch64=kernel/mainline

BUSYBOX_TREE=userland/busybox

# Disk tools BusyBox lacks, used by the installer (jk-install): GPT
# partitioning (util-linux sfdisk) and journaled ext4 (e2fsprogs mkfs.ext4).
UTIL_LINUX_TREE=userland/util-linux
E2FSPROGS_TREE=userland/e2fsprogs

# User management: shadow-utils (useradd, passwd, su, login, ...) and the
# password hashing library it links (libxcrypt: yescrypt, sha512).
SHADOW_TREE=userland/shadow
LIBXCRYPT_TREE=userland/libxcrypt

# Network management: NetworkManager (nmcli), as on Ubuntu, with what it
# needs at run time: the D-Bus system bus, udev (eudev), GLib, and
# wpa_supplicant for Wi-Fi. Built as shared libraries (scripts/build-network.sh).
NETWORKMANAGER_TREE=userland/network/NetworkManager
WPA_SUPPLICANT_TREE=userland/network/wpa_supplicant
DBUS_TREE=userland/network/dbus
EUDEV_TREE=userland/network/eudev
GLIB_TREE=userland/network/glib
LIBNDP_TREE=userland/network/libndp
LIBNL_TREE=userland/network/libnl
OPENSSL_TREE=userland/network/openssl
EXPAT_TREE=userland/network/expat
PCRE2_TREE=userland/network/pcre2
LIBFFI_TREE=userland/network/libffi
ZLIB_TREE=userland/network/zlib
# nmcli's line editing (readline, on ncurses; ncurses also brings terminfo).
NCURSES_TREE=userland/network/ncurses
READLINE_TREE=userland/network/readline
