# jk_os release and source-tree selection.
# Sourced by scripts/common.sh — keep it plain KEY=value.
#
# All sources live in this repo as plain files, so a build needs no network
# and no git. Versions are whatever those trees contain; see
# scripts/update-source.sh to replace one with a newer release.

OS_NAME=jk_os
OS_VERSION=0.1.0
OS_HOSTNAME=jk-os

# Kernel source tree for each architecture, relative to the repo root.
# Torvalds' mainline kernel supports both, so they share kernel/mainline.
# An arch that mainline can't boot would get its own tree (kernel/<name>).
KERNEL_TREE_x86_64=kernel/mainline
KERNEL_TREE_aarch64=kernel/mainline

BUSYBOX_TREE=userspace/busybox

# Disk tools BusyBox lacks, used by the installer (jk-install): GPT
# partitioning (util-linux sfdisk) and journaled ext4 (e2fsprogs mkfs.ext4).
UTIL_LINUX_TREE=userspace/util-linux
E2FSPROGS_TREE=userspace/e2fsprogs

# User management: shadow-utils (useradd, passwd, su, login, ...) and the
# password hashing library it links (libxcrypt: yescrypt, sha512).
SHADOW_TREE=userspace/shadow
LIBXCRYPT_TREE=userspace/libxcrypt
# sudo: members of group wheel run commands as root with their own password.
SUDO_TREE=userspace/sudo

# Network management: NetworkManager (nmcli), as on Ubuntu, with what it
# needs at run time: the D-Bus system bus, udev (eudev), GLib, and
# wpa_supplicant for Wi-Fi. Built as shared libraries (scripts/build-network.sh).
NETWORKMANAGER_TREE=userspace/network/NetworkManager
WPA_SUPPLICANT_TREE=userspace/network/wpa_supplicant
DBUS_TREE=userspace/network/dbus
EUDEV_TREE=userspace/network/eudev
GLIB_TREE=userspace/network/glib
LIBNDP_TREE=userspace/network/libndp
LIBNL_TREE=userspace/network/libnl
OPENSSL_TREE=userspace/network/openssl
EXPAT_TREE=userspace/network/expat
PCRE2_TREE=userspace/network/pcre2
LIBFFI_TREE=userspace/network/libffi
ZLIB_TREE=userspace/network/zlib
# nmcli's line editing (readline, on ncurses; ncurses also brings terminfo).
NCURSES_TREE=userspace/network/ncurses
READLINE_TREE=userspace/network/readline
# git, with what it needs to talk to servers: curl (HTTPS, also as the curl
# command) with the Mozilla CA certificates, and the OpenSSH client (ssh://,
# git@host:..., plus ssh, scp, ssh-keygen).
CURL_TREE=userspace/network/curl
CACERT_TREE=userspace/network/ca-certificates
OPENSSH_TREE=userspace/network/openssh
GIT_TREE=userspace/git

# Toolchain for C and C++, in the OS image: GCC and Clang/LLVM (C++20 by
# default), binutils, CMake, Ninja and GDB (scripts/build-toolchain.sh).
GCC_TREE=userspace/toolchain/gcc
BINUTILS_TREE=userspace/toolchain/binutils
GDB_TREE=userspace/toolchain/gdb
GMP_TREE=userspace/toolchain/gmp
MPFR_TREE=userspace/toolchain/mpfr
MPC_TREE=userspace/toolchain/mpc
LLVM_TREE=userspace/toolchain/llvm-project
CMAKE_TREE=userspace/toolchain/cmake
NINJA_TREE=userspace/toolchain/ninja
