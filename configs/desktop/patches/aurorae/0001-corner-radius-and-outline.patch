     painter.setPen(Qt::NoPen);
     painter.setBrush(Qt::black);
     painter.setCompositionMode(QPainter::CompositionMode_DestinationOut);
-    painter.drawRect(innerRect);
+    // jk_os: with rounded corners the shadow must reach into the window's
+    // rectangle, up to the rounded edge; KWin then draws the whole image
+    // (its inner rectangle is a point in the middle), as with Breeze.
+    const qreal radius = m_theme->cornerRadius();
+    if (radius > 0) {
+        painter.setRenderHint(QPainter::Antialiasing);
+        painter.drawRoundedRect(innerRect, radius, radius);
+    } else {
+        painter.drawRect(innerRect);
+    }
     painter.end();
 
     auto shadow = std::make_shared<KDecoration3::DecorationShadow>();
     shadow->setShadow(image);
     shadow->setPadding(m_theme->padding());
-    shadow->setInnerShadowRect(innerRect);
+    shadow->setInnerShadowRect(radius > 0 ? QRectF(innerRect.center(), QSizeF(1, 1)) : innerRect);
     setShadow(shadow);
 
     m_shadow = shadow;
