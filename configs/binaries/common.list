# Prebuilt binaries pulled from GitHub releases into every jk_os image.
# scripts/fetch-binaries.sh (make binaries) reads this file plus
# configs/binaries/<arch>.list; installed files land in /usr/local/bin.
#
#   name  owner/repo  tag  asset  [member]
#
#   name    file name in /usr/local/bin
#   tag     a release tag, or `latest` (resolved once, then kept until UPDATE=1)
#   asset   glob matched against the release's asset names; exactly one must
#           match. @ARCH@ becomes x86_64 / aarch64, @DEBARCH@ amd64 / arm64.
#   member  glob for the binary's path inside an archive asset.
#           Default: the single file in the archive named <name>.
#
# The rootfs has no libc, so binaries must be static (musl or Go builds);
# the fetch refuses dynamically linked ones. An entry in <arch>.list with the
# same name replaces the one here for that arch.

jq   jqlang/jq           jq-1.8.2  jq-linux-@DEBARCH@
rg   BurntSushi/ripgrep  15.2.0    ripgrep-*-@ARCH@-unknown-linux-musl.tar.gz
fd   sharkdp/fd          v10.5.0   fd-*-@ARCH@-unknown-linux-musl.tar.gz
