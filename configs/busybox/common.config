# BusyBox options applied on top of `make defconfig`.

# One static binary: the rootfs carries no shared libraries at all.
CONFIG_STATIC=y

# tc needs traffic-control headers (CBQ) that Linux >= 6.8 no longer ships.
# CONFIG_TC is not set

# Accounts are shadow-utils' job (useradd, passwd, su, login, ...: see
# scripts/build-tools.sh). BusyBox's versions would bypass /etc/login.defs
# and can't check the yescrypt hashes shadow writes.
# CONFIG_ADDUSER is not set
# CONFIG_ADDGROUP is not set
# CONFIG_DELUSER is not set
# CONFIG_DELGROUP is not set
# CONFIG_PASSWD is not set
# CONFIG_CHPASSWD is not set
# CONFIG_CRYPTPW is not set
# CONFIG_MKPASSWD is not set
# CONFIG_SU is not set
# CONFIG_LOGIN is not set
# CONFIG_SULOGIN is not set
# CONFIG_VLOCK is not set

