# Kernel options for every jk_os arch, merged on top of the arch defconfig.

CONFIG_LOCALVERSION="-jk_os"
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_DEFAULT_HOSTNAME="jk-os"

# No loadable modules: every driver the defconfig selects is built in, so the
# kernel is one self-contained file and the rootfs ships no /lib/modules.
# CONFIG_MODULES is not set

# Root filesystem = initramfs built into the kernel image.
# CONFIG_INITRAMFS_SOURCE / ROOT_UID / ROOT_GID are set by build-kernel.sh.
CONFIG_BLK_DEV_INITRD=y
CONFIG_INITRAMFS_COMPRESSION_GZIP=y
CONFIG_TMPFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# UEFI boot; the kernel image doubles as an EFI application.
CONFIG_EFI=y
CONFIG_EFI_STUB=y

# Virtual machines (QEMU/KVM, cloud).
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_VIRTIO_BALLOON=y
CONFIG_SCSI_VIRTIO=y
CONFIG_HW_RANDOM_VIRTIO=y

# Common physical hardware: storage, USB, keyboards, wired NICs.
CONFIG_BLK_DEV_NVME=y
CONFIG_ATA=y
CONFIG_SATA_AHCI=y
CONFIG_BLK_DEV_SD=y
CONFIG_BLK_DEV_SR=y
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_STORAGE=y
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y
CONFIG_E1000=y
CONFIG_E1000E=y
CONFIG_IGB=y
CONFIG_R8169=y

# Filesystems for mounting other media.
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_ISO9660_FS=y
CONFIG_JOLIET=y

# Text console on the firmware framebuffer (no display manager / X / Wayland).
CONFIG_DRM=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
