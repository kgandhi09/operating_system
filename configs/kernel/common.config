# Kernel options for every jk_os arch, merged on top of the arch defconfig.

CONFIG_LOCALVERSION="-jk_os"
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_DEFAULT_HOSTNAME="jk-os"

# No loadable modules: every driver the defconfig selects is built in, so the
# kernel is one self-contained file and the rootfs ships no /lib/modules.
# CONFIG_MODULES is not set

# Early boot = a small initramfs built into the kernel image; it mounts the
# OS image (jk_os.squashfs, zstd) through a loop device, with an overlayfs
# layer on top. CONFIG_INITRAMFS_SOURCE / ROOT_UID / ROOT_GID are set by
# build-kernel.sh.
CONFIG_BLK_DEV_INITRD=y
CONFIG_INITRAMFS_COMPRESSION_GZIP=y
CONFIG_TMPFS=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_DEVTMPFS=y
CONFIG_OVERLAY_FS=y
CONFIG_DEVTMPFS_MOUNT=y

# UEFI boot; the kernel image doubles as an EFI application.
CONFIG_EFI=y
CONFIG_EFI_STUB=y

# Virtual machines (QEMU/KVM, cloud).
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_VIRTIO_BALLOON=y
CONFIG_SCSI_VIRTIO=y
CONFIG_HW_RANDOM_VIRTIO=y

# Common physical hardware: storage, USB, keyboards, wired NICs.
CONFIG_BLK_DEV_NVME=y
CONFIG_ATA=y
CONFIG_SATA_AHCI=y
CONFIG_BLK_DEV_SD=y
CONFIG_BLK_DEV_SR=y
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_STORAGE=y
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y
CONFIG_E1000=y
CONFIG_E1000E=y
CONFIG_IGB=y
CONFIG_R8169=y

# Networking for NetworkManager: raw packets (its DHCP client), IPv6, and the
# Wi-Fi stack (drivers for specific cards go in the arch fragments).
CONFIG_PACKET=y
CONFIG_IPV6=y
CONFIG_WLAN=y
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_RFKILL=y

# Filesystems for mounting other media.
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_ISO9660_FS=y
CONFIG_JOLIET=y

# Text console on the firmware framebuffer (no display manager / X / Wayland).
CONFIG_DRM=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y

# Wired Ethernet over USB: USB-C/USB 3 dongles and docks (Realtek, ASIX,
# Microchip), and phones sharing their connection (CDC, RNDIS, iPhone).
CONFIG_USB_NET_DRIVERS=y
CONFIG_USB_USBNET=y
CONFIG_USB_RTL8152=y
CONFIG_USB_LAN78XX=y
CONFIG_USB_NET_AX88179_178A=y
CONFIG_USB_NET_CDCETHER=y
CONFIG_USB_NET_CDC_NCM=y
CONFIG_USB_NET_RNDIS_HOST=y
CONFIG_USB_IPHETH=y

# Wi-Fi USB adapters (Realtek, MediaTek, Ralink, Atheros, Broadcom).
CONFIG_WLAN_VENDOR_REALTEK=y
CONFIG_RTL8XXXU=y
CONFIG_RTW88=y
CONFIG_RTW88_8822BU=y
CONFIG_RTW88_8822CU=y
CONFIG_RTW88_8821CU=y
CONFIG_WLAN_VENDOR_MEDIATEK=y
CONFIG_MT7601U=y
CONFIG_MT76x2U=y
CONFIG_MT7921U=y
CONFIG_MT7925U=y
CONFIG_WLAN_VENDOR_RALINK=y
CONFIG_RT2X00=y
CONFIG_RT2800USB=y
CONFIG_WLAN_VENDOR_ATH=y
CONFIG_ATH9K_HTC=y
CONFIG_WLAN_VENDOR_BROADCOM=y
CONFIG_BRCMFMAC=y
CONFIG_BRCMFMAC_USB=y

# Most network chips load firmware from /lib/firmware (userspace/firmware),
# stored zstd-compressed to keep the image small.
CONFIG_FW_LOADER_COMPRESS=y
CONFIG_FW_LOADER_COMPRESS_ZSTD=y

# Graphics and input for the desktop (jk-gui): virtio-gpu in VMs, shared
# GPU buffers, evdev input (libinput), multitouch touchpads and touchscreens.
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_UDMABUF=y
CONFIG_SYNC_FILE=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_UINPUT=y
CONFIG_HID_MULTITOUCH=y
CONFIG_I2C_HID_ACPI=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
