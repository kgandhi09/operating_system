# x86_64-only kernel options.

CONFIG_64BIT=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_KVM_GUEST=y
CONFIG_PARAVIRT=y

# VirtualBox / VMware display adapters (VMSVGA, VBoxVGA).
CONFIG_DRM_VMWGFX=y
CONFIG_DRM_VBOXVIDEO=y

# Consoles when the firmware starts the kernel directly (an installed disk
# boots the EFI stub with no boot loader, so nothing passes console=).
# x86 puts the boot loader's command line after this one, so GRUB's
# console= choice on the ISO still decides which console is primary.
CONFIG_CMDLINE_BOOL=y
CONFIG_CMDLINE="console=ttyS0,115200 console=tty0"
