# x86_64-only kernel options.

CONFIG_64BIT=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_KVM_GUEST=y
CONFIG_PARAVIRT=y

# VirtualBox / VMware display adapters (VMSVGA, VBoxVGA).
CONFIG_DRM_VMWGFX=y
CONFIG_DRM_VBOXVIDEO=y

# Consoles when the firmware starts the kernel directly (an installed disk
# boots the EFI stub with no boot loader, so nothing passes console=).
# x86 puts the boot loader's command line after this one, so GRUB's
# console= choice on the ISO still decides which console is primary.
CONFIG_CMDLINE_BOOL=y
CONFIG_CMDLINE="console=ttyS0,115200 console=tty0"

# Wired Ethernet in PCs and laptops: Intel, Realtek, Broadcom, Qualcomm
# Atheros, Marvell, Aquantia.
CONFIG_E1000E=y
CONFIG_IGB=y
CONFIG_IGC=y
CONFIG_IXGBE=y
CONFIG_R8169=y
CONFIG_TIGON3=y
CONFIG_ALX=y
CONFIG_ATL1C=y
CONFIG_SKY2=y
CONFIG_AQTION=y

# Wi-Fi cards in laptops (PCIe / M.2): Intel (all generations), Qualcomm
# Atheros, Realtek, MediaTek, Broadcom, Marvell (Surface).
CONFIG_WLAN_VENDOR_INTEL=y
CONFIG_IWLWIFI=y
CONFIG_IWLDVM=y
CONFIG_IWLMVM=y
CONFIG_IWLMLD=y
CONFIG_ATH9K=y
CONFIG_ATH10K=y
CONFIG_ATH10K_PCI=y
CONFIG_ATH11K=y
CONFIG_ATH11K_PCI=y
CONFIG_ATH12K=y
CONFIG_RTW88_8822BE=y
CONFIG_RTW88_8822CE=y
CONFIG_RTW88_8821CE=y
CONFIG_RTW88_8723DE=y
CONFIG_RTW89=y
CONFIG_RTW89_8851BE=y
CONFIG_RTW89_8852AE=y
CONFIG_RTW89_8852BE=y
CONFIG_RTW89_8852BTE=y
CONFIG_RTW89_8852CE=y
CONFIG_RTW89_8922AE=y
CONFIG_RTL_CARDS=y
CONFIG_RTL8188EE=y
CONFIG_RTL8192EE=y
CONFIG_RTL8723BE=y
CONFIG_RTL8821AE=y
CONFIG_MT7921E=y
CONFIG_MT7925E=y
CONFIG_BRCMFMAC_PCIE=y
CONFIG_BRCMSMAC=y
CONFIG_WLAN_VENDOR_MARVELL=y
CONFIG_MWIFIEX=y
CONFIG_MWIFIEX_PCIE=y

# GPUs in PCs and laptops: Intel (i915, and xe for Xe2 and newer), AMD
# (amdgpu, with the display core), NVIDIA (nouveau), QEMU's standard VGA.
CONFIG_DRM_I915=y
CONFIG_DRM_XE=y
CONFIG_DRM_AMDGPU=y
CONFIG_DRM_AMD_DC=y
CONFIG_DRM_NOUVEAU=y
CONFIG_DRM_BOCHS=y
CONFIG_ACPI_VIDEO=y
