# x86_64-only kernel options.

CONFIG_64BIT=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_KVM_GUEST=y
CONFIG_PARAVIRT=y

# VirtualBox / VMware display adapters (VMSVGA, VBoxVGA).
CONFIG_DRM_VMWGFX=y
CONFIG_DRM_VBOXVIDEO=y

# Consoles when the firmware starts the kernel directly (an installed disk
# boots the EFI stub with no boot loader, so nothing passes console=).
# x86 puts the boot loader's command line after this one, so GRUB's
# console= choice on the ISO still decides which console is primary.
CONFIG_CMDLINE_BOOL=y
CONFIG_CMDLINE="console=ttyS0,115200 console=tty0"

# Laptop and desktop storage beyond plain NVMe/SATA (common.config):
# Intel VMD, which puts the NVMe SSD behind its own PCI domain when the
# firmware's "Intel RST"/"VMD controller" option is on (most 11th-gen and
# newer Intel laptops); eMMC on budget laptops (SDHCI, PCI and ACPI); UFS.
CONFIG_VMD=y
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PCI=y
CONFIG_MMC_SDHCI_ACPI=y
CONFIG_SCSI_UFSHCD=y
CONFIG_SCSI_UFSHCD_PCI=y

# Wired Ethernet in PCs and laptops: Intel, Realtek, Broadcom, Qualcomm
# Atheros, Marvell, Aquantia.
CONFIG_E1000E=y
CONFIG_IGB=y
CONFIG_IGC=y
CONFIG_IXGBE=y
CONFIG_R8169=y
CONFIG_TIGON3=y
CONFIG_ALX=y
CONFIG_ATL1C=y
CONFIG_SKY2=y
CONFIG_AQTION=y

# Wi-Fi cards in laptops (PCIe / M.2): Intel (all generations), Qualcomm
# Atheros, Realtek, MediaTek, Broadcom, Marvell (Surface).
CONFIG_WLAN_VENDOR_INTEL=y
CONFIG_IWLWIFI=y
CONFIG_IWLDVM=y
CONFIG_IWLMVM=y
CONFIG_IWLMLD=y
CONFIG_ATH9K=y
CONFIG_ATH10K=y
CONFIG_ATH10K_PCI=y
CONFIG_ATH11K=y
CONFIG_ATH11K_PCI=y
CONFIG_ATH12K=y
CONFIG_RTW88_8822BE=y
CONFIG_RTW88_8822CE=y
CONFIG_RTW88_8821CE=y
CONFIG_RTW88_8723DE=y
CONFIG_RTW89=y
CONFIG_RTW89_8851BE=y
CONFIG_RTW89_8852AE=y
CONFIG_RTW89_8852BE=y
CONFIG_RTW89_8852BTE=y
CONFIG_RTW89_8852CE=y
CONFIG_RTW89_8922AE=y
CONFIG_RTL_CARDS=y
CONFIG_RTL8188EE=y
CONFIG_RTL8192EE=y
CONFIG_RTL8723BE=y
CONFIG_RTL8821AE=y
CONFIG_MT7921E=y
CONFIG_MT7925E=y
CONFIG_BRCMFMAC_PCIE=y
CONFIG_BRCMSMAC=y
CONFIG_WLAN_VENDOR_MARVELL=y
CONFIG_MWIFIEX=y
CONFIG_MWIFIEX_PCIE=y

# GPUs in PCs and laptops: Intel (i915, and xe for Xe2 and newer), AMD
# (amdgpu, with the display core), NVIDIA, QEMU's standard VGA.
CONFIG_DRM_I915=y
CONFIG_DRM_XE=y
CONFIG_DRM_AMDGPU=y
CONFIG_DRM_AMD_DC=y
# NVIDIA: NVIDIA's own driver (its open kernel modules, scripts/build-nvidia.sh)
# for Turing and newer, and nouveau for older cards or when that driver
# can't start. Both are loadable modules, the only ones jk_os has, so
# /etc/init.d/S11gpu picks one; everything else is built in.
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_DRM_NOUVEAU=m
CONFIG_DRM_BOCHS=y
CONFIG_ACPI_VIDEO=y

# Laptop hardware.
# Touchpads and touchscreens on I2C (i2c-hid): the SoC's I2C controllers
# (Intel LPSS with the DesignWare core, AMD's too) and the GPIO controllers
# their interrupts come through.
CONFIG_MFD_INTEL_LPSS_PCI=y
CONFIG_MFD_INTEL_LPSS_ACPI=y
CONFIG_I2C_DESIGNWARE_CORE=y
CONFIG_I2C_DESIGNWARE_PLATFORM=y
CONFIG_I2C_DESIGNWARE_PCI=y
CONFIG_PINCTRL=y
CONFIG_PINCTRL_INTEL_PLATFORM=y
CONFIG_PINCTRL_BAYTRAIL=y
CONFIG_PINCTRL_CHERRYVIEW=y
CONFIG_PINCTRL_BROXTON=y
CONFIG_PINCTRL_GEMINILAKE=y
CONFIG_PINCTRL_SUNRISEPOINT=y
CONFIG_PINCTRL_CANNONLAKE=y
CONFIG_PINCTRL_ICELAKE=y
CONFIG_PINCTRL_JASPERLAKE=y
CONFIG_PINCTRL_ELKHARTLAKE=y
CONFIG_PINCTRL_LAKEFIELD=y
CONFIG_PINCTRL_TIGERLAKE=y
CONFIG_PINCTRL_ALDERLAKE=y
CONFIG_PINCTRL_METEORLAKE=y
CONFIG_PINCTRL_METEORPOINT=y
CONFIG_PINCTRL_AMD=y
# Hotkeys (Fn keys: brightness, keyboard backlight, mic mute, ...), fan
# profiles and keyboard lights of the common laptop makers.
CONFIG_NEW_LEDS=y
CONFIG_LEDS_CLASS=y
CONFIG_INTEL_HID_EVENT=y
CONFIG_INTEL_VBTN=y
CONFIG_ASUS_WMI=y
CONFIG_ASUS_NB_WMI=y
CONFIG_ASUS_WIRELESS=y
CONFIG_HID_ASUS=y
CONFIG_IDEAPAD_LAPTOP=y
CONFIG_THINKPAD_ACPI=y
CONFIG_X86_PLATFORM_DRIVERS_HP=y
CONFIG_HP_WMI=y
CONFIG_X86_PLATFORM_DRIVERS_DELL=y
CONFIG_DELL_SMBIOS=y
CONFIG_DELL_WMI=y
CONFIG_ACER_WMI=y
CONFIG_MSI_WMI=y
# USB-C: DisplayPort and power roles (UCSI), USB4/Thunderbolt.
CONFIG_TYPEC=y
CONFIG_TYPEC_UCSI=y
CONFIG_UCSI_ACPI=y
CONFIG_USB4=y
# Built-in audio of PCs and laptops. HDA with every codec family (Realtek,
# Conexant, Cirrus, ..., HDMI/DisplayPort on Intel, AMD and NVIDIA GPUs);
# Intel's audio DSP (SOF, Skylake and newer: needed wherever the laptop has
# digital microphones, and for SoundWire codecs), its firmware and
# topologies in the initramfs (configs/firmware/x86_64.list); the machine
# drivers that tie them together; AMD's digital microphones (ACP).
CONFIG_SND_HDA_INTEL=y
CONFIG_SND_HDA_HWDEP=y
CONFIG_SND_HDA_RECONFIG=y
CONFIG_SND_HDA_INPUT_BEEP=y
CONFIG_SND_HDA_PATCH_LOADER=y
CONFIG_SND_HDA_POWER_SAVE_DEFAULT=1
CONFIG_SND_HDA_GENERIC=y
CONFIG_SND_HDA_CODEC_REALTEK=y
CONFIG_SND_HDA_CODEC_ALC260=y
CONFIG_SND_HDA_CODEC_ALC262=y
CONFIG_SND_HDA_CODEC_ALC268=y
CONFIG_SND_HDA_CODEC_ALC269=y
CONFIG_SND_HDA_CODEC_ALC662=y
CONFIG_SND_HDA_CODEC_ALC680=y
CONFIG_SND_HDA_CODEC_ALC861=y
CONFIG_SND_HDA_CODEC_ALC861VD=y
CONFIG_SND_HDA_CODEC_ALC880=y
CONFIG_SND_HDA_CODEC_ALC882=y
CONFIG_SND_HDA_CODEC_ANALOG=y
CONFIG_SND_HDA_CODEC_SIGMATEL=y
CONFIG_SND_HDA_CODEC_VIA=y
CONFIG_SND_HDA_CODEC_CONEXANT=y
CONFIG_SND_HDA_CODEC_SENARYTECH=y
CONFIG_SND_HDA_CODEC_CA0132=y
CONFIG_SND_HDA_CODEC_CMEDIA=y
CONFIG_SND_HDA_CODEC_CIRRUS=y
CONFIG_SND_HDA_CODEC_CS420X=y
CONFIG_SND_HDA_CODEC_CS421X=y
CONFIG_SND_HDA_CODEC_CS8409=y
CONFIG_SND_HDA_CODEC_HDMI=y
CONFIG_SND_HDA_CODEC_HDMI_GENERIC=y
CONFIG_SND_HDA_CODEC_HDMI_INTEL=y
CONFIG_SND_HDA_CODEC_HDMI_ATI=y
CONFIG_SND_HDA_CODEC_HDMI_NVIDIA=y
CONFIG_SND_HDA_I915=y
CONFIG_SND_SOC=y
CONFIG_SND_SOC_SOF_TOPLEVEL=y
CONFIG_SND_SOC_SOF_PCI=y
CONFIG_SND_SOC_SOF_ACPI=y
CONFIG_SND_SOC_SOF_INTEL_TOPLEVEL=y
CONFIG_SND_SOC_SOF_SKYLAKE=y
CONFIG_SND_SOC_SOF_KABYLAKE=y
CONFIG_SND_SOC_SOF_APOLLOLAKE=y
CONFIG_SND_SOC_SOF_GEMINILAKE=y
CONFIG_SND_SOC_SOF_CANNONLAKE=y
CONFIG_SND_SOC_SOF_COFFEELAKE=y
CONFIG_SND_SOC_SOF_COMETLAKE=y
CONFIG_SND_SOC_SOF_ICELAKE=y
CONFIG_SND_SOC_SOF_JASPERLAKE=y
CONFIG_SND_SOC_SOF_TIGERLAKE=y
CONFIG_SND_SOC_SOF_ELKHARTLAKE=y
CONFIG_SND_SOC_SOF_ALDERLAKE=y
CONFIG_SND_SOC_SOF_METEORLAKE=y
CONFIG_SND_SOC_SOF_LUNARLAKE=y
CONFIG_SND_SOC_SOF_PANTHERLAKE=y
CONFIG_SND_SOC_SOF_HDA_LINK=y
CONFIG_SND_SOC_SOF_HDA_AUDIO_CODEC=y
CONFIG_SOUNDWIRE=y
CONFIG_SPI=y
CONFIG_SND_SOC_SOF_INTEL_SOUNDWIRE=y
CONFIG_SND_SOC_INTEL_MACH=y
CONFIG_SND_SOC_INTEL_USER_FRIENDLY_LONG_NAMES=y
CONFIG_SND_SOC_INTEL_SKL_HDA_DSP_GENERIC_MACH=y
CONFIG_SND_SOC_INTEL_SOF_SSP_AMP_MACH=y
CONFIG_SND_SOC_INTEL_SOF_RT5682_MACH=y
CONFIG_SND_SOC_INTEL_SOF_NAU8825_MACH=y
CONFIG_SND_SOC_INTEL_SOF_ES8336_MACH=y
CONFIG_SND_SOC_INTEL_SOUNDWIRE_SOF_MACH=y
CONFIG_SND_SOC_DMIC=y
CONFIG_SND_SOC_AMD_ACP=y
CONFIG_SND_SOC_AMD_RENOIR=y
CONFIG_SND_SOC_AMD_RENOIR_MACH=y
CONFIG_SND_SOC_AMD_ACP6x=y
CONFIG_SND_SOC_AMD_YC_MACH=y
CONFIG_SND_SOC_AMD_PS=y
CONFIG_SND_SOC_AMD_PS_MACH=y
