# Firmware for x86_64 PCs and laptops (same format as common.list).

# Wired Ethernet.
driver r8169
driver tg3

# Wi-Fi cards.
driver iwlwifi
# Intel's platform tables for newer cards (loaded after the .ucode).
file iwlwifi-*.pnvm
driver ath10k_pci
driver ath11k_pci
driver ath12k
# Access-point / router radios, not found in PCs.
skip ath11k/QCN9074/*
skip ath11k/IPQ*
skip ath12k/QCN9274/*
skip ath12k/IPQ*
driver rtw88_8723d
driver rtw89_8851b
driver rtw89_8852a
driver rtw89_8852b
driver rtw89_8852bt
driver rtw89_8852c
driver rtw89_8922a
driver rtl8188ee
driver rtl8192ee
driver rtl8723be
driver rtl8821ae
driver mt7921e
driver mt7925e
driver brcmsmac
driver mwifiex_pcie

# GPUs (loaded while the kernel starts, so they are in the initramfs too).
driver i915
driver xe
driver amdgpu
driver nouveau
# NVIDIA's GSP firmware, which nouveau needs from Turing on (RTX 20, 30,
# 40, ...), in its newest version: two large blobs (Turing; Ampere and
# newer) that every chip of the family links to.
skip nvidia/*/gsp/*-535.113.01.bin
linked nvidia/*/gsp/*

# Intel's audio DSP (Sound Open Firmware, from sof-bin: see
# scripts/update-firmware.sh): the firmware for every platform, by the name
# the kernel asks for (IPC3: intel/sof/sof-<platform>.ri, IPC4:
# intel/sof-ipc4/<platform>/sof-<platform>.ri), and the
# topologies, which describe each laptop's audio wiring (HDA codecs, digital
# microphones, SoundWire). The DSP driver is built in and starts with the
# kernel, so these are in the initramfs.
file intel/sof/sof-*.ri
file intel/sof-ipc4/*/sof-*.ri
file intel/sof-tplg/*.tplg
file intel/sof-ipc4-tplg/*.tplg
file intel/sof-ace-tplg/*.tplg
