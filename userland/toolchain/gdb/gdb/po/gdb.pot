msgstr ""

#: breakpoint.c:15320
#, possible-c-format
msgid ""
"Target agent only formatted printing, like the C \"printf\" function.\n"
"Usage: agent-printf \"format string\", ARG1, ARG2, ARG3, ..., ARGN\n"
