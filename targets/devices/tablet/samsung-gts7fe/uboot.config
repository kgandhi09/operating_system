# U-Boot options for the tablet, over qcom_defconfig + qcom-phone.config.
# Room to unpack jk_os's kernel (about 60 MB uncompressed).
CONFIG_SYS_BOOTM_LEN=0x8000000
# The EFI capsule tool (firmware updates through EFI, unused here) would
# need GnuTLS on the build machine.
# CONFIG_TOOLS_MKEFICAPSULE is not set
