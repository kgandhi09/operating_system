# Samsung Galaxy Tab S7 FE Wi-Fi (SM-T733, Snapdragon 778G / SM7325). The
# 5G model (SM-T736B) is a different SoC (SM7225) and would be its own device.
#
# Its bootloader loads an Android boot.img (flashed with Odin in Download
# mode), and picks the device tree in it by qcom,msm-id / qcom,board-id. It
# falls back to Download mode with jk_os's mainline tree, but takes Samsung's:
# so it starts U-Boot with Samsung's tree, and U-Boot starts jk_os's kernel
# with jk_os's tree (android-uboot).
DEVICE_DESC="Samsung Galaxy Tab S7 FE Wi-Fi (SM-T733)"
DEVICE_ARCHS="aarch64"
DEVICE_KERNELS="samsung-mainline"
DEVICE_BOOT=android-uboot
DEVICE_STATUS="bring-up"
DEVICE_DTB=qcom/sm7325-samsung-gts7fewifi.dtb

# The initramfs is built into the kernel, and the firmware PCs and boards
# need early (42 MB of Wi-Fi and Ethernet blobs) would double the kernel's
# size. None of it is for this tablet's chips.
DEVICE_INITRAMFS_FIRMWARE=no

# jk_os is installed from the initramfs over USB (scripts/tablet-install.sh):
# it formats the data partition.
DEVICE_INITRAMFS_TOOLS="mke2fs"

# clk_ignore_unused / pd_ignore_unused: the kernel would otherwise switch off
# the display clocks and power the bootloader left on for simple-framebuffer,
# until msm claims them (and anything else still unclaimed). fbcon=rotate:
# the panel is portrait (1600x2560), the tablet is held landscape (the
# panel's rotation in the device tree says the same to msm's console). earlycon=efifb: the kernel's
# log on the display from its first line (U-Boot boots it through UEFI),
# until the console proper (tty0, landscape) takes over. To debug a hang
# where tty0 shows nothing, add keep_bootcon (the early console keeps
# writing too, unrotated, over tty0) and initcall_debug loglevel=8 (every
# init function named as it starts and returns; ~90 s to boot).
# panic=10: reboot 10 s after a panic, so U-Boot shows the log (lastlog).
DEVICE_CMDLINE="console=tty0 earlycon=efifb clk_ignore_unused pd_ignore_unused fbcon=rotate:1 panic=10"

# The stock boot image's format (T733XXS9DYF1, scripts/inspect-stock.sh):
# header v3, so the device tree goes in vendor_boot.img. --board is the
# name in stock vendor_boot's header, Samsung's project code for this
# tablet (our first image, without it, fell back to Download mode).
DEVICE_MKBOOTIMG_ARGS="--header_version 3 --os_version 11.0.0 --os_patch_level 2025-06 --pagesize 0x00001000 --base 0x00000000 --kernel_offset 0x00008000 --ramdisk_offset 0x02000000 --tags_offset 0x01e00000 --dtb_offset 0x0000000001f00000 --board SRPUF17A009"

# Samsung's boot images end with this marker after the image data; without
# it the bootloader warns (or refuses) that the kernel isn't SEAndroid
# enforcing.
DEVICE_BOOTIMG_SEANDROID=yes

# The tree Samsung's bootloader is given, and starts U-Boot with: the stock
# base tree, from the stock firmware read by scripts/inspect-stock.sh. U-Boot
# only takes the memory layout from it.
DEVICE_ABL_DTB="build/stock/AP_T733XXS9DYF1_*/vendor_boot/dtb"

# The stock firmware, read by scripts/inspect-stock.sh, and what jk_os takes
# from its vendor partition (the stock apnhlos and modem partitions, with the
# rest, are mounted by the system: rootfs/etc/init.d/S06firmware):
#   early, in the initramfs: the touchscreen's (the FT8203 has no flash and
#     takes it every time it powers up, the first time while the kernel
#     starts) and Bluetooth's (the WCN6750 is set up as it is found)
#   in the image: the GPU's microcode, the WPSS (Wi-Fi) processor's
#     firmware and the Wi-Fi board data
DEVICE_STOCK="build/stock/AP_T733XXS9DYF1_*"
DEVICE_STOCK_FIRMWARE_EARLY="tsp_focaltech/ft8203_gts7xllite.bin
    msbtfw11.mbn:qca/msbtfw11.mbn msbtfw11.tlv:qca/msbtfw11.tlv msnv11.bin:qca/msnv11.bin"
DEVICE_STOCK_FIRMWARE="a660_sqe.fw:qcom/a660_sqe.fw a660_gmu.bin:qcom/a660_gmu.bin
    wpss.mdt:qcom/sm7325/samsung/gts7fewifi/wpss.mdt
    wpss.b00:qcom/sm7325/samsung/gts7fewifi/wpss.b00 wpss.b01:qcom/sm7325/samsung/gts7fewifi/wpss.b01
    wpss.b02:qcom/sm7325/samsung/gts7fewifi/wpss.b02 wpss.b03:qcom/sm7325/samsung/gts7fewifi/wpss.b03
    wpss.b04:qcom/sm7325/samsung/gts7fewifi/wpss.b04 wpss.b05:qcom/sm7325/samsung/gts7fewifi/wpss.b05
    wpss.b06:qcom/sm7325/samsung/gts7fewifi/wpss.b06 wpss.b07:qcom/sm7325/samsung/gts7fewifi/wpss.b07
    qca6750/bdwlan.elf:ath11k/WCN6750/hw1.0/board.bin qca6750/regdb.bin:ath11k/WCN6750/hw1.0/regdb.bin"

# Stock vbmeta chains to dtbo (and recovery), which carry their own signed
# AVB footer, and Download mode refused a dtbo without one (SECURE CHECK
# FAIL: dtbo). dtbo is 24 MiB (PIT: 6144 blocks of 4 KiB). The overlays
# themselves are in dtbo/.
DEVICE_AVB_FOOTERS="dtbo:25165824"
