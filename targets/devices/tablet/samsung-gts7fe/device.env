# Samsung Galaxy Tab S7 FE Wi-Fi (SM-T733, Snapdragon 778G / SM7325). The
# 5G model (SM-T736B) is a different SoC (SM7225) and would be its own device.
#
# Its bootloader loads an Android boot.img (flashed with Odin in Download
# mode), and picks the device tree in it by qcom,msm-id / qcom,board-id.
DEVICE_DESC="Samsung Galaxy Tab S7 FE Wi-Fi (SM-T733)"
DEVICE_ARCHS="aarch64"
DEVICE_KERNELS="samsung-mainline"
DEVICE_BOOT=android-bootimg
DEVICE_STATUS="bring-up"
DEVICE_DTB=qcom/sm7325-samsung-gts7fewifi.dtb

# clk_ignore_unused / pd_ignore_unused: the kernel would otherwise switch off
# the display clocks and power the bootloader left on for simple-framebuffer,
# as no driver claims them yet.
DEVICE_CMDLINE="console=tty0 clk_ignore_unused pd_ignore_unused"

# TODO(stock): copy the stock boot.img's from scripts/inspect-stock.sh
# ("as mkbootimg arguments"); build-bootimg.sh refuses to run without them.
# For example: --header_version 2 --pagesize 4096 --base 0x00000000
#   --kernel_offset 0x00008000 --ramdisk_offset 0x02000000 --tags_offset 0x01e00000
#   --dtb_offset 0x01f00000 --os_version 13.0.0 --os_patch_level 2024-01
DEVICE_MKBOOTIMG_ARGS=""
