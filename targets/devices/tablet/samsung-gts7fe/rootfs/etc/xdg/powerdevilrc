# Plasma's power management on the tablet: the screen stays on and the
# tablet never suspends by itself. Switching the display off (DPMS) can hang
# the DSI link on this panel and let the watchdog reset the tablet (seen on
# the SM-T735), and suspend isn't brought up yet. Brightness keys and the
# brightness slider work.
[AC][Display]
DimDisplayWhenIdle=false
TurnOffDisplayWhenIdle=false
LockBeforeTurnOffDisplay=false

[AC][SuspendAndShutdown]
AutoSuspendAction=0
LidAction=0
PowerButtonAction=16

[Battery][Display]
DimDisplayWhenIdle=false
TurnOffDisplayWhenIdle=false
LockBeforeTurnOffDisplay=false

[Battery][SuspendAndShutdown]
AutoSuspendAction=0
LidAction=0
PowerButtonAction=16

[LowBattery][Display]
DimDisplayWhenIdle=false
TurnOffDisplayWhenIdle=false
LockBeforeTurnOffDisplay=false

[LowBattery][SuspendAndShutdown]
AutoSuspendAction=0
LidAction=0
PowerButtonAction=16
