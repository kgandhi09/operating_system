#!/bin/sh
# jk-charge: how the tablet charges (the SM5714 charger), kept across reboots.
#
#   jk-charge                     show the settings and the battery right now
#   sudo jk-charge fast | normal | gentle
#   sudo jk-charge input <mA>     input limit from the cable, 100-3000
#   sudo jk-charge current <mA>   current into the battery, 100-3200
#   sudo jk-charge voltage <mV>   full-charge voltage, 4000-4380
#   sudo jk-charge limit <%>      battery care: stop at this level, 50-100
#                                 (100: off), charge again 5% below it
#
#              input  current  voltage  limit
#   fast       3000   3200     4380     100
#   normal     3000   2100     4380     100    (default)
#   gentle     1500   1000     4300     80
#
# The ranges are the stock board's (Samsung's sec-battery settings); the
# driver refuses anything outside them. Without a USB-C Power Delivery driver
# the tablet takes plain 5 V, so any charger gives it at most 15 W (5 V x 3 A).
# While the battery is held at the limit the tablet runs from the charger.
# Charging always pauses below 0 or above 50 degC, whatever is set here.
#
# The settings are kept in /etc/jk_os/charge; /etc/init.d/S08charge applies
# them at boot.

CONF=/etc/jk_os/charge
CHG=/sys/class/power_supply/sm5714-charger
BAT=/sys/class/power_supply/battery
name=${0##*/}
die() { echo "$name: $*" >&2; exit 1; }

load() {
    INPUT=3000 CURRENT=2100 VOLTAGE=4380 LIMIT=100
    [ -f "$CONF" ] && . "$CONF"
}

save() {
    mkdir -p "${CONF%/*}"
    printf 'INPUT=%s\nCURRENT=%s\nVOLTAGE=%s\nLIMIT=%s\n' "$INPUT" "$CURRENT" "$VOLTAGE" "$LIMIT" > "$CONF"
}

# check <value> <min> <max> <what>
check() {
    case "$1" in ''|*[!0-9]*) die "$4: not a number: $1" ;; esac
    [ "$1" -ge "$2" ] && [ "$1" -le "$3" ] || die "$4 must be $2-$3 (got $1)"
}

apply() {
    [ -d "$CHG" ] || die "no SM5714 charger ($CHG)"
    echo $((INPUT * 1000)) > "$CHG/input_current_limit" &&
        echo $((CURRENT * 1000)) > "$CHG/constant_charge_current" &&
        echo $((VOLTAGE * 1000)) > "$CHG/constant_charge_voltage" &&
        echo "$LIMIT" > "$BAT/charge_control_end_threshold" &&
        echo $((LIMIT - 5)) > "$BAT/charge_control_start_threshold" ||
        die "the charger refused the settings"
}

# rd <file>: a power supply attribute, or "?"
rd() { cat "$1" 2>/dev/null || echo '?'; }

show() {
    load
    echo "Charging settings ($CONF):"
    echo "  input limit:     $INPUT mA"
    echo "  battery current: $CURRENT mA"
    echo "  full voltage:    $VOLTAGE mV"
    if [ "$LIMIT" -lt 100 ]; then
        echo "  battery care:    stop at $LIMIT%, charge again below $((LIMIT - 5))%"
    else
        echo "  battery care:    off (charge to 100%)"
    fi
    [ -d "$BAT" ] || return 0
    ua=$(rd "$BAT/current_now") uv=$(rd "$BAT/voltage_now") t=$(rd "$BAT/temp")
    echo "Now:"
    echo "  battery: $(rd "$BAT/capacity")%, $(rd "$BAT/status")"
    case "$ua$uv" in
        *'?'*) ;;
        *) awk -v i="$ua" -v v="$uv" 'BEGIN { printf "  %+d mA at %.3f V (%+.2f W)\n", i / 1000, v / 1e6, i * v / 1e12 }' ;;
    esac
    [ "$t" != '?' ] && awk -v t="$t" 'BEGIN { printf "  temperature: %.1f degC\n", t / 10 }'
    echo "  charger: $( [ "$(rd "$CHG/online")" = 1 ] && echo connected || echo 'not connected'), health $(rd "$CHG/health")"
}

load
case "${1:-}" in
    "") show; exit ;;
    --boot) apply 2>/dev/null; exit ;;
    -h|--help) sed -n '2,25p' "$0" | sed 's/^# \{0,1\}//'; exit ;;
    fast)    INPUT=3000 CURRENT=3200 VOLTAGE=4380 LIMIT=100 ;;
    normal)  INPUT=3000 CURRENT=2100 VOLTAGE=4380 LIMIT=100 ;;
    gentle)  INPUT=1500 CURRENT=1000 VOLTAGE=4300 LIMIT=80 ;;
    input)   check "$2" 100 3000 "input limit (mA)"; INPUT=$2 ;;
    current) check "$2" 100 3200 "battery current (mA)"; CURRENT=$2 ;;
    voltage) check "$2" 4000 4380 "full voltage (mV)"; VOLTAGE=$2 ;;
    limit)   check "$2" 50 100 "battery care limit (%)"; LIMIT=$2 ;;
    *) die "usage: $name [fast|normal|gentle | input <mA> | current <mA> | voltage <mV> | limit <%>]" ;;
esac
[ "$(id -u)" = 0 ] || exec sudo "$0" "$@"
apply
save
show
