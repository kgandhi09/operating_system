# U-Boot's environment on the tablet (scripts/build-uboot.sh; @CMDLINE@ is
# DEVICE_CMDLINE). Based on U-Boot's board/qualcomm/qcom-phone.env.
#
# Samsung's bootloader loads vendor_boot's ramdisk, which here is the FIT
# image with jk_os's kernel and device tree (build-bootimg.sh), and records
# where in its own device tree; U-Boot reads that into
# $prevbl_initrd_start_addr and boots it.

# A few seconds before booting, so U-Boot's lines can be read during bring-up.
bootdelay=3
bootretry=-1
stdin=serial,button-kbd
stdout=serial,vidconsole
stderr=serial,vidconsole

bootargs=@CMDLINE@

# The previous kernel's console log, if it left one in its ramoops region
# (the device tree's ramoops@f0b00000: record, console, ftrace and pmsg sizes
# as there). After a crash or a forced reboot it is on the display here for
# a while before the next boot.
lastlog=pstore set 0xf0b00000 0x100000 0x40000 0x40000 0x40000 0x40000; \
	pstore display console; sleep 15

# Boot through UEFI (bootefi): the kernel's EFI stub takes over U-Boot's
# framebuffer, so earlycon=efifb shows its log from the very first line.
jk_os=echo Starting jk_os from ${prevbl_initrd_start_addr}; \
	imxtract ${prevbl_initrd_start_addr} kernel ${kernel_addr_r}; \
	imxtract ${prevbl_initrd_start_addr} fdt ${fdt_addr_r}; \
	cls; bootefi ${kernel_addr_r} ${fdt_addr_r}

# The same through bootm (no early console), from the menu.
jk_os_bootm=cls; bootm ${prevbl_initrd_start_addr}

# If booting fails, U-Boot's messages stay on the display a few seconds,
# then the menu opens.
bootcmd=run lastlog; run jk_os; sleep 10; run menucmd
menucmd=setenv bootcmd run menucmd; bootmenu -1

bootmenu_0=Boot jk_os=run jk_os; sleep 10
bootmenu_6=Boot jk_os (bootm)=run jk_os_bootm; sleep 10
bootmenu_7=Last kernel log=run lastlog
bootmenu_1=Enable serial console gadget=run serial_gadget
bootmenu_2=Drop to shell=setenv bootretry -1
bootmenu_3=Reset device=reset
bootmenu_4=Dump environment=printenv; pause
bootmenu_5=Board info=bdinfo; pause

serial_gadget=setenv stdin serial,button-kbd,usbacm; \
	setenv stdout serial,vidconsole,usbacm; \
	setenv stderr serial,vidconsole,usbacm; \
	echo Enabled U-Boot console serial gadget

fastboot=fastboot -l $fastboot_addr_r usb 0

button_cmd_0_name=Volume Down
button_cmd_0=run menucmd
