# U-Boot's environment on the tablet (scripts/build-uboot.sh; @CMDLINE@ is
# DEVICE_CMDLINE). Based on U-Boot's board/qualcomm/qcom-phone.env.
#
# Samsung's bootloader loads vendor_boot's ramdisk, which here is the FIT
# image with jk_os's kernel and device tree (build-bootimg.sh), and records
# where in its own device tree; U-Boot reads that into
# $prevbl_initrd_start_addr and boots it.

# A few seconds before booting, so U-Boot's lines can be read during bring-up.
bootdelay=3
bootretry=-1
stdin=serial,button-kbd
stdout=serial,vidconsole
stderr=serial,vidconsole

bootargs=@CMDLINE@
jk_os=echo Starting jk_os from ${prevbl_initrd_start_addr}; bootm ${prevbl_initrd_start_addr}

# U-Boot's messages stay on the display for a few seconds if booting fails,
# then the menu opens.
bootcmd=run jk_os; pause; run menucmd
menucmd=setenv bootcmd run menucmd; bootmenu -1

bootmenu_0=Boot jk_os=run jk_os; pause
bootmenu_1=Enable serial console gadget=run serial_gadget
bootmenu_2=Drop to shell=setenv bootretry -1
bootmenu_3=Reset device=reset
bootmenu_4=Dump environment=printenv; pause
bootmenu_5=Board info=bdinfo; pause

serial_gadget=setenv stdin serial,button-kbd,usbacm; \
	setenv stdout serial,vidconsole,usbacm; \
	setenv stderr serial,vidconsole,usbacm; \
	echo Enabled U-Boot console serial gadget

fastboot=fastboot -l $fastboot_addr_r usb 0

button_cmd_0_name=Volume Down
button_cmd_0=run menucmd
