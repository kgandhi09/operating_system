CATEGORY_DESC="tablets (Android bootloaders)"

# Every tablet's initramfs has the USB console (initramfs/etc/jk/early) and
# installs jk_os over it (initramfs/bin/jk-receive, for
# scripts/tablet-install.sh), which formats the data partition: e2fsprogs'
# mke2fs (BusyBox has no ext4). Added to the device's DEVICE_INITRAMFS_TOOLS.
CATEGORY_INITRAMFS_TOOLS="mke2fs"
