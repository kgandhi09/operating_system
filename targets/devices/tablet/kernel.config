# Every tablet: USB device mode, for the USB console (network and a serial
# console to the PC over the USB cable, set up through configfs by the
# initramfs's etc/jk/early/10-usb-console) and the install over USB
# (scripts/tablet-install.sh). The USB controller's own driver (dwc3, ...)
# is the device's or kernel profile's.
CONFIG_USB_GADGET=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_MASS_STORAGE=y
