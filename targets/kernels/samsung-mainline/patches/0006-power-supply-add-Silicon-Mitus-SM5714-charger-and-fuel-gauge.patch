From: jk_os <jk_os@jkrobotics.tech>
Subject: [PATCH] power: supply: add Silicon Mitus SM5714 charger and fuel gauge driver

The SM5714 interface PMIC of the Samsung Galaxy Tab S7 FE (and other
Samsung devices) holds a USB switching charger (I2C 0x49) and a fuel
gauge (I2C 0x71). Mainline has no driver for it, so the battery level is
invisible and the charger watchdog the bootloader leaves running is never
fed, which stops charging shortly after boot.

This driver binds to the charger address, reaches the fuel gauge at its
fixed address, and registers two power supplies: "battery" (capacity,
voltage, current, temperature from the gauge, read exactly as Samsung's
driver does) and "sm5714-charger" (online, status, health, current
limits). It only reads the gauge and never reloads its battery model.
Unless enable_charging=0, on VBUS it programs what Samsung's driver does
on cable attach, with a 3000 mA input limit (the 5 V default of any
USB-C source; AICL backs off on weaker ones), the board's maximum 3200 mA
charge current and 4.38 V float voltage, and kicks the watchdog every 30 s.
The watchdog is switched off across suspend, when nothing kicks it.

The input limit, charge current and float voltage are writable within
the stock board's maxima (3000 mA, 3200 mA, 4.38 V), and the battery's
charge_control_end/start_threshold hold the charge at a level for
battery care.

Register layout, encodings and sequences come from Samsung's GPL
sm5714 MFD, charger and fuel gauge drivers (SM-T735 kernel source).

---
--- a/drivers/power/supply/Kconfig	2026-10-04 23:53:02.948137419 +0530
+++ b/drivers/power/supply/Kconfig	2026-10-04 23:53:19.997098249 +0530
@@ -866,6 +866,21 @@
 	  devices provide USB power supply information and also required
 	  for USB OTG role switching.
 
+config CHARGER_SM5714
+	tristate "Silicon Mitus SM5714 charger and fuel gauge"
+	depends on I2C
+	select REGMAP_I2C
+	help
+	  Say Y to include support for the switching charger and fuel gauge
+	  of the Silicon Mitus SM5714 interface PMIC, found in Samsung
+	  Galaxy devices such as the Galaxy Tab S7 FE. The driver reports
+	  the battery state of charge, voltage, current and temperature,
+	  and by default enables charging at the board's rated limits while
+	  a charger is attached.
+
+	  To compile this driver as a module, choose M here: the
+	  module will be called sm5714_charger.
+
 config CHARGER_SMB347
 	tristate "Summit Microelectronics SMB3XX Battery Charger"
 	depends on I2C
--- a/drivers/power/supply/Makefile	2026-10-04 23:53:02.948283922 +0530
+++ b/drivers/power/supply/Makefile	2026-10-04 23:53:19.997135154 +0530
@@ -108,6 +108,7 @@
 obj-$(CONFIG_CHARGER_BQ256XX)	+= bq256xx_charger.o
 obj-$(CONFIG_CHARGER_RK817)	+= rk817_charger.o
 obj-$(CONFIG_CHARGER_S2M)	+= s2m-charger.o
+obj-$(CONFIG_CHARGER_SM5714)	+= sm5714_charger.o
 obj-$(CONFIG_CHARGER_SMB347)	+= smb347-charger.o
 obj-$(CONFIG_CHARGER_TPS65090)	+= tps65090-charger.o
 obj-$(CONFIG_CHARGER_TPS65217)	+= tps65217_charger.o
--- /dev/null
+++ b/drivers/power/supply/sm5714_charger.c	2026-10-04 23:53:20.000138033 +0530
@@ -0,0 +1,1135 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Silicon Mitus SM5714 switching charger and fuel gauge
+ *
+ * The SM5714 is an interface PMIC with a USB switching charger, a fuel
+ * gauge, a MUIC and a flash LED driver. Its blocks answer at separate I2C
+ * addresses: charger at 0x49 (the device this driver binds to), fuel
+ * gauge at 0x71, MUIC at 0x25. This driver exposes the charger and the
+ * fuel gauge as power supplies.
+ *
+ * Register layout, encodings and the charge enable sequence come from
+ * Samsung's GPL drivers (drivers/mfd/sm/sm5714, drivers/battery/charger/
+ * sm5714_charger, drivers/battery/fuelgauge/sm5714_fuelgauge).
+ *
+ * The fuel gauge keeps its battery model and state for as long as the
+ * battery is connected; Samsung's bootloader and kernel load the model
+ * and set an "init done" flag. This driver only reads the gauge and never
+ * writes its battery tables, it warns if the flag is missing.
+ *
+ * Unless the enable_charging module parameter is cleared, the driver
+ * also does what Samsung's driver does when a cable is attached: set
+ * the input/charge currents and the stock float voltage, enable
+ * charging and keep the charger's watchdog fed. The bootloader leaves
+ * the watchdog running, so without this charging stops shortly after
+ * boot.
+ *
+ * The input limit, charge current and float voltage can be changed at run
+ * time (the charger's input_current_limit, constant_charge_current and
+ * constant_charge_voltage), within the stock board's maxima. The battery's
+ * charge_control_end_threshold holds the charge at a level for battery
+ * care: charging pauses there, the system still runs from VBUS, and
+ * resumes below charge_control_start_threshold.
+ */
+
+#include <linux/bitfield.h>
+#include <linux/bits.h>
+#include <linux/delay.h>
+#include <linux/devm-helpers.h>
+#include <linux/i2c.h>
+#include <linux/minmax.h>
+#include <linux/mod_devicetable.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/power_supply.h>
+#include <linux/property.h>
+#include <linux/regmap.h>
+#include <linux/workqueue.h>
+
+#define SM5714_FG_I2C_ADDR		0x71
+
+/* Charger block (8-bit registers) */
+#define SM5714_CHG_REG_STATUS1		0x0d
+#define  SM5714_STATUS1_VBUSPOK		BIT(0)
+#define  SM5714_STATUS1_VBUSUVLO	BIT(1)
+#define  SM5714_STATUS1_VBUSOVP		BIT(2)
+#define SM5714_CHG_REG_STATUS2		0x0e
+#define  SM5714_STATUS2_AICL		BIT(0)
+#define  SM5714_STATUS2_BATOVP		BIT(1)
+#define  SM5714_STATUS2_NOBAT		BIT(2)
+#define  SM5714_STATUS2_CHGON		BIT(3)
+#define  SM5714_STATUS2_TOPOFF		BIT(5)
+#define  SM5714_STATUS2_DONE		BIT(6)
+#define  SM5714_STATUS2_WDTMROFF	BIT(7)
+#define SM5714_CHG_REG_STATUS3		0x0f
+#define  SM5714_STATUS3_THEMSHDN	BIT(1)
+#define  SM5714_STATUS3_TRICKLETMROFF	BIT(4)
+#define  SM5714_STATUS3_FASTTMROFF	BIT(5)
+#define  SM5714_STATUS3_VSYSOVP		BIT(7)
+#define SM5714_CHG_REG_CNTL1		0x13
+#define  SM5714_CNTL1_ENQ4FET		BIT(3)
+#define  SM5714_CNTL1_AICLEN_VBUS	BIT(6)
+#define SM5714_CHG_REG_CNTL2		0x14
+#define  SM5714_CNTL2_OP_MODE		GENMASK(3, 0)
+#define  SM5714_OP_MODE_CHG_ON_VBUS	0x5
+#define SM5714_CHG_REG_VBUSCNTL		0x15
+#define  SM5714_VBUSCNTL_LIMIT		GENMASK(6, 0)
+#define SM5714_CHG_REG_CHGCNTL2		0x18
+#define SM5714_CHG_REG_CHGCNTL4		0x1a
+#define  SM5714_CHGCNTL4_BATREG		GENMASK(5, 0)
+#define  SM5714_CHGCNTL4_AUTOSTOP	BIT(6)
+#define SM5714_CHG_REG_WDTCNTL		0x22
+#define  SM5714_WDTCNTL_EN		BIT(0)
+#define  SM5714_WDTCNTL_TIME		GENMASK(2, 1)
+#define  SM5714_WDT_TIME_90S		0x2
+#define  SM5714_WDTCNTL_KICK		BIT(3)
+#define  SM5714_WDTCNTL_CLEAR		BIT(6)
+#define SM5714_CHG_REG_FACTORY1		0x25
+#define  SM5714_FACTORY1_NOZX		BIT(0)
+#define  SM5714_FACTORY1_ENBYPASS	BIT(1)
+#define SM5714_CHG_REG_CHGCNTL11	0x46
+#define  SM5714_CHGCNTL11_AICL_TH	GENMASK(7, 6)
+#define  SM5714_AICL_TH_4_5V		0x2
+#define SM5714_CHG_REG_DEVICEID		0x50
+#define  SM5714_DEVICEID_VENDOR		GENMASK(2, 0)
+
+/* Fuel gauge block (8-bit addresses, 16-bit little-endian registers) */
+#define SM5714_FG_REG_DEVICE_ID		0x00
+#define SM5714_FG_REG_SYSTEM_STATUS	0x10
+#define  SM5714_FG_SYS_INIT_DONE	BIT(12)
+#define  SM5714_FG_SYS_NENQ4		BIT(15)
+#define SM5714_FG_REG_AUX_STAT		0x22
+#define  SM5714_FG_AUX_CHG_DETECT	BIT(5)
+#define  SM5714_FG_AUX_CURR_X2_5	BIT(10)
+#define SM5714_FG_REG_SRAM_RADDR	0x8c
+#define SM5714_FG_REG_SRAM_RDATA	0x8d
+
+/* Fuel gauge SRAM words, read through RADDR/RDATA */
+#define SM5714_FG_SRAM_SOC		0x00
+#define SM5714_FG_SRAM_OCV		0x01
+#define SM5714_FG_SRAM_VBAT		0x03
+#define SM5714_FG_SRAM_CURRENT		0x05
+#define SM5714_FG_SRAM_TEMPERATURE	0x07
+#define SM5714_FG_SRAM_VBAT_AVG		0x08
+#define SM5714_FG_SRAM_CURRENT_AVG	0x09
+
+#define SM5714_SIGN			BIT(15)
+#define SM5714_MAGNITUDE		GENMASK(14, 0)
+
+/* Stock board values (sec-battery node of the SM-T733 device tree) */
+#define SM5714_FLOAT_MV_MAX		4380	/* battery,chg_float_voltage */
+#define SM5714_INPUT_MA_MAX		3000	/* battery,max_input_current */
+#define SM5714_CHARGE_MA_MAX		3200	/* battery,max_charging_current */
+#define SM5714_RECHARGE_MV		4310	/* battery,recharge_condition_vcell */
+#define SM5714_FULL_SOC			93	/* battery,full_condition_soc */
+
+/* Lowest values accepted at run time */
+#define SM5714_LIMIT_MA_MIN		100
+#define SM5714_FLOAT_MV_MIN		4000
+#define SM5714_END_PCT_MIN		50
+
+/* Charge only between these battery temperatures (0.1 degC) */
+#define SM5714_TEMP_MIN			0
+#define SM5714_TEMP_MIN_RESUME		30
+#define SM5714_TEMP_MAX			500
+#define SM5714_TEMP_MAX_RESUME		450
+
+#define SM5714_POLL_MS			30000	/* well under the 90 s watchdog */
+
+static bool enable_charging = true;
+module_param(enable_charging, bool, 0444);
+MODULE_PARM_DESC(enable_charging,
+		 "Configure and enable charging when VBUS is present (default: true)");
+
+/*
+ * Without a Type-C/PD driver the source's advertised current is unknown:
+ * 3 A is what a USB-C source offers at 5 V, and AICL (4.5 V) lowers the
+ * input current on a source that can't keep up, such as a PC port.
+ */
+static uint input_current_ma = 3000;
+module_param(input_current_ma, uint, 0444);
+MODULE_PARM_DESC(input_current_ma, "VBUS input current limit in mA at boot (default: 3000)");
+
+/* Samsung's board maximum (battery,max_charging_current). */
+static uint charge_current_ma = 3200;
+module_param(charge_current_ma, uint, 0444);
+MODULE_PARM_DESC(charge_current_ma, "Fast charge current in mA at boot (default: 3200)");
+
+struct sm5714 {
+	struct device *dev;
+	struct regmap *chg;
+	struct regmap *fg;
+	struct mutex lock; /* SRAM address/data pairs, charger updates */
+	struct power_supply *bat_psy;
+	struct power_supply *chg_psy;
+	struct power_supply_battery_info *bat_info;
+	struct delayed_work work;
+
+	/* settings, applied on cable attach and when changed */
+	unsigned int input_ma;
+	unsigned int charge_ma;
+	unsigned int float_mv;
+	unsigned int float_mv_max;
+	int start_pct;		/* battery care: resume below this */
+	int end_pct;		/* battery care: pause at this (100: off) */
+
+	bool configured;	/* charging set up by us for the current cable */
+	bool too_hot_or_cold;
+	bool too_cold;
+	bool held;		/* paused at end_pct */
+	bool warned_bypass;
+	bool fg_init_done;
+
+	/* last reported state, to emit power_supply_changed() */
+	bool last_online;
+	bool last_chgon;
+	int last_capacity;
+};
+
+/* ---- fuel gauge ---- */
+
+static int sm5714_fg_sram_read(struct sm5714 *sm, u8 addr, unsigned int *val)
+{
+	int ret;
+
+	mutex_lock(&sm->lock);
+	ret = regmap_write(sm->fg, SM5714_FG_REG_SRAM_RADDR, addr);
+	if (!ret)
+		ret = regmap_read(sm->fg, SM5714_FG_REG_SRAM_RDATA, val);
+	mutex_unlock(&sm->lock);
+
+	return ret;
+}
+
+/* SOC word is percent in 8.8 fixed point; returns per mille */
+static int sm5714_fg_get_soc(struct sm5714 *sm, int *permille)
+{
+	unsigned int raw;
+	int ret;
+
+	ret = sm5714_fg_sram_read(sm, SM5714_FG_SRAM_SOC, &raw);
+	if (ret)
+		return ret;
+
+	*permille = min((raw * 10) >> 8, 1000U);
+	return 0;
+}
+
+static int sm5714_fg_get_capacity(struct sm5714 *sm, int *percent)
+{
+	int permille, ret;
+
+	ret = sm5714_fg_get_soc(sm, &permille);
+	if (ret)
+		return ret;
+
+	*percent = permille / 10;
+	return 0;
+}
+
+/* VBAT words: 2.7 V offset, 1/109 * 10 mV per LSB, sign-magnitude */
+static int sm5714_fg_get_vbat(struct sm5714 *sm, u8 addr, int *uv)
+{
+	unsigned int raw;
+	int mv, ret;
+
+	ret = sm5714_fg_sram_read(sm, addr, &raw);
+	if (ret)
+		return ret;
+
+	mv = ((raw & SM5714_MAGNITUDE) * 10) / 109;
+	mv = (raw & SM5714_SIGN) ? 2700 - mv : 2700 + mv;
+	*uv = mv * 1000;
+	return 0;
+}
+
+static int sm5714_fg_get_ocv(struct sm5714 *sm, int *uv)
+{
+	unsigned int raw;
+	int ret;
+
+	ret = sm5714_fg_sram_read(sm, SM5714_FG_SRAM_OCV, &raw);
+	if (ret)
+		return ret;
+
+	*uv = ((raw * 1000) >> 11) * 1000;
+	return 0;
+}
+
+static bool sm5714_chg_is_charging(struct sm5714 *sm)
+{
+	unsigned int st2;
+
+	if (regmap_read(sm->chg, SM5714_CHG_REG_STATUS2, &st2))
+		return false;
+
+	return st2 & SM5714_STATUS2_CHGON;
+}
+
+/*
+ * Current words: 1/2.044 mA per LSB, sign-magnitude, negative while
+ * discharging; scaled by 2.5 in the gauge's high range. Like Samsung's
+ * driver, report 0 while the gauge sees nENQ4 high (factory jig) and
+ * suppress small positive readings when nothing is charging.
+ */
+static int sm5714_fg_get_current(struct sm5714 *sm, u8 addr, int *ua)
+{
+	unsigned int raw, sys, aux;
+	int ma, ret;
+
+	ret = sm5714_fg_sram_read(sm, addr, &raw);
+	if (ret)
+		return ret;
+	ret = regmap_read(sm->fg, SM5714_FG_REG_SYSTEM_STATUS, &sys);
+	if (ret)
+		return ret;
+	ret = regmap_read(sm->fg, SM5714_FG_REG_AUX_STAT, &aux);
+	if (ret)
+		return ret;
+
+	ma = ((raw & SM5714_MAGNITUDE) * 1000) / 2044;
+	if (raw & SM5714_SIGN)
+		ma = -ma;
+	else if (!(aux & SM5714_FG_AUX_CHG_DETECT) && !sm5714_chg_is_charging(sm))
+		ma = 0;
+
+	if (aux & SM5714_FG_AUX_CURR_X2_5)
+		ma = ma * 25 / 10;
+
+	if (sys & SM5714_FG_SYS_NENQ4)
+		ma = 0;
+
+	*ua = ma * 1000;
+	return 0;
+}
+
+/* Temperature word, in 0.1 degC */
+static int sm5714_fg_get_temp(struct sm5714 *sm, int *decidegc)
+{
+	unsigned int raw;
+	int t, ret;
+
+	ret = sm5714_fg_sram_read(sm, SM5714_FG_SRAM_TEMPERATURE, &raw);
+	if (ret)
+		return ret;
+
+	t = (((raw & SM5714_MAGNITUDE) * 10) * 2989) >> 19;
+	*decidegc = (raw & SM5714_SIGN) ? -t : t;
+	return 0;
+}
+
+/* ---- charger ---- */
+
+static int sm5714_chg_get_status(struct sm5714 *sm, int *status)
+{
+	unsigned int st1, st2;
+	int ret;
+
+	ret = regmap_read(sm->chg, SM5714_CHG_REG_STATUS1, &st1);
+	if (ret)
+		return ret;
+	ret = regmap_read(sm->chg, SM5714_CHG_REG_STATUS2, &st2);
+	if (ret)
+		return ret;
+
+	if (st2 & SM5714_STATUS2_TOPOFF)
+		*status = POWER_SUPPLY_STATUS_FULL;
+	else if (st2 & SM5714_STATUS2_CHGON)
+		*status = POWER_SUPPLY_STATUS_CHARGING;
+	else if (st1 & SM5714_STATUS1_VBUSPOK)
+		*status = POWER_SUPPLY_STATUS_NOT_CHARGING;
+	else
+		*status = POWER_SUPPLY_STATUS_DISCHARGING;
+
+	return 0;
+}
+
+static int sm5714_chg_get_health(struct sm5714 *sm, int *health)
+{
+	unsigned int st1, st2, st3;
+	int ret;
+
+	ret = regmap_read(sm->chg, SM5714_CHG_REG_STATUS1, &st1);
+	if (!ret)
+		ret = regmap_read(sm->chg, SM5714_CHG_REG_STATUS2, &st2);
+	if (!ret)
+		ret = regmap_read(sm->chg, SM5714_CHG_REG_STATUS3, &st3);
+	if (ret)
+		return ret;
+
+	if (st1 & SM5714_STATUS1_VBUSOVP)
+		*health = POWER_SUPPLY_HEALTH_OVERVOLTAGE;
+	else if (st2 & SM5714_STATUS2_BATOVP)
+		*health = POWER_SUPPLY_HEALTH_OVERVOLTAGE;
+	else if (st3 & SM5714_STATUS3_THEMSHDN)
+		*health = POWER_SUPPLY_HEALTH_OVERHEAT;
+	else if (st3 & (SM5714_STATUS3_FASTTMROFF | SM5714_STATUS3_TRICKLETMROFF))
+		*health = POWER_SUPPLY_HEALTH_SAFETY_TIMER_EXPIRE;
+	else if (st2 & SM5714_STATUS2_WDTMROFF)
+		*health = POWER_SUPPLY_HEALTH_WATCHDOG_TIMER_EXPIRE;
+	else if (sm->too_hot_or_cold)
+		*health = sm->too_cold ? POWER_SUPPLY_HEALTH_COLD :
+					 POWER_SUPPLY_HEALTH_HOT;
+	else
+		*health = POWER_SUPPLY_HEALTH_GOOD;
+
+	return 0;
+}
+
+/* VBUS_LIMIT: 100 mA + 25 mA per step */
+static unsigned int sm5714_input_limit_to_reg(unsigned int ma)
+{
+	return ma < 100 ? 0 : min((ma - 100) / 25, 0x7fU);
+}
+
+/* Fast charge current: 109.375 mA at 0x07, 15.625 mA per step */
+static unsigned int sm5714_charge_current_to_reg(unsigned int ma)
+{
+	unsigned int ua = ma * 1000;
+
+	if (ua < 109375)
+		return 0x07;
+	if (ua > 3500000)
+		return 0xe0;
+	return 7 + (ua - 109375) / 15625;
+}
+
+/* BATREG: 3.70-3.85 V in 50 mV, 3.9/4.0 V, then 4.05-4.62 V in 10 mV */
+static unsigned int sm5714_batreg_to_reg(unsigned int mv)
+{
+	if (mv <= 3700)
+		return 0;
+	if (mv < 3900)
+		return (mv - 3700) / 50;
+	if (mv < 4050)
+		return (mv - 3900) / 100 + 4;
+	return min((mv - 4050) / 10 + 6, 0x3fU);
+}
+
+static int sm5714_chg_update(struct sm5714 *sm, unsigned int reg,
+			     unsigned int mask, unsigned int val)
+{
+	int ret;
+
+	mutex_lock(&sm->lock);
+	ret = regmap_update_bits(sm->chg, reg, mask, val);
+	mutex_unlock(&sm->lock);
+
+	return ret;
+}
+
+static int sm5714_wdt_kick(struct sm5714 *sm)
+{
+	return sm5714_chg_update(sm, SM5714_CHG_REG_WDTCNTL,
+				 SM5714_WDTCNTL_KICK, SM5714_WDTCNTL_KICK);
+}
+
+static int sm5714_set_q4fet(struct sm5714 *sm, bool on)
+{
+	return sm5714_chg_update(sm, SM5714_CHG_REG_CNTL1, SM5714_CNTL1_ENQ4FET,
+				 on ? SM5714_CNTL1_ENQ4FET : 0);
+}
+
+/* Charging paused: battery too hot or cold, or held for battery care. */
+static bool sm5714_paused(struct sm5714 *sm)
+{
+	return sm->too_hot_or_cold || sm->held;
+}
+
+/*
+ * What Samsung's driver programs on cable attach: sm5714_chg_init()
+ * (AICL at 4.5 V, float voltage, 90 s watchdog, auto-stop), the
+ * CHG_ON_VBUS operating mode, input and charge currents, then
+ * sm5714_chg_charging(): clear an expired watchdog, ENQ4FET with the
+ * input limit dropped to 500 mA meanwhile, watchdog on and kicked.
+ */
+static int sm5714_charging_enable(struct sm5714 *sm, unsigned int st2)
+{
+	unsigned int ilim = sm->input_ma;
+	unsigned int ichg = sm->charge_ma;
+	unsigned int mode;
+	int ret;
+
+	if (st2 & SM5714_STATUS2_WDTMROFF) {
+		ret = sm5714_chg_update(sm, SM5714_CHG_REG_WDTCNTL,
+					SM5714_WDTCNTL_CLEAR, SM5714_WDTCNTL_CLEAR);
+		if (ret)
+			return ret;
+	}
+
+	ret = sm5714_chg_update(sm, SM5714_CHG_REG_WDTCNTL, SM5714_WDTCNTL_TIME,
+				FIELD_PREP(SM5714_WDTCNTL_TIME, SM5714_WDT_TIME_90S));
+	if (!ret)
+		ret = sm5714_chg_update(sm, SM5714_CHG_REG_CHGCNTL11,
+					SM5714_CHGCNTL11_AICL_TH,
+					FIELD_PREP(SM5714_CHGCNTL11_AICL_TH,
+						   SM5714_AICL_TH_4_5V));
+	if (!ret)
+		ret = sm5714_chg_update(sm, SM5714_CHG_REG_CNTL1,
+					SM5714_CNTL1_AICLEN_VBUS,
+					SM5714_CNTL1_AICLEN_VBUS);
+	if (!ret)
+		ret = sm5714_chg_update(sm, SM5714_CHG_REG_CHGCNTL4,
+					SM5714_CHGCNTL4_BATREG | SM5714_CHGCNTL4_AUTOSTOP,
+					sm5714_batreg_to_reg(sm->float_mv) |
+					SM5714_CHGCNTL4_AUTOSTOP);
+	if (!ret)
+		ret = sm5714_chg_update(sm, SM5714_CHG_REG_CHGCNTL2, 0xff,
+					sm5714_charge_current_to_reg(ichg));
+	if (ret)
+		return ret;
+
+	ret = regmap_read(sm->chg, SM5714_CHG_REG_CNTL2, &mode);
+	if (ret)
+		return ret;
+	if (FIELD_GET(SM5714_CNTL2_OP_MODE, mode) != SM5714_OP_MODE_CHG_ON_VBUS) {
+		dev_info(sm->dev, "operating mode %lu -> charger on VBUS\n",
+			 FIELD_GET(SM5714_CNTL2_OP_MODE, mode));
+		ret = sm5714_chg_update(sm, SM5714_CHG_REG_CNTL2,
+					SM5714_CNTL2_OP_MODE,
+					SM5714_OP_MODE_CHG_ON_VBUS);
+		if (ret)
+			return ret;
+		usleep_range(10000, 11000); /* buck start-up */
+	}
+
+	ret = sm5714_chg_update(sm, SM5714_CHG_REG_VBUSCNTL, SM5714_VBUSCNTL_LIMIT,
+				sm5714_input_limit_to_reg(min(ilim, 500U)));
+	if (!ret && !sm5714_paused(sm)) {
+		ret = sm5714_set_q4fet(sm, true);
+		usleep_range(5000, 6000);
+	}
+	if (!ret)
+		ret = sm5714_chg_update(sm, SM5714_CHG_REG_VBUSCNTL,
+					SM5714_VBUSCNTL_LIMIT,
+					sm5714_input_limit_to_reg(ilim));
+	if (!ret)
+		ret = sm5714_chg_update(sm, SM5714_CHG_REG_WDTCNTL,
+					SM5714_WDTCNTL_EN | SM5714_WDTCNTL_KICK,
+					SM5714_WDTCNTL_EN | SM5714_WDTCNTL_KICK);
+	if (ret)
+		return ret;
+
+	dev_info(sm->dev, "charging enabled: input %u mA, charge %u mA, float %u mV\n",
+		 ilim, ichg, sm->float_mv);
+	sm->configured = true;
+	return 0;
+}
+
+/* Cable gone: as Samsung's driver, charging off, watchdog off, 500 mA. */
+static void sm5714_charging_disable(struct sm5714 *sm)
+{
+	sm5714_set_q4fet(sm, false);
+	sm5714_chg_update(sm, SM5714_CHG_REG_WDTCNTL, SM5714_WDTCNTL_EN, 0);
+	sm5714_chg_update(sm, SM5714_CHG_REG_VBUSCNTL, SM5714_VBUSCNTL_LIMIT,
+			  sm5714_input_limit_to_reg(500));
+	sm->configured = false;
+}
+
+static void sm5714_check_temp(struct sm5714 *sm)
+{
+	int t;
+
+	if (sm5714_fg_get_temp(sm, &t))
+		return;
+
+	if (!sm->too_hot_or_cold && (t < SM5714_TEMP_MIN || t > SM5714_TEMP_MAX)) {
+		dev_warn(sm->dev, "battery at %d.%d degC, pausing charging\n",
+			 t / 10, abs(t % 10));
+		sm->too_hot_or_cold = true;
+		sm->too_cold = t < SM5714_TEMP_MIN;
+		sm5714_set_q4fet(sm, false);
+	} else if (sm->too_hot_or_cold && t >= SM5714_TEMP_MIN_RESUME &&
+		   t <= SM5714_TEMP_MAX_RESUME) {
+		dev_info(sm->dev, "battery at %d.%d degC, resuming charging\n",
+			 t / 10, abs(t % 10));
+		sm->too_hot_or_cold = false;
+		if (!sm->held)
+			sm5714_set_q4fet(sm, true);
+	}
+}
+
+/*
+ * Battery care: hold the charge at end_pct (charging paused, the system
+ * running from VBUS) until it drops to start_pct, or below end_pct if
+ * start_pct isn't lower.
+ */
+static void sm5714_check_limit(struct sm5714 *sm)
+{
+	int capacity, resume = min(sm->start_pct, sm->end_pct - 1);
+
+	if (sm5714_fg_get_capacity(sm, &capacity))
+		return;
+
+	if (!sm->held && sm->end_pct < 100 && capacity >= sm->end_pct) {
+		dev_info(sm->dev, "battery at %d%%, holding it there (limit %d%%)\n",
+			 capacity, sm->end_pct);
+		sm->held = true;
+		sm5714_set_q4fet(sm, false);
+	} else if (sm->held && (sm->end_pct >= 100 || capacity <= resume)) {
+		dev_info(sm->dev, "battery at %d%%, charging again\n", capacity);
+		sm->held = false;
+		if (sm->configured && !sm->too_hot_or_cold)
+			sm5714_set_q4fet(sm, true);
+	}
+}
+
+static void sm5714_charge_control(struct sm5714 *sm, unsigned int st1,
+				  unsigned int st2, unsigned int st3)
+{
+	unsigned int f1, cntl1;
+	int uv;
+
+	if (!(st1 & SM5714_STATUS1_VBUSPOK)) {
+		if (sm->configured) {
+			sm5714_charging_disable(sm);
+			sm->too_hot_or_cold = false;
+		}
+		return;
+	}
+
+	if (regmap_read(sm->chg, SM5714_CHG_REG_FACTORY1, &f1))
+		return;
+	if (f1 & (SM5714_FACTORY1_NOZX | SM5714_FACTORY1_ENBYPASS)) {
+		if (!sm->warned_bypass)
+			dev_warn(sm->dev, "factory/bypass mode set (0x%02x), not touching the charger\n",
+				 f1);
+		sm->warned_bypass = true;
+		return;
+	}
+
+	if (st2 & SM5714_STATUS2_NOBAT)
+		return;
+
+	sm5714_check_temp(sm);
+	sm5714_check_limit(sm);
+
+	if (!sm->configured || (st2 & SM5714_STATUS2_WDTMROFF)) {
+		if (sm5714_charging_enable(sm, st2))
+			dev_err(sm->dev, "failed to enable charging\n");
+		return;
+	}
+
+	sm5714_wdt_kick(sm);
+
+	/*
+	 * Samsung's driver re-cycles ENQ4FET when the charger reports done;
+	 * do it only once the cell has relaxed below the stock recharge
+	 * voltage, never after a safety timer expired.
+	 */
+	if (sm5714_paused(sm) || (st2 & SM5714_STATUS2_CHGON) ||
+	    !(st2 & (SM5714_STATUS2_DONE | SM5714_STATUS2_TOPOFF)) ||
+	    (st3 & (SM5714_STATUS3_FASTTMROFF | SM5714_STATUS3_TRICKLETMROFF)))
+		return;
+	if (regmap_read(sm->chg, SM5714_CHG_REG_CNTL1, &cntl1) ||
+	    !(cntl1 & SM5714_CNTL1_ENQ4FET))
+		return;
+	if (sm5714_fg_get_vbat(sm, SM5714_FG_SRAM_VBAT, &uv) ||
+	    uv >= SM5714_RECHARGE_MV * 1000)
+		return;
+
+	dev_info(sm->dev, "battery at %d mV, restarting charge\n", uv / 1000);
+	sm5714_set_q4fet(sm, false);
+	msleep(10);
+	sm5714_set_q4fet(sm, true);
+}
+
+static void sm5714_work(struct work_struct *work)
+{
+	struct sm5714 *sm = container_of(work, struct sm5714, work.work);
+	unsigned int st1, st2, st3, sys;
+	bool online, chgon, changed;
+	int capacity = -1;
+
+	if (regmap_read(sm->chg, SM5714_CHG_REG_STATUS1, &st1) ||
+	    regmap_read(sm->chg, SM5714_CHG_REG_STATUS2, &st2) ||
+	    regmap_read(sm->chg, SM5714_CHG_REG_STATUS3, &st3))
+		goto out;
+
+	if (enable_charging)
+		sm5714_charge_control(sm, st1, st2, st3);
+
+	if (!regmap_read(sm->fg, SM5714_FG_REG_SYSTEM_STATUS, &sys)) {
+		bool done = sys & SM5714_FG_SYS_INIT_DONE;
+
+		if (done != sm->fg_init_done)
+			dev_warn(sm->dev, "fuel gauge init flag %s (0x%04x)%s\n",
+				 done ? "set" : "cleared", sys,
+				 done ? "" : ": battery model not loaded, capacity may be wrong");
+		sm->fg_init_done = done;
+	}
+
+	sm5714_fg_get_capacity(sm, &capacity);
+	regmap_read(sm->chg, SM5714_CHG_REG_STATUS2, &st2);
+
+	online = st1 & SM5714_STATUS1_VBUSPOK;
+	chgon = st2 & SM5714_STATUS2_CHGON;
+	changed = online != sm->last_online || chgon != sm->last_chgon ||
+		  capacity != sm->last_capacity;
+	sm->last_online = online;
+	sm->last_chgon = chgon;
+	sm->last_capacity = capacity;
+
+	if (changed) {
+		power_supply_changed(sm->chg_psy);
+		power_supply_changed(sm->bat_psy);
+	}
+out:
+	schedule_delayed_work(&sm->work, msecs_to_jiffies(SM5714_POLL_MS));
+}
+
+/* ---- power supplies ---- */
+
+static int sm5714_bat_get_status(struct sm5714 *sm, int *status)
+{
+	int ret, capacity;
+
+	ret = sm5714_chg_get_status(sm, status);
+	if (ret)
+		return ret;
+
+	/* top-off can show before the gauge reaches the stock full SOC */
+	if (*status == POWER_SUPPLY_STATUS_FULL &&
+	    !sm5714_fg_get_capacity(sm, &capacity) && capacity < SM5714_FULL_SOC)
+		*status = sm5714_chg_is_charging(sm) ?
+			  POWER_SUPPLY_STATUS_CHARGING :
+			  POWER_SUPPLY_STATUS_NOT_CHARGING;
+
+	return 0;
+}
+
+static int sm5714_bat_get_property(struct power_supply *psy,
+				   enum power_supply_property psp,
+				   union power_supply_propval *val)
+{
+	struct sm5714 *sm = power_supply_get_drvdata(psy);
+	unsigned int st2;
+	int ret = 0;
+
+	switch (psp) {
+	case POWER_SUPPLY_PROP_STATUS:
+		ret = sm5714_bat_get_status(sm, &val->intval);
+		break;
+	case POWER_SUPPLY_PROP_PRESENT:
+		ret = regmap_read(sm->chg, SM5714_CHG_REG_STATUS2, &st2);
+		val->intval = !(st2 & SM5714_STATUS2_NOBAT);
+		break;
+	case POWER_SUPPLY_PROP_TECHNOLOGY:
+		val->intval = POWER_SUPPLY_TECHNOLOGY_LION;
+		break;
+	case POWER_SUPPLY_PROP_CAPACITY:
+		ret = sm5714_fg_get_capacity(sm, &val->intval);
+		break;
+	case POWER_SUPPLY_PROP_VOLTAGE_NOW:
+		ret = sm5714_fg_get_vbat(sm, SM5714_FG_SRAM_VBAT, &val->intval);
+		break;
+	case POWER_SUPPLY_PROP_VOLTAGE_AVG:
+		ret = sm5714_fg_get_vbat(sm, SM5714_FG_SRAM_VBAT_AVG, &val->intval);
+		break;
+	case POWER_SUPPLY_PROP_VOLTAGE_OCV:
+		ret = sm5714_fg_get_ocv(sm, &val->intval);
+		break;
+	case POWER_SUPPLY_PROP_CURRENT_NOW:
+		ret = sm5714_fg_get_current(sm, SM5714_FG_SRAM_CURRENT, &val->intval);
+		break;
+	case POWER_SUPPLY_PROP_CURRENT_AVG:
+		ret = sm5714_fg_get_current(sm, SM5714_FG_SRAM_CURRENT_AVG, &val->intval);
+		break;
+	case POWER_SUPPLY_PROP_TEMP:
+		ret = sm5714_fg_get_temp(sm, &val->intval);
+		break;
+	case POWER_SUPPLY_PROP_CHARGE_FULL_DESIGN:
+		if (!sm->bat_info || sm->bat_info->charge_full_design_uah <= 0)
+			return -ENODATA;
+		val->intval = sm->bat_info->charge_full_design_uah;
+		break;
+	case POWER_SUPPLY_PROP_VOLTAGE_MAX_DESIGN:
+		val->intval = sm->float_mv_max * 1000;
+		break;
+	case POWER_SUPPLY_PROP_CHARGE_CONTROL_START_THRESHOLD:
+		val->intval = sm->start_pct;
+		break;
+	case POWER_SUPPLY_PROP_CHARGE_CONTROL_END_THRESHOLD:
+		val->intval = sm->end_pct;
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	return ret;
+}
+
+static int sm5714_bat_set_property(struct power_supply *psy,
+				   enum power_supply_property psp,
+				   const union power_supply_propval *val)
+{
+	struct sm5714 *sm = power_supply_get_drvdata(psy);
+
+	switch (psp) {
+	case POWER_SUPPLY_PROP_CHARGE_CONTROL_START_THRESHOLD:
+		if (val->intval < 0 || val->intval > 100)
+			return -EINVAL;
+		sm->start_pct = val->intval;
+		break;
+	case POWER_SUPPLY_PROP_CHARGE_CONTROL_END_THRESHOLD:
+		if (val->intval < SM5714_END_PCT_MIN || val->intval > 100)
+			return -EINVAL;
+		sm->end_pct = val->intval;
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	/* re-evaluate now rather than at the next poll */
+	mod_delayed_work(system_wq, &sm->work, 0);
+	return 0;
+}
+
+static int sm5714_bat_property_is_writeable(struct power_supply *psy,
+					    enum power_supply_property psp)
+{
+	return psp == POWER_SUPPLY_PROP_CHARGE_CONTROL_START_THRESHOLD ||
+	       psp == POWER_SUPPLY_PROP_CHARGE_CONTROL_END_THRESHOLD;
+}
+
+static const enum power_supply_property sm5714_bat_props[] = {
+	POWER_SUPPLY_PROP_STATUS,
+	POWER_SUPPLY_PROP_PRESENT,
+	POWER_SUPPLY_PROP_TECHNOLOGY,
+	POWER_SUPPLY_PROP_CAPACITY,
+	POWER_SUPPLY_PROP_VOLTAGE_NOW,
+	POWER_SUPPLY_PROP_VOLTAGE_AVG,
+	POWER_SUPPLY_PROP_VOLTAGE_OCV,
+	POWER_SUPPLY_PROP_CURRENT_NOW,
+	POWER_SUPPLY_PROP_CURRENT_AVG,
+	POWER_SUPPLY_PROP_TEMP,
+	POWER_SUPPLY_PROP_CHARGE_FULL_DESIGN,
+	POWER_SUPPLY_PROP_VOLTAGE_MAX_DESIGN,
+	POWER_SUPPLY_PROP_CHARGE_CONTROL_START_THRESHOLD,
+	POWER_SUPPLY_PROP_CHARGE_CONTROL_END_THRESHOLD,
+};
+
+static const struct power_supply_desc sm5714_bat_desc = {
+	.name		= "battery",
+	.type		= POWER_SUPPLY_TYPE_BATTERY,
+	.properties	= sm5714_bat_props,
+	.num_properties	= ARRAY_SIZE(sm5714_bat_props),
+	.get_property	= sm5714_bat_get_property,
+	.set_property	= sm5714_bat_set_property,
+	.property_is_writeable = sm5714_bat_property_is_writeable,
+};
+
+static int sm5714_chg_get_property(struct power_supply *psy,
+				   enum power_supply_property psp,
+				   union power_supply_propval *val)
+{
+	struct sm5714 *sm = power_supply_get_drvdata(psy);
+	unsigned int reg;
+	int ret = 0;
+
+	switch (psp) {
+	case POWER_SUPPLY_PROP_ONLINE:
+		ret = regmap_read(sm->chg, SM5714_CHG_REG_STATUS1, &reg);
+		val->intval = !!(reg & SM5714_STATUS1_VBUSPOK);
+		break;
+	case POWER_SUPPLY_PROP_STATUS:
+		ret = sm5714_chg_get_status(sm, &val->intval);
+		break;
+	case POWER_SUPPLY_PROP_HEALTH:
+		ret = sm5714_chg_get_health(sm, &val->intval);
+		break;
+	case POWER_SUPPLY_PROP_CHARGE_TYPE:
+		ret = regmap_read(sm->chg, SM5714_CHG_REG_STATUS2, &reg);
+		if (reg & SM5714_STATUS2_CHGON)
+			val->intval = POWER_SUPPLY_CHARGE_TYPE_FAST;
+		else
+			val->intval = POWER_SUPPLY_CHARGE_TYPE_NONE;
+		break;
+	/* the settings, applied while a cable is attached */
+	case POWER_SUPPLY_PROP_INPUT_CURRENT_LIMIT:
+		val->intval = sm->input_ma * 1000;
+		break;
+	case POWER_SUPPLY_PROP_CONSTANT_CHARGE_CURRENT:
+		val->intval = sm->charge_ma * 1000;
+		break;
+	case POWER_SUPPLY_PROP_CONSTANT_CHARGE_CURRENT_MAX:
+		val->intval = SM5714_CHARGE_MA_MAX * 1000;
+		break;
+	case POWER_SUPPLY_PROP_CONSTANT_CHARGE_VOLTAGE:
+		val->intval = sm->float_mv * 1000;
+		break;
+	case POWER_SUPPLY_PROP_CONSTANT_CHARGE_VOLTAGE_MAX:
+		val->intval = sm->float_mv_max * 1000;
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	return ret;
+}
+
+/*
+ * New limits, within the stock board's maxima; written to the charger at
+ * once while it is set up for a cable, else on the next attach.
+ */
+static int sm5714_chg_set_property(struct power_supply *psy,
+				   enum power_supply_property psp,
+				   const union power_supply_propval *val)
+{
+	struct sm5714 *sm = power_supply_get_drvdata(psy);
+	unsigned int v = val->intval < 0 ? 0 : val->intval / 1000;
+	int ret = 0;
+
+	switch (psp) {
+	case POWER_SUPPLY_PROP_INPUT_CURRENT_LIMIT:
+		if (v < SM5714_LIMIT_MA_MIN || v > SM5714_INPUT_MA_MAX)
+			return -EINVAL;
+		sm->input_ma = v;
+		if (sm->configured)
+			ret = sm5714_chg_update(sm, SM5714_CHG_REG_VBUSCNTL,
+						SM5714_VBUSCNTL_LIMIT,
+						sm5714_input_limit_to_reg(v));
+		break;
+	case POWER_SUPPLY_PROP_CONSTANT_CHARGE_CURRENT:
+		if (v < SM5714_LIMIT_MA_MIN || v > SM5714_CHARGE_MA_MAX)
+			return -EINVAL;
+		sm->charge_ma = v;
+		if (sm->configured)
+			ret = sm5714_chg_update(sm, SM5714_CHG_REG_CHGCNTL2, 0xff,
+						sm5714_charge_current_to_reg(v));
+		break;
+	case POWER_SUPPLY_PROP_CONSTANT_CHARGE_VOLTAGE:
+		if (v < SM5714_FLOAT_MV_MIN || v > sm->float_mv_max)
+			return -EINVAL;
+		sm->float_mv = v;
+		if (sm->configured)
+			ret = sm5714_chg_update(sm, SM5714_CHG_REG_CHGCNTL4,
+						SM5714_CHGCNTL4_BATREG,
+						sm5714_batreg_to_reg(v));
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	if (!ret)
+		dev_info(sm->dev, "input %u mA, charge %u mA, float %u mV\n",
+			 sm->input_ma, sm->charge_ma, sm->float_mv);
+	power_supply_changed(psy);
+	return ret;
+}
+
+static int sm5714_chg_property_is_writeable(struct power_supply *psy,
+					    enum power_supply_property psp)
+{
+	return psp == POWER_SUPPLY_PROP_INPUT_CURRENT_LIMIT ||
+	       psp == POWER_SUPPLY_PROP_CONSTANT_CHARGE_CURRENT ||
+	       psp == POWER_SUPPLY_PROP_CONSTANT_CHARGE_VOLTAGE;
+}
