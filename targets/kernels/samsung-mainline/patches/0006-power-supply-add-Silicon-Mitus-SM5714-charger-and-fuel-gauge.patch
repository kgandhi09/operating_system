+/* Don't leave a fed-by-nobody watchdog behind for the next kernel. */
+static void sm5714_release_wdt(struct sm5714 *sm)
+{
+	cancel_delayed_work_sync(&sm->work);
+	if (sm->configured)
+		sm5714_chg_update(sm, SM5714_CHG_REG_WDTCNTL, SM5714_WDTCNTL_EN, 0);
+}
+
+static void sm5714_release_wdt_action(void *data)
+{
+	sm5714_release_wdt(data);
+}
+
+static int sm5714_probe(struct i2c_client *client)
+{
+	struct device *dev = &client->dev;
+	struct power_supply_config psy_cfg = {};
+	struct i2c_client *fg_client;
+	unsigned int id, fg_id, sys;
+	struct sm5714 *sm;
+	int ret;
+
+	sm = devm_kzalloc(dev, sizeof(*sm), GFP_KERNEL);
+	if (!sm)
+		return -ENOMEM;
+
+	sm->dev = dev;
+	sm->last_capacity = -1;
+	sm->input_ma = clamp(input_current_ma, SM5714_LIMIT_MA_MIN, SM5714_INPUT_MA_MAX);
+	sm->charge_ma = clamp(charge_current_ma, SM5714_LIMIT_MA_MIN, SM5714_CHARGE_MA_MAX);
+	sm->float_mv = sm->float_mv_max = SM5714_FLOAT_MV_MAX;
+	sm->start_pct = 95;
+	sm->end_pct = 100;
+	i2c_set_clientdata(client, sm);
+
+	ret = devm_mutex_init(dev, &sm->lock);
+	if (ret)
+		return ret;
+
+	sm->chg = devm_regmap_init_i2c(client, &sm5714_chg_regmap_config);
+	if (IS_ERR(sm->chg))
+		return dev_err_probe(dev, PTR_ERR(sm->chg), "charger regmap\n");
+
+	ret = regmap_read(sm->chg, SM5714_CHG_REG_DEVICEID, &id);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to read device ID\n");
+	if (FIELD_GET(SM5714_DEVICEID_VENDOR, id) != 0x1)
+		return dev_err_probe(dev, -ENODEV, "unexpected device ID 0x%02x\n", id);
+
+	fg_client = devm_i2c_new_dummy_device(dev, client->adapter, SM5714_FG_I2C_ADDR);
+	if (IS_ERR(fg_client))
+		return dev_err_probe(dev, PTR_ERR(fg_client), "fuel gauge I2C client\n");
+
+	sm->fg = devm_regmap_init_i2c(fg_client, &sm5714_fg_regmap_config);
+	if (IS_ERR(sm->fg))
+		return dev_err_probe(dev, PTR_ERR(sm->fg), "fuel gauge regmap\n");
+
+	ret = regmap_read(sm->fg, SM5714_FG_REG_DEVICE_ID, &fg_id);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to read fuel gauge ID\n");
+	if (fg_id > 0xff)
+		return dev_err_probe(dev, -ENODEV, "unexpected fuel gauge ID 0x%04x\n", fg_id);
+
+	ret = regmap_read(sm->fg, SM5714_FG_REG_SYSTEM_STATUS, &sys);
+	if (ret)
+		return ret;
+	sm->fg_init_done = sys & SM5714_FG_SYS_INIT_DONE;
+	if (!sm->fg_init_done)
+		dev_warn(dev, "fuel gauge not initialised (status 0x%04x): battery model not loaded, capacity may be wrong\n",
+			 sys);
+
+	dev_info(dev, "SM5714 rev %u, fuel gauge ID 0x%02x, status 0x%04x\n",
+		 id >> 3, fg_id, sys);
+
+	psy_cfg.drv_data = sm;
+	psy_cfg.fwnode = dev_fwnode(dev);
+	sm->bat_psy = devm_power_supply_register(dev, &sm5714_bat_desc, &psy_cfg);
+	if (IS_ERR(sm->bat_psy))
+		return dev_err_probe(dev, PTR_ERR(sm->bat_psy), "battery power supply\n");
+
+	if (!power_supply_get_battery_info(sm->bat_psy, &sm->bat_info)) {
+		int uv = sm->bat_info->constant_charge_voltage_max_uv;
+
+		if (uv > 0)
+			sm->float_mv = sm->float_mv_max =
+				clamp(uv / 1000, SM5714_FLOAT_MV_MIN, SM5714_FLOAT_MV_MAX);
+	} else {
+		sm->bat_info = NULL;
+	}
+
+	psy_cfg.fwnode = NULL;
+	psy_cfg.supplied_to = sm5714_chg_supplied_to;
+	psy_cfg.num_supplicants = ARRAY_SIZE(sm5714_chg_supplied_to);
+	sm->chg_psy = devm_power_supply_register(dev, &sm5714_chg_desc, &psy_cfg);
+	if (IS_ERR(sm->chg_psy))
+		return dev_err_probe(dev, PTR_ERR(sm->chg_psy), "charger power supply\n");
+
+	ret = devm_delayed_work_autocancel(dev, &sm->work, sm5714_work);
+	if (ret)
+		return ret;
+
+	ret = devm_add_action(dev, sm5714_release_wdt_action, sm);
+	if (ret)
+		return ret;
+
+	schedule_delayed_work(&sm->work, 0);
+	return 0;
+}
+
+static void sm5714_shutdown(struct i2c_client *client)
+{
+	sm5714_release_wdt(i2c_get_clientdata(client));
+}
+
+/*
+ * Nothing kicks the watchdog while suspended and an expired one stops
+ * charging, so it is off until resume.
+ */
+static int sm5714_suspend(struct device *dev)
+{
+	sm5714_release_wdt(dev_get_drvdata(dev));
+	return 0;
+}
+
+static int sm5714_resume(struct device *dev)
+{
+	struct sm5714 *sm = dev_get_drvdata(dev);
+
+	if (sm->configured)
+		sm5714_chg_update(sm, SM5714_CHG_REG_WDTCNTL,
+				  SM5714_WDTCNTL_EN | SM5714_WDTCNTL_KICK,
+				  SM5714_WDTCNTL_EN | SM5714_WDTCNTL_KICK);
+	schedule_delayed_work(&sm->work, 0);
+	return 0;
+}
+
+static DEFINE_SIMPLE_DEV_PM_OPS(sm5714_pm_ops, sm5714_suspend, sm5714_resume);
+
+static const struct of_device_id sm5714_of_match[] = {
+	{ .compatible = "siliconmitus,sm5714" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, sm5714_of_match);
+
+static const struct i2c_device_id sm5714_id[] = {
+	{ "sm5714" },
+	{ }
+};
+MODULE_DEVICE_TABLE(i2c, sm5714_id);
+
+static struct i2c_driver sm5714_driver = {
+	.driver = {
+		.name		= "sm5714-charger",
+		.of_match_table	= sm5714_of_match,
+		.pm		= pm_sleep_ptr(&sm5714_pm_ops),
+	},
+	.probe		= sm5714_probe,
+	.shutdown	= sm5714_shutdown,
+	.id_table	= sm5714_id,
+};
+module_i2c_driver(sm5714_driver);
+
+MODULE_DESCRIPTION("Silicon Mitus SM5714 charger and fuel gauge driver");
+MODULE_LICENSE("GPL");
