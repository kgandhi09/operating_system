+/* The charge pump owns the battery path while PPS is active.  Keep the
+ * switching charger's Q4FET open until the pump has stopped and TCPM has
+ * returned to a 5 V contract.  The normal worker then restores charging.
+ */
+int sm5714_usb_set_direct_charge(struct power_supply *psy, bool active)
+{
+	struct sm5714 *sm = power_supply_get_drvdata(psy);
+	int temp, capacity, ret = 0;
+
+	mutex_lock(&sm->policy_lock);
+	if (active) {
+		if (!enable_charging || !sm->typec_bound || !sm->sink_enabled ||
+		    sm->otg_active || sm->held || sm->too_hot_or_cold ||
+		    sm5714_fg_get_temp(sm, &temp) || temp < 100 || temp >= 420 ||
+		    sm5714_fg_get_capacity(sm, &capacity) ||
+		    capacity >= min(sm->end_pct, 90)) {
+			ret = -ERANGE;
+			goto out;
+		}
+		ret = sm5714_set_q4fet(sm, false);
+		if (!ret)
+			ret = sm5714_chg_update(sm, SM5714_CHG_REG_WDTCNTL,
+					SM5714_WDTCNTL_EN, 0);
+		if (ret) {
+			/* The worker still owns this path if handoff failed. */
+			sm->configured = false;
+			mod_delayed_work(system_wq, &sm->work, 0);
+		} else {
+			sm->direct_charging = true;
+		}
+	} else if (sm->direct_charging) {
+		sm->direct_charging = false;
+		sm->configured = false;
+		mod_delayed_work(system_wq, &sm->work, 0);
+	}
+out:
+	mutex_unlock(&sm->policy_lock);
+	if (!ret)
+		power_supply_changed(sm->bat_psy);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(sm5714_usb_set_direct_charge);
