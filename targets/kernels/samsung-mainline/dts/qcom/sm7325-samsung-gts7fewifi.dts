// SPDX-License-Identifier: BSD-3-Clause
/*
 * Samsung Galaxy Tab S7 FE Wi-Fi (SM-T733, "gts7fewifi"), Snapdragon 778G
 * (SM7325, Qualcomm's "yupik").
 *
 * Bring-up: the kernel log on the display the bootloader left on
 * (simple-framebuffer, ramoops), the buttons, and (stage 2) the regulators,
 * UFS storage, USB in device mode and the Book Cover Keyboard. Everything
 * else in sm7325.dtsi stays disabled until its board wiring is known.
 *
 * Values come from the stock firmware T733XXS9DYF1 (scripts/inspect-stock.sh):
 * the base tree in vendor_boot.img and Samsung's board overlay in dtbo.img
 * ("Samsung GTS7FEWIFI PROJECT").
 */

/dts-v1/;

#include <dt-bindings/arm/qcom,ids.h>
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/pinctrl/qcom,pmic-gpio.h>
#include <dt-bindings/regulator/qcom,rpmh-regulator.h>

#include "sm7325.dtsi"
#include "pm7325.dtsi"
#include "pmk8350.dtsi" /* PMK7325 */

/ {
	model = "Samsung Galaxy Tab S7 FE Wi-Fi (SM-T733)";
	compatible = "samsung,gts7fewifi", "qcom,sm7325";
	chassis-type = "tablet";

	/*
	 * The bootloader picks the tree by these. The same as the stock base
	 * tree ("Yupik SoC"): SM7325 and SoC id 0x203, a variant mainline's
	 * qcom,ids.h has no name for; board-id 0 0 as the base tree has (the
	 * board's own <0x22 rev> are in the dtbo overlays, which jk_os keeps
	 * empty: targets/devices/tablet/samsung-gts7fe/dtbo). dtbo-version, as
	 * the stock base tree has it, matches the overlays'.
	 */
	qcom,msm-id = <QCOM_ID_SM7325 0x10000>, <0x203 0x10000>;
	qcom,board-id = <0 0>;
	dtbo-version = <0>;

	/*
	 * Nodes Samsung's bootloader updates before starting the kernel, under
	 * the names it looks them up by (its strings: "/memory",
	 * "/firmware/android/fstab"), as stock's tree has them. With
	 * mainline's (memory@80000000, no android node) our tree fell back to
	 * Download mode where stock's didn't. It fills in the memory size.
	 */
	/delete-node/ memory@80000000;

	memory {
		device_type = "memory";
		reg = <0x0 0x0 0x0 0x0>;
	};

	firmware {
		android {
			compatible = "android,firmware";

			vbmeta {
				compatible = "android,vbmeta";
				parts = "vbmeta,boot,system,vendor,dtbo";
			};

			fstab {
				compatible = "android,fstab";
			};
		};
	};

	/*
	 * Volume up, as stock has it (Samsung's gpio_keys: PM7325 GPIO 6,
	 * active low). Volume down and power are the PMIC's own keys (PON
	 * resin and pwrkey, below). U-Boot's menu uses all three.
	 */
	gpio-keys {
		compatible = "gpio-keys";
		pinctrl-0 = <&vol_up_n>;
		pinctrl-names = "default";

		key-volume-up {
			label = "Volume Up";
			gpios = <&pm7325_gpios 6 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_VOLUMEUP>;
			debounce-interval = <15>;
		};
	};

	chosen {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		/*
		 * The bootloader's splash buffer (stock splash_region), which it
		 * keeps scanning out to the panel: 1600x2560 portrait (Samsung's
		 * ss_dsi_panel_*_WQXGA, 0x640 x 0xa00).
		 */
		framebuffer0: framebuffer@e1000000 {
			compatible = "simple-framebuffer";
			reg = <0x0 0xe1000000 0x0 (1600 * 2560 * 4)>;
			width = <1600>;
			height = <2560>;
			stride = <(1600 * 4)>;
			format = "a8r8g8b8";
			/*
			 * No clocks or power domain: simpledrm would wait for the
			 * display clock driver to probe before showing anything.
			 * clk_ignore_unused / pd_ignore_unused (DEVICE_CMDLINE)
			 * keep them on meanwhile.
			 */
		};
	};

	/*
	 * Memory the firmware uses that kodiak.dtsi doesn't reserve (or
	 * reserves smaller), from the stock base tree and Samsung's overlay.
	 * The kernel touching any of it can reset the SoC.
	 */
	reserved-memory {
		cdsp_secure_heap_mem: cdsp-secure-heap@81800000 {
			reg = <0x0 0x81800000 0x0 0x1e00000>;
			no-map;
		};

		video_fw_mem: video-fw@8ad00000 {
			reg = <0x0 0x8ad00000 0x0 0x500000>;
			no-map;
		};

		ipa_gsi_mem: ipa-gsi@8b710000 {
			reg = <0x0 0x8b710000 0x0 0xa000>;
			no-map;
		};

		dummy_mem: dummy@9c700000 {
			reg = <0x0 0x9c700000 0x0 0x100000>;
			no-map;
		};

		hdm_mem: hdm@9fb00000 {
			reg = <0x0 0x9fb00000 0x0 0x1000>;
			no-map;
		};

		kaslr_mem: kaslr@a0001000 {
			reg = <0x0 0xa0001000 0x0 0x1000>;
			no-map;
		};

		tima_mem: tima@b0100000 {
			reg = <0x0 0xb0100000 0x0 0x100000>;
			no-map;
		};

		removed_mem: removed@c0000000 {
			reg = <0x0 0xc0000000 0x0 0x5100000>;
			no-map;
		};

		/* pil_trustedvm_region, qrtr-shmem and the two neuron blocks. */
		trustedvm_mem: trustedvm@d0800000 {
			reg = <0x0 0xd0800000 0x0 0x7800000>;
			no-map;
		};

		/*
		 * Named as stock names it: Samsung's bootloader keeps the display
		 * running for the kernel only if this region is called exactly
		 * splash_region (see sm8450-samsung-r0q.dts).
		 */
		splash_region: splash_region {
			reg = <0x0 0xe1000000 0x0 0x2300000>;
			no-map;
		};

		dfps_data_mem: dfps-data@e3300000 {
			reg = <0x0 0xe3300000 0x0 0x100000>;
			no-map;
		};

		/* Samsung's debug log (sec_debug) and platform log (ss_plog). */
		sec_debug_mem: sec-debug@f0000000 {
			reg = <0x0 0xf0000000 0x0 0xb00000>;
			no-map;
		};

		ramoops_mem: ramoops@f0b00000 {
			compatible = "ramoops";
			reg = <0x0 0xf0b00000 0x0 0x100000>;
			record-size = <0x40000>;
			console-size = <0x40000>;
			ftrace-size = <0x40000>;
			pmsg-size = <0x40000>;
		};
	};
};

/*
 * Bring-up: the display clock controller stays off until the panel has a
 * driver. Its driver reprograms the display PLL as it starts, which stops
 * the picture the bootloader left running for simple-framebuffer (the
 * screen went grey).
 */
&dispcc {
	status = "disabled";
};

/*
 * GCC clocks the firmware keeps for itself (modem, Wi-Fi subsystem, QSPI,
 * security): touching their registers freezes the CPU. The kernel hung
 * registering GCC's clocks without this; the same list as the other
 * SM7325/QCM6490 phones (the Fairphone 5's, the longest).
 */
&gcc {
	protected-clocks = <GCC_CFG_NOC_LPASS_CLK>,
			   <GCC_EDP_CLKREF_EN>,
			   <GCC_MSS_CFG_AHB_CLK>,
			   <GCC_MSS_GPLL0_MAIN_DIV_CLK_SRC>,
			   <GCC_MSS_OFFLINE_AXI_CLK>,
			   <GCC_MSS_Q6SS_BOOT_CLK_SRC>,
			   <GCC_MSS_Q6_MEMNOC_AXI_CLK>,
			   <GCC_MSS_SNOC_AXI_CLK>,
			   <GCC_QSPI_CNOC_PERIPH_AHB_CLK>,
			   <GCC_QSPI_CORE_CLK>,
			   <GCC_QSPI_CORE_CLK_SRC>,
			   <GCC_SEC_CTRL_CLK_SRC>,
			   <GCC_WPSS_AHB_BDG_MST_CLK>,
			   <GCC_WPSS_AHB_CLK>,
			   <GCC_WPSS_RSCP_CLK>;
};

&pm7325_gpios {
	vol_up_n: vol-up-n-state {
		pins = "gpio6";
		function = PMIC_GPIO_FUNC_NORMAL;
		bias-pull-up;
		input-enable;
		power-source = <1>;
	};
};

&pon_pwrkey {
	status = "okay";
};

&pon_resin {
	linux,code = <KEY_VOLUMEDOWN>;
	status = "okay";
};

/*
 * The RPMh regulators stage 2 uses, at the voltages stock sets them to
 * (Samsung's rpmh-regulator nodes, qcom,init-voltage): fixed, so the
 * regulator core applies them as it registers each one.
 */
&apps_rsc {
	regulators-0 {
		compatible = "qcom,pm7325-rpmh-regulators";
		qcom,pmic-id = "b";

		/* USB 2.0 PHY, 3.1 V */
		vreg_l2b_3p072: ldo2 {
			regulator-name = "vreg_l2b_3p072";
			regulator-min-microvolt = <3072000>;
			regulator-max-microvolt = <3072000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};

		/*
		 * UFS PHY PLL, and the display's DSI controller (stock:
		 * vdda-1p2-supply). Always on while the display runs only on
		 * the bootloader's setup (simple-framebuffer): once UFS or USB
		 * let go of it, the regulator core would switch it off, and the
		 * screen with it (it flickered and went black).
		 */
		vreg_l6b_1p2: ldo6 {
			regulator-name = "vreg_l6b_1p2";
			regulator-min-microvolt = <1200000>;
			regulator-max-microvolt = <1200000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
			regulator-always-on;
			regulator-boot-on;
			regulator-allow-set-load;
			regulator-allowed-modes = <RPMH_REGULATOR_MODE_LPM
						   RPMH_REGULATOR_MODE_HPM>;
		};

		/* UFS VCC (and the SD card slot, not used yet) */
		vreg_l7b_2p952: ldo7 {
			regulator-name = "vreg_l7b_2p952";
			regulator-min-microvolt = <2952000>;
			regulator-max-microvolt = <2952000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
			regulator-allow-set-load;
			regulator-allowed-modes = <RPMH_REGULATOR_MODE_LPM
						   RPMH_REGULATOR_MODE_HPM>;
		};

		/* UFS VCCQ */
		vreg_l9b_1p2: ldo9 {
			regulator-name = "vreg_l9b_1p2";
			regulator-min-microvolt = <1200000>;
			regulator-max-microvolt = <1200000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
			regulator-allow-set-load;
			regulator-allowed-modes = <RPMH_REGULATOR_MODE_LPM
						   RPMH_REGULATOR_MODE_HPM>;
		};
	};

	regulators-1 {
		compatible = "qcom,pm8350c-rpmh-regulators";
		qcom,pmic-id = "c";

		/* USB 2.0 PHY, 1.8 V */
		vreg_l1c_1p8: ldo1 {
			regulator-name = "vreg_l1c_1p8";
			regulator-min-microvolt = <1800000>;
			regulator-max-microvolt = <1800000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};

		/* The keyboard MCU (stock: stm32_vddo-supply) */
		vreg_l3c_2p8: ldo3 {
			regulator-name = "vreg_l3c_2p8";
			regulator-min-microvolt = <2800000>;
			regulator-max-microvolt = <2800000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};

		/*
		 * USB 2.0 PHY core, UFS PHY, and the display's DSI PHY (stock:
		 * vdda-0p9-supply): always on, like L6B, until the display has
		 * its own driver.
		 */
		vreg_l10c_0p88: ldo10 {
			regulator-name = "vreg_l10c_0p88";
			regulator-min-microvolt = <880000>;
			regulator-max-microvolt = <880000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
			regulator-always-on;
			regulator-boot-on;
			regulator-allow-set-load;
			regulator-allowed-modes = <RPMH_REGULATOR_MODE_LPM
						   RPMH_REGULATOR_MODE_HPM>;
		};
	};
};

/* UFS storage, wired as stock has it (reset on GPIO 175). */
&ufs_mem_hc {
	reset-gpios = <&tlmm 175 GPIO_ACTIVE_LOW>;

	vcc-supply = <&vreg_l7b_2p952>;
	vcc-max-microamp = <800000>;
	vccq-supply = <&vreg_l9b_1p2>;
	vccq-max-microamp = <900000>;

	status = "okay";
};

&ufs_mem_phy {
	vdda-phy-supply = <&vreg_l10c_0p88>;
	vdda-pll-supply = <&vreg_l6b_1p2>;

	status = "okay";
};

/*
 * USB-C in device mode only, USB 2.0: the PC on the other end of the cable
 * gets jk_os's USB network and serial console. Host mode and the role
 * switching that goes with it need the Type-C controller (Samsung's
 * SM5714), which has no mainline driver yet.
 */
&usb_1 {
	dr_mode = "peripheral";
	maximum-speed = "high-speed";
	/* No USB 3 PHY: the controller takes its pipe clock from UTMI. */
	qcom,select-utmi-as-pipe-clk;
	phys = <&usb_1_hsphy>;
	phy-names = "usb2-phy";
	/delete-property/ usb-role-switch;

	status = "okay";
};

&usb_1_hsphy {
	vdda-pll-supply = <&vreg_l10c_0p88>;
	vdda18-supply = <&vreg_l1c_1p8>;
	vdda33-supply = <&vreg_l2b_3p072>;

	status = "okay";
};

/*
 * The Book Cover Keyboard: the pogo pins end at an STM32 MCU in the tablet,
 * on QUP SE4's I2C bus at 0x2a (stock: stm32@2a on qupv3_se4_i2c). conn
 * (GPIO 21) goes high when a keyboard is attached, the MCU signals events
 * on attn (GPIO 51, level low), nrst (GPIO 45) resets it.
 */
&qupv3_id_0 {
	status = "okay";
};

&i2c4 {
	status = "okay";

	keyboard@2a {
		compatible = "samsung,stm32-pogo";
		reg = <0x2a>;

		vdd-supply = <&vreg_l3c_2p8>;
		conn-gpios = <&tlmm 21 GPIO_ACTIVE_HIGH>;
		attn-gpios = <&tlmm 51 GPIO_ACTIVE_HIGH>;
		nrst-gpios = <&tlmm 45 GPIO_ACTIVE_HIGH>;

		pinctrl-0 = <&pogo_attn>, <&pogo_conn>, <&pogo_swclk>, <&pogo_nrst>;
		pinctrl-names = "default";
	};
};

&tlmm {
	pogo_attn: pogo-attn-state {
		pins = "gpio51";
		function = "gpio";
		drive-strength = <2>;
		bias-disable;
	};

	pogo_conn: pogo-conn-state {
		pins = "gpio21";
		function = "gpio";
		drive-strength = <2>;
		bias-disable;
	};

	/* The MCU's debug clock, held low as stock does. */
	pogo_swclk: pogo-swclk-state {
		pins = "gpio46";
		function = "gpio";
		drive-strength = <2>;
		output-low;
		bias-disable;
	};

	pogo_nrst: pogo-nrst-state {
		pins = "gpio45";
		function = "gpio";
		drive-strength = <2>;
		output-high;
		bias-disable;
	};
};

/* Stock xbl_uefi region starts 16 KiB lower than kodiak.dtsi's. */
&reserved_xbl_uefi_log {
	reg = <0x0 0x80880000 0x0 0x14000>;
};
