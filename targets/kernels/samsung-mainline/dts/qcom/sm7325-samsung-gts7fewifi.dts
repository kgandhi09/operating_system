// SPDX-License-Identifier: BSD-3-Clause
/*
 * Samsung Galaxy Tab S7 FE Wi-Fi (SM-T733, "gts7fewifi"), Snapdragon 778G
 * (SM7325, Qualcomm's "yupik").
 *
 * Bring-up stage 1: just enough to see the kernel log on the display the
 * bootloader left on (simple-framebuffer) and keep the log across a reboot
 * (ramoops). Everything else in sm7325.dtsi stays disabled until its board
 * wiring is known.
 *
 * Values come from the stock firmware T733XXS9DYF1 (scripts/inspect-stock.sh):
 * the base tree in vendor_boot.img and Samsung's board overlay in dtbo.img
 * ("Samsung GTS7FEWIFI PROJECT").
 */

/dts-v1/;

#include <dt-bindings/arm/qcom,ids.h>

#include "sm7325.dtsi"

/ {
	model = "Samsung Galaxy Tab S7 FE Wi-Fi (SM-T733)";
	compatible = "samsung,gts7fewifi", "qcom,sm7325";
	chassis-type = "tablet";

	/*
	 * The bootloader picks the tree by these. The same as the stock base
	 * tree ("Yupik SoC"): SM7325 and SoC id 0x203, a variant mainline's
	 * qcom,ids.h has no name for; board-id 0 0 as the base tree has (the
	 * board's own <0x22 rev> are in the dtbo overlays, which jk_os keeps
	 * empty: targets/devices/tablet/samsung-gts7fe/dtbo). dtbo-version, as
	 * the stock base tree has it, matches the overlays'.
	 */
	qcom,msm-id = <QCOM_ID_SM7325 0x10000>, <0x203 0x10000>;
	qcom,board-id = <0 0>;
	dtbo-version = <0>;

	/*
	 * Nodes Samsung's bootloader updates before starting the kernel, under
	 * the names it looks them up by (its strings: "/memory",
	 * "/firmware/android/fstab"), as stock's tree has them. With
	 * mainline's (memory@80000000, no android node) our tree fell back to
	 * Download mode where stock's didn't. It fills in the memory size.
	 */
	/delete-node/ memory@80000000;

	memory {
		device_type = "memory";
		reg = <0x0 0x0 0x0 0x0>;
	};

	firmware {
		android {
			compatible = "android,firmware";

			vbmeta {
				compatible = "android,vbmeta";
				parts = "vbmeta,boot,system,vendor,dtbo";
			};

			fstab {
				compatible = "android,fstab";
			};
		};
	};

	chosen {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		/*
		 * The bootloader's splash buffer (stock splash_region), which it
		 * keeps scanning out to the panel: 1600x2560 portrait (Samsung's
		 * ss_dsi_panel_*_WQXGA, 0x640 x 0xa00).
		 */
		framebuffer0: framebuffer@e1000000 {
			compatible = "simple-framebuffer";
			reg = <0x0 0xe1000000 0x0 (1600 * 2560 * 4)>;
			width = <1600>;
			height = <2560>;
			stride = <(1600 * 4)>;
			format = "a8r8g8b8";
			/*
			 * No clocks or power domain: simpledrm would wait for the
			 * display clock driver to probe before showing anything.
			 * clk_ignore_unused / pd_ignore_unused (DEVICE_CMDLINE)
			 * keep them on meanwhile.
			 */
		};
	};

	/*
	 * Memory the firmware uses that kodiak.dtsi doesn't reserve (or
	 * reserves smaller), from the stock base tree and Samsung's overlay.
	 * The kernel touching any of it can reset the SoC.
	 */
	reserved-memory {
		cdsp_secure_heap_mem: cdsp-secure-heap@81800000 {
			reg = <0x0 0x81800000 0x0 0x1e00000>;
			no-map;
		};

		video_fw_mem: video-fw@8ad00000 {
			reg = <0x0 0x8ad00000 0x0 0x500000>;
			no-map;
		};

		ipa_gsi_mem: ipa-gsi@8b710000 {
			reg = <0x0 0x8b710000 0x0 0xa000>;
			no-map;
		};

		dummy_mem: dummy@9c700000 {
			reg = <0x0 0x9c700000 0x0 0x100000>;
			no-map;
		};

		hdm_mem: hdm@9fb00000 {
			reg = <0x0 0x9fb00000 0x0 0x1000>;
			no-map;
		};

		kaslr_mem: kaslr@a0001000 {
			reg = <0x0 0xa0001000 0x0 0x1000>;
			no-map;
		};

		tima_mem: tima@b0100000 {
			reg = <0x0 0xb0100000 0x0 0x100000>;
			no-map;
		};

		removed_mem: removed@c0000000 {
			reg = <0x0 0xc0000000 0x0 0x5100000>;
			no-map;
		};

		/* pil_trustedvm_region, qrtr-shmem and the two neuron blocks. */
		trustedvm_mem: trustedvm@d0800000 {
			reg = <0x0 0xd0800000 0x0 0x7800000>;
			no-map;
		};

		/*
		 * Named as stock names it: Samsung's bootloader keeps the display
		 * running for the kernel only if this region is called exactly
		 * splash_region (see sm8450-samsung-r0q.dts).
		 */
		splash_region: splash_region {
			reg = <0x0 0xe1000000 0x0 0x2300000>;
			no-map;
		};

		dfps_data_mem: dfps-data@e3300000 {
			reg = <0x0 0xe3300000 0x0 0x100000>;
			no-map;
		};

		/* Samsung's debug log (sec_debug) and platform log (ss_plog). */
		sec_debug_mem: sec-debug@f0000000 {
			reg = <0x0 0xf0000000 0x0 0xb00000>;
			no-map;
		};

		ramoops_mem: ramoops@f0b00000 {
			compatible = "ramoops";
			reg = <0x0 0xf0b00000 0x0 0x100000>;
			record-size = <0x40000>;
			console-size = <0x40000>;
			ftrace-size = <0x40000>;
			pmsg-size = <0x40000>;
		};
	};
};

/* Stock xbl_uefi region starts 16 KiB lower than kodiak.dtsi's. */
&reserved_xbl_uefi_log {
	reg = <0x0 0x80880000 0x0 0x14000>;
};
