# Kernel options for mainline + Samsung device trees (merged after
# configs/kernel/common.config and aarch64.config).
#
# Everything is built into the kernel, and the Android boot partition is
# small, so only the Qualcomm platform stays: the other SoC families
# arm64's defconfig enables (and their drivers) are left out.
CONFIG_ARCH_QCOM=y
# CONFIG_ARCH_ACTIONS is not set
# CONFIG_ARCH_AIROHA is not set
# CONFIG_ARCH_SUNXI is not set
# CONFIG_ARCH_ALPINE is not set
# CONFIG_ARCH_APPLE is not set
# CONFIG_ARCH_ARTPEC is not set
# CONFIG_ARCH_ASPEED is not set
# CONFIG_ARCH_AXIADO is not set
# CONFIG_ARCH_BCM is not set
# CONFIG_ARCH_BCM2835 is not set
# CONFIG_ARCH_BCM_IPROC is not set
# CONFIG_ARCH_BCMBCA is not set
# CONFIG_ARCH_BRCMSTB is not set
# CONFIG_ARCH_BERLIN is not set
# CONFIG_ARCH_BLAIZE is not set
# CONFIG_ARCH_BST is not set
# CONFIG_ARCH_CIX is not set
# CONFIG_ARCH_EXYNOS is not set
# CONFIG_ARCH_K3 is not set
# CONFIG_ARCH_LG1K is not set
# CONFIG_ARCH_HISI is not set
# CONFIG_ARCH_KEEMBAY is not set
# CONFIG_ARCH_MEDIATEK is not set
# CONFIG_ARCH_MESON is not set
# CONFIG_ARCH_MICROCHIP is not set
# CONFIG_ARCH_SPARX5 is not set
# CONFIG_ARCH_MVEBU is not set
# CONFIG_ARCH_NXP is not set
# CONFIG_ARCH_LAYERSCAPE is not set
# CONFIG_ARCH_MXC is not set
# CONFIG_ARCH_S32 is not set
# CONFIG_ARCH_MA35 is not set
# CONFIG_ARCH_NPCM is not set
# CONFIG_ARCH_REALTEK is not set
# CONFIG_ARCH_RENESAS is not set
# CONFIG_ARCH_ROCKCHIP is not set
# CONFIG_ARCH_SEATTLE is not set
# CONFIG_ARCH_INTEL_SOCFPGA is not set
# CONFIG_ARCH_SOPHGO is not set
# CONFIG_ARCH_STM32 is not set
# CONFIG_ARCH_SYNQUACER is not set
# CONFIG_ARCH_TEGRA is not set
# CONFIG_ARCH_TESLA_FSD is not set
# CONFIG_ARCH_SPRD is not set
# CONFIG_ARCH_THUNDER is not set
# CONFIG_ARCH_THUNDER2 is not set
# CONFIG_ARCH_UNIPHIER is not set
# CONFIG_ARCH_VEXPRESS is not set
# CONFIG_ARCH_VISCONTI is not set
# CONFIG_ARCH_XGENE is not set
# CONFIG_ARCH_ZYNQMP is not set

# Bring-up: the kernel log on the display the bootloader left on comes from
# simpledrm (common.config), which drives the device tree's
# simple-framebuffer. The previous boot's log is kept across a reboot in RAM
# (pstore/ramoops).
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_RAM=y

# Large drivers for hardware a Qualcomm tablet can't have (PCIe GPUs and
# network cards, hypervisors), which defconfig enables and jk_os would build
# in: they only make the kernel bigger than the bootloader likes.
# CONFIG_DRM_NOUVEAU is not set
# CONFIG_DRM_AMDGPU is not set
# CONFIG_DRM_RADEON is not set
# CONFIG_NET_VENDOR_MELLANOX is not set
# CONFIG_IWLWIFI is not set
# CONFIG_ATH12K is not set
# CONFIG_INFINIBAND is not set
# CONFIG_XEN is not set
# CONFIG_KVM is not set

# The console turned to the tablet's landscape orientation (the panel is
# portrait): DEVICE_CMDLINE's fbcon=rotate.
CONFIG_FRAMEBUFFER_CONSOLE_ROTATION=y

# Stage 2: storage, USB dual role, the keyboard. Named here so a missing
# one is reported (most come from arm64's defconfig already).
CONFIG_SCSI_UFSHCD=y
CONFIG_SCSI_UFS_QCOM=y
CONFIG_PHY_QCOM_QMP_UFS=y
CONFIG_PHY_QCOM_USB_SNPS_FEMTO_V2=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_DUAL_ROLE=y
CONFIG_USB_DWC3_QCOM=y
CONFIG_REGULATOR_QCOM_RPMH=y
CONFIG_QCOM_GENI_SE=y
CONFIG_I2C_QCOM_GENI=y
CONFIG_INPUT_EVDEV=y
# The Book Cover Keyboard on the pogo pins (patches/0001-...).
CONFIG_KEYBOARD_SAMSUNG_STM32_POGO=y

# Stage 4: the display through msm (DPU, DSI and its 7 nm PHY, the display
# clock controller) with the panel's own driver, and the touchscreen on SPI
# (patches/0002-0005). Most come from arm64's defconfig already.
CONFIG_DRM_MSM=y
CONFIG_DRM_MSM_DPU=y
CONFIG_DRM_MSM_DSI=y
CONFIG_DRM_MSM_DSI_7NM_PHY=y
CONFIG_SC_DISPCC_7280=y
CONFIG_DRM_DISPLAY_DSC_HELPER=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y
CONFIG_DRM_PANEL_SAMSUNG_TS124QDM_FT8203=y
CONFIG_SPI_QCOM_GENI=y
CONFIG_QCOM_GPI_DMA=y
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_TOUCHSCREEN_FOCALTECH_FT8203=y

# Stage 6-8: Wi-Fi (ath11k on the WPSS) and Bluetooth (WCN6750), the GPU
# (msm's Adreno), the S Pen (patches/0007) and the cover switch (gpio-keys).
CONFIG_REMOTEPROC=y
CONFIG_QCOM_Q6V5_PAS=y
CONFIG_RPMSG_QCOM_GLINK_SMEM=y
CONFIG_QRTR=y
CONFIG_QRTR_SMD=y
CONFIG_ATH11K=y
CONFIG_ATH11K_AHB=y
CONFIG_BT=y
CONFIG_BT_HCIUART=y
CONFIG_BT_HCIUART_SERDEV=y
CONFIG_BT_HCIUART_QCA=y
CONFIG_SERIAL_QCOM_GENI=y
CONFIG_KEYBOARD_GPIO=y
CONFIG_TOUCHSCREEN_SAMSUNG_W90XX=y
# Stage 5: battery and charging, Silicon Mitus SM5714 (patches/0006).
CONFIG_CHARGER_SM5714=y

# SM-T733 USB-C: SM5714 TCPM + charger/MUIC, PS5169 and DP AUX routing.
CONFIG_TYPEC=y
CONFIG_TYPEC_TCPM=y
CONFIG_TYPEC_SM5714=y
CONFIG_USB_ROLE_SWITCH=y
CONFIG_TYPEC_MUX_PS5169=y
CONFIG_TYPEC_MUX_GPIO_SBU=y
CONFIG_TYPEC_DP_ALTMODE=y
CONFIG_PHY_QCOM_QMP_COMBO=y
CONFIG_DRM_MSM_DP=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PLATFORM=y
CONFIG_USB_HID=y
CONFIG_HID_GENERIC=y

# Crash diagnosis: the PMIC's power-on log (patches/0010: why it last reset
# or powered off the tablet) and pressure stall information (memory, CPU and
# I/O pressure, which jk-crashlog records).
CONFIG_QCOM_PMIC_PON_LOG=y
CONFIG_PSI=y
