# U-Boot options for the tablet, over qcom_defconfig + qcom-phone.config.
# Room to unpack jk_os's kernel (about 60 MB uncompressed).
CONFIG_SYS_BOOTM_LEN=0x8000000
# The EFI capsule tool (firmware updates through EFI, unused here) would
# need GnuTLS on the build machine.
# CONFIG_TOOLS_MKEFICAPSULE is not set
# U-Boot's own lines on a black screen, not over the Samsung logo.
# CONFIG_NO_FB_CLEAR is not set
# imxtract unpacks the kernel (about 60 MB) out of the FIT image for bootefi.
CONFIG_SYS_XIMG_LEN=0x8000000
# pstore: show the previous kernel's log on the display, from the device
# tree's ramoops region (the same sizes as there).
CONFIG_CMD_PSTORE=y
CONFIG_CMD_PSTORE_MEM_ADDR=0xf0b00000
CONFIG_CMD_PSTORE_MEM_SIZE=0x100000
CONFIG_CMD_PSTORE_RECORD_SIZE=0x40000
CONFIG_CMD_PSTORE_CONSOLE_SIZE=0x40000
CONFIG_CMD_PSTORE_FTRACE_SIZE=0x40000
CONFIG_CMD_PSTORE_PMSG_SIZE=0x40000
