# NVIDIA Jetson Orin NX. Since JetPack 6 its firmware is UEFI and passes the
# device tree, so the aarch64 ISO (on a USB stick) can boot it. Mainline has
# no Jetson GPU driver: no CUDA on this kernel.
DEVICE_DESC="NVIDIA Jetson Orin NX"
DEVICE_ARCHS="aarch64"
DEVICE_KERNELS="mainline"
DEVICE_BOOT=efi-iso
DEVICE_STATUS="untested"
