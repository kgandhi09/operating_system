From: jk_os <jk_os@jkrobotics.tech>
Subject: [PATCH] drm/panel: add Samsung TS124QDM (FocalTech FT8203) panel

The 12.4" 1600x2560 TFT of the Samsung Galaxy Tab S7 FE: DSI video mode,
4 lanes, DSC 1.1, brightness over DCS (12 bits). Init sequence, timings
and DSC parameters from the stock device tree; based on the SM-T735 port
by Mark (Marker284).

---
--- a/drivers/gpu/drm/panel/Kconfig
+++ b/drivers/gpu/drm/panel/Kconfig
@@ -1030,6 +1030,17 @@
 	    M1906F9 (M1906F9SH or M1906F9SI), 6.09 inch 720x1560, found
 	    in the Xiaomi Mi A3 smartphone (xiaomi-laurel).
 
+config DRM_PANEL_SAMSUNG_TS124QDM_FT8203
+	tristate "Samsung TS124QDM panel with a FocalTech FT8203"
+	depends on OF
+	depends on DRM_MIPI_DSI
+	depends on BACKLIGHT_CLASS_DEVICE
+	select DRM_DISPLAY_DSC_HELPER
+	help
+	  Say Y here to enable support for the 12.4" 1600x2560 TS124QDM
+	  TFT panel with a FocalTech FT8203 driver IC (DSC 1.1, video mode),
+	  as found in the Samsung Galaxy Tab S7 FE.
+
 config DRM_PANEL_SAMSUNG_SOFEF00
 	tristate "Samsung SOFEF00 DSI panel controller"
 	depends on GPIOLIB
--- a/drivers/gpu/drm/panel/Makefile
+++ b/drivers/gpu/drm/panel/Makefile
@@ -102,6 +102,7 @@
 obj-$(CONFIG_DRM_PANEL_SAMSUNG_S6E8AA0) += panel-samsung-s6e8aa0.o
 obj-$(CONFIG_DRM_PANEL_SAMSUNG_S6E8AA5X01_AMS561RA01) += panel-samsung-s6e8aa5x01-ams561ra01.o
 obj-$(CONFIG_DRM_PANEL_SAMSUNG_S6E8FC0) += panel-samsung-s6e8fc0-m1906f9.o
+obj-$(CONFIG_DRM_PANEL_SAMSUNG_TS124QDM_FT8203) += panel-samsung-ts124qdm-ft8203.o
 obj-$(CONFIG_DRM_PANEL_SAMSUNG_SOFEF00) += panel-samsung-sofef00.o
 obj-$(CONFIG_DRM_PANEL_SEIKO_43WVF1G) += panel-seiko-43wvf1g.o
 obj-$(CONFIG_DRM_PANEL_SHARP_LQ079L1SX01) += panel-sharp-lq079l1sx01.o
--- /dev/null
+++ b/drivers/gpu/drm/panel/panel-samsung-ts124qdm-ft8203.c
@@ -0,0 +1,759 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Samsung TS124QDM panel with a FocalTech FT8203 driver IC: the 12.4"
+ * 1600x2560 TFT of the Samsung Galaxy Tab S7 FE (Samsung's name for it:
+ * ss_dsi_panel_FT8203_TS124QDM_WQXGA). Video mode, 4 lanes, DSC 1.1.
+ *
+ * The init sequence, timings and DSC parameters are the stock device tree's
+ * (Samsung's dtbo for the SM-T733 and SM-T735 carry the same ones). Based
+ * on the SM-T735 port by Mark (Marker284,
+ * github.com/Marker284/samsung-gts7xllite-display-touch), which generated it
+ * with linux-mdss-dsi-panel-driver-generator.
+ *
+ * The FT8203 is a TDDI chip: the touchscreen (focaltech-ft8203) follows this
+ * panel, since it only runs while the panel is powered and out of reset.
+ */
+
+#include <linux/backlight.h>
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/regulator/consumer.h>
+
+#include <video/mipi_display.h>
+
+#include <drm/display/drm_dsc.h>
+#include <drm/display/drm_dsc_helper.h>
+#include <drm/drm_mipi_dsi.h>
+#include <drm/drm_modes.h>
+#include <drm/drm_panel.h>
+
+/*
+ * Bring-up switches, settable on the kernel command line
+ * (panel_samsung_ts124qdm_ft8203.<name>=...) so variants can be tried
+ * without a rebuild.
+ */
+static bool no_dsc;
+module_param(no_dsc, bool, 0444);
+MODULE_PARM_DESC(no_dsc, "drive the panel uncompressed (default: DSC)");
+
+static int traffic = 2;
+module_param(traffic, int, 0444);
+MODULE_PARM_DESC(traffic, "DSI video traffic: 0 sync events, 1 sync pulses, 2 burst (default)");
+
+static int slice_per_pkt = 2;
+module_param(slice_per_pkt, int, 0444);
+MODULE_PARM_DESC(slice_per_pkt, "DSC slices per DSI packet (stock: 2)");
+
+/*
+ * Stock leaves block prediction off (no qcom,mdss-dsc-block-prediction-
+ * enable) and never sends a PPS (samsung,no_qcom_pps): the panel decodes
+ * with its own. Encoding with block prediction on put noise next to text,
+ * along the panel's lines, where the encoder chooses it.
+ */
+static bool block_pred;
+module_param(block_pred, bool, 0444);
+MODULE_PARM_DESC(block_pred, "DSC block prediction (stock: off)");
+
+/*
+ * Brightness: 12 bits in DCS 0x51, the upper 8 in the first byte and the
+ * lower 4 in the second (Samsung's FT8203 panel drivers). The stock default
+ * is 0x64b.
+ */
+#define TS124QDM_BRIGHTNESS_MAX		4095
+#define TS124QDM_BRIGHTNESS_DEFAULT	1611
+
+struct ts124qdm {
+	struct drm_panel panel;
+	struct mipi_dsi_device *dsi;
+	struct regulator_bulk_data supplies[3];
+	struct gpio_desc *reset_gpio;
+	struct drm_dsc_config dsc;
+	enum drm_panel_orientation orientation;
+	bool prepared;
+};
+
+static inline struct ts124qdm *to_ts124qdm(struct drm_panel *panel)
+{
+	return container_of(panel, struct ts124qdm, panel);
+}
+
+#define dsi_dcs_write_seq(dsi, seq...) do {				\
+		static const u8 d[] = { seq };				\
+		int ret;						\
+		ret = mipi_dsi_dcs_write_buffer(dsi, d, ARRAY_SIZE(d));	\
+		if (ret < 0)						\
+			return ret;					\
+	} while (0)
+
+/* Stock: qcom,mdss-dsi-reset-sequence = <1 5>, <0 4>, <1 12> (ms). */
+static void ts124qdm_reset(struct ts124qdm *ctx)
+{
+	gpiod_set_value_cansleep(ctx->reset_gpio, 0);
+	usleep_range(5000, 6000);
+	gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+	usleep_range(4000, 5000);
+	gpiod_set_value_cansleep(ctx->reset_gpio, 0);
+	usleep_range(12000, 13000);
+}
+
+static int ts124qdm_set_brightness(struct mipi_dsi_device *dsi, u16 level)
+{
+	u8 cmd[] = { MIPI_DCS_SET_DISPLAY_BRIGHTNESS, level >> 4, level & 0x0f };
+	int ret;
+
+	dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
+	ret = mipi_dsi_dcs_write_buffer(dsi, cmd, sizeof(cmd));
+	dsi->mode_flags |= MIPI_DSI_MODE_LPM;
+
+	return ret < 0 ? ret : 0;
+}
+
