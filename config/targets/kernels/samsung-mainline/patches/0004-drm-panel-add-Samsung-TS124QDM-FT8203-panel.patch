+	 * of ctx->dsc by the time the panel is prepared.
+	 */
+	if (no_dsc) {
+		ret = mipi_dsi_compression_mode(dsi, false);
+		if (ret < 0) {
+			dev_err(dev, "failed to disable compression: %d\n", ret);
+			return ret;
+		}
+	} else {
+		drm_dsc_pps_payload_pack(&pps, &ctx->dsc);
+		ret = mipi_dsi_picture_parameter_set(dsi, &pps);
+		if (ret < 0) {
+			dev_err(dev, "failed to send the PPS: %d\n", ret);
+			return ret;
+		}
+		ret = mipi_dsi_compression_mode(dsi, true);
+		if (ret < 0) {
+			dev_err(dev, "failed to enable compression: %d\n", ret);
+			return ret;
+		}
+	}
+
+	ret = mipi_dsi_dcs_set_display_on(dsi);
+	if (ret < 0) {
+		dev_err(dev, "failed to set display on: %d\n", ret);
+		return ret;
+	}
+	/* Tearing effect line on, V-blank only, as stock. */
+	dsi_dcs_write_seq(dsi, MIPI_DCS_SET_TEAR_ON, 0x00);
+	msleep(32);
+
+	/*
+	 * Backlight control on (stock: tft_pwm_tx_cmds, 0x53 0x24) and the
+	 * content adaptive brightness mode stock uses (0x55 0x01).
+	 */
+	dsi_dcs_write_seq(dsi, MIPI_DCS_WRITE_CONTROL_DISPLAY, 0x24);
+	dsi_dcs_write_seq(dsi, MIPI_DCS_WRITE_POWER_SAVE, 0x01);
+
+	return 0;
+}
+
+static int ts124qdm_off(struct ts124qdm *ctx)
+{
+	struct mipi_dsi_device *dsi = ctx->dsi;
+	struct device *dev = &dsi->dev;
+	int ret;
+
+	ret = mipi_dsi_dcs_set_display_off(dsi);
+	if (ret < 0)
+		dev_err(dev, "failed to set display off: %d\n", ret);
+
+	ret = mipi_dsi_dcs_enter_sleep_mode(dsi);
+	if (ret < 0) {
+		dev_err(dev, "failed to enter sleep mode: %d\n", ret);
+		return ret;
+	}
+	msleep(32);
+
+	return 0;
+}
+
+static int ts124qdm_prepare(struct drm_panel *panel)
+{
+	struct ts124qdm *ctx = to_ts124qdm(panel);
+	struct device *dev = &ctx->dsi->dev;
+	int ret;
+
+	if (ctx->prepared)
+		return 0;
+
+	/* On for good (regulator-always-on): the bootloader set them up. */
+	ret = regulator_bulk_enable(ARRAY_SIZE(ctx->supplies), ctx->supplies);
+	if (ret < 0) {
+		dev_err(dev, "failed to enable regulators: %d\n", ret);
+		return ret;
+	}
+
+	ts124qdm_reset(ctx);
+
+	ret = ts124qdm_on(ctx);
+	if (ret < 0) {
+		dev_err(dev, "failed to initialize panel: %d\n", ret);
+		gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+		regulator_bulk_disable(ARRAY_SIZE(ctx->supplies), ctx->supplies);
+		return ret;
+	}
+
+	ctx->prepared = true;
+	return 0;
+}
+
+static int ts124qdm_unprepare(struct drm_panel *panel)
+{
+	struct ts124qdm *ctx = to_ts124qdm(panel);
+
+	if (!ctx->prepared)
+		return 0;
+
+	ts124qdm_off(ctx);
+	gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+	regulator_bulk_disable(ARRAY_SIZE(ctx->supplies), ctx->supplies);
+
+	ctx->prepared = false;
+	return 0;
+}
+
+/* Stock timings: hfp 90, hsync 8, hbp 89; vfp 16, vsync 8, vbp 13; 60 Hz. */
+static const struct drm_display_mode ts124qdm_mode = {
+	.clock = (1600 + 90 + 8 + 89) * (2560 + 16 + 8 + 13) * 60 / 1000,
+	.hdisplay = 1600,
+	.hsync_start = 1600 + 90,
+	.hsync_end = 1600 + 90 + 8,
+	.htotal = 1600 + 90 + 8 + 89,
+	.vdisplay = 2560,
+	.vsync_start = 2560 + 16,
+	.vsync_end = 2560 + 16 + 8,
+	.vtotal = 2560 + 16 + 8 + 13,
+	.width_mm = 166,
+	.height_mm = 266,
+	.type = DRM_MODE_TYPE_DRIVER,
+};
+
+static int ts124qdm_get_modes(struct drm_panel *panel,
+			      struct drm_connector *connector)
+{
+	struct ts124qdm *ctx = to_ts124qdm(panel);
+	struct drm_display_mode *mode;
+
+	mode = drm_mode_duplicate(connector->dev, &ts124qdm_mode);
+	if (!mode)
+		return -ENOMEM;
+
+	drm_mode_set_name(mode);
+	mode->type |= DRM_MODE_TYPE_PREFERRED;
+	connector->display_info.width_mm = mode->width_mm;
+	connector->display_info.height_mm = mode->height_mm;
+	drm_mode_probed_add(connector, mode);
+
+	/* Before drm_dev_register(): the property can't be added later. */
+	drm_connector_set_panel_orientation(connector, ctx->orientation);
+
+	return 1;
+}
+
+static enum drm_panel_orientation ts124qdm_get_orientation(struct drm_panel *panel)
+{
+	return to_ts124qdm(panel)->orientation;
+}
+
+static const struct drm_panel_funcs ts124qdm_panel_funcs = {
+	.prepare = ts124qdm_prepare,
+	.unprepare = ts124qdm_unprepare,
+	.get_modes = ts124qdm_get_modes,
+	.get_orientation = ts124qdm_get_orientation,
+};
+
+static int ts124qdm_bl_update_status(struct backlight_device *bl)
+{
+	struct ts124qdm *ctx = bl_get_data(bl);
+
+	/* Kept for the next power-up: the panel takes commands only when on. */
+	if (!ctx->prepared)
+		return 0;
+
+	return ts124qdm_set_brightness(ctx->dsi, backlight_get_brightness(bl));
+}
+
+static const struct backlight_ops ts124qdm_bl_ops = {
+	.update_status = ts124qdm_bl_update_status,
+};
+
+static int ts124qdm_probe(struct mipi_dsi_device *dsi)
+{
+	struct device *dev = &dsi->dev;
+	const struct backlight_properties props = {
+		.type = BACKLIGHT_RAW,
+		.brightness = TS124QDM_BRIGHTNESS_DEFAULT,
+		.max_brightness = TS124QDM_BRIGHTNESS_MAX,
+	};
+	struct ts124qdm *ctx;
+	int ret;
+
+	ctx = devm_drm_panel_alloc(dev, struct ts124qdm, panel,
+				   &ts124qdm_panel_funcs, DRM_MODE_CONNECTOR_DSI);
+	if (IS_ERR(ctx))
+		return PTR_ERR(ctx);
+
+	ctx->supplies[0].supply = "vddi";
+	ctx->supplies[1].supply = "avdd";
+	ctx->supplies[2].supply = "avee";
+	ret = devm_regulator_bulk_get(dev, ARRAY_SIZE(ctx->supplies), ctx->supplies);
+	if (ret < 0)
+		return dev_err_probe(dev, ret, "failed to get regulators\n");
+
+	/*
+	 * Out of reset, as the bootloader left it (showing its picture), until
+	 * msm brings the link up and prepares the panel.
+	 */
+	ctx->reset_gpio = devm_gpiod_get(dev, "reset", GPIOD_OUT_LOW);
+	if (IS_ERR(ctx->reset_gpio))
+		return dev_err_probe(dev, PTR_ERR(ctx->reset_gpio),
+				     "failed to get the reset GPIO\n");
+
+	ret = of_drm_get_panel_orientation(dev->of_node, &ctx->orientation);
+	if (ret < 0)
+		return dev_err_probe(dev, ret, "bad rotation property\n");
+
+	ctx->dsi = dsi;
+	mipi_dsi_set_drvdata(dsi, ctx);
+
+	/* The init sequence goes over DSI: the host has to be up first. */
+	ctx->panel.prepare_prev_first = true;
+
+	/* Stock: DSC 1.1, two 800x40 slices per line, 8 bits per pixel. */
+	ctx->dsc.dsc_version_major = 1;
+	ctx->dsc.dsc_version_minor = 1;
+	ctx->dsc.slice_height = 40;
+	ctx->dsc.slice_width = 800;
+	ctx->dsc.slice_count = 2;
+	ctx->dsc.bits_per_component = 8;
+	ctx->dsc.bits_per_pixel = 8 << 4;
+	ctx->dsc.block_pred_enable = block_pred;
+	if (!no_dsc) {
+		dsi->dsc = &ctx->dsc;
+		dsi->dsc_slice_per_pkt = slice_per_pkt;
+	}
+
+	dsi->lanes = 4;
+	dsi->format = MIPI_DSI_FMT_RGB888;
+	/*
+	 * Burst: stock runs the link at 676 Mbps per lane while the compressed
+	 * stream needs about 557 (it sets bllp-power-mode, none of the
+	 * hfp/hbp/hsa ones). Non-burst gave PHY errors and a lit, blank panel
+	 * on the SM-T735.
+	 */
+	dsi->mode_flags = MIPI_DSI_MODE_VIDEO | MIPI_DSI_CLOCK_NON_CONTINUOUS |
+			  MIPI_DSI_MODE_LPM;
+	if (traffic == 1)
+		dsi->mode_flags |= MIPI_DSI_MODE_VIDEO_SYNC_PULSE;
+	else if (traffic == 2)
+		dsi->mode_flags |= MIPI_DSI_MODE_VIDEO_BURST;
+
+	ctx->panel.backlight = devm_backlight_device_register(dev, dev_name(dev),
+							      dev, ctx,
+							      &ts124qdm_bl_ops,
+							      &props);
+	if (IS_ERR(ctx->panel.backlight))
+		return dev_err_probe(dev, PTR_ERR(ctx->panel.backlight),
+				     "failed to register the backlight\n");
+
+	drm_panel_add(&ctx->panel);
+
+	ret = mipi_dsi_attach(dsi);
+	if (ret < 0) {
+		drm_panel_remove(&ctx->panel);
+		return dev_err_probe(dev, ret, "failed to attach to DSI host\n");
+	}
+
+	return 0;
+}
+
+static void ts124qdm_remove(struct mipi_dsi_device *dsi)
+{
+	struct ts124qdm *ctx = mipi_dsi_get_drvdata(dsi);
+	int ret;
+
+	ret = mipi_dsi_detach(dsi);
+	if (ret < 0)
+		dev_err(&dsi->dev, "failed to detach from DSI host: %d\n", ret);
+
+	drm_panel_remove(&ctx->panel);
+}
+
+static const struct of_device_id ts124qdm_of_match[] = {
+	{ .compatible = "samsung,ts124qdm-ft8203" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, ts124qdm_of_match);
+
+static struct mipi_dsi_driver ts124qdm_driver = {
+	.probe = ts124qdm_probe,
+	.remove = ts124qdm_remove,
+	.driver = {
+		.name = "panel-samsung-ts124qdm-ft8203",
+		.of_match_table = ts124qdm_of_match,
+	},
+};
+module_mipi_dsi_driver(ts124qdm_driver);
+
+MODULE_DESCRIPTION("Samsung TS124QDM (FocalTech FT8203) panel driver");
+MODULE_LICENSE("GPL");
