# Sources of the build machine's own tools (scripts/build-hosttools.sh), the
# ones this repo doesn't already carry for jk_os itself; fetched by
# scripts/update-desktop-sources.sh --component hosttools into
# userspace/hosttools/<name>. With them the build needs nothing from a
# package manager (docs/self-hosting.md).
#
# <name>  <version>  <url, {v} = version; git+<repo>#<tag>[+submodules]>  <sha256 or commit>

# ---- The GNU basics, built first: the build then runs these, whatever the
# build machine's own are (BusyBox on a jk_os PC).
coreutils  9.12  https://ftp.gnu.org/gnu/coreutils/coreutils-{v}.tar.xz  a480198559733e9b3da999e90543ac6f888a2caa544d8d664c5a1f17e528e210
