 static void drag_icon_update_position(struct cg_drag_icon *drag_icon);
 
+#define CURSOR_HIDE_DELAY_MS 3000
+
+static int
+hide_idle_cursor(void *data)
+{
+	struct cg_seat *seat = data;
+	wlr_cursor_unset_image(seat->cursor);
+	seat->cursor_hidden = true;
+	return 0;
+}
+
+static void
+show_active_cursor(struct cg_seat *seat)
+{
+	if (wl_list_empty(&seat->pointers)) {
+		return;
+	}
+	if (seat->cursor_hidden) {
+		wlr_cursor_set_xcursor(seat->cursor, seat->xcursor_manager, DEFAULT_XCURSOR);
+		seat->cursor_hidden = false;
+	}
+	if (seat->cursor_hide_timer) {
+		wl_event_source_timer_update(seat->cursor_hide_timer, CURSOR_HIDE_DELAY_MS);
+	}
+}
+
