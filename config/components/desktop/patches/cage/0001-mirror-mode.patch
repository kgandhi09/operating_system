+/* Mirror mode: every output at 0,0 of the layout, each scaled so that all
+ * are as wide (in layout coordinates) as the narrowest one; views then fill
+ * the part all of them show (server_usable_box). */
+static void
+mirror_update(struct cg_server *server)
+{
+	/* Changing scales and positions changes the layout, which calls this
+	 * again (handle_output_layout_change). */
+	static bool updating = false;
+	if (server->output_mode != CAGE_MULTI_OUTPUT_MODE_MIRROR || updating) {
+		return;
+	}
+	updating = true;
+	int min_width = 0;
+	struct cg_output *output;
+	wl_list_for_each (output, &server->outputs, link) {
+		struct wlr_output *o = output->wlr_output;
+		if (o->enabled && o->width > 0 && (min_width == 0 || o->width < min_width)) {
+			min_width = o->width;
+		}
+	}
+	if (min_width == 0) {
+		updating = false;
+		return;
+	}
+	wl_list_for_each (output, &server->outputs, link) {
+		struct wlr_output *o = output->wlr_output;
+		if (!o->enabled || o->width <= 0) {
+			continue;
+		}
+		float scale = (float)o->width / (float)min_width;
+		if (scale < 1.0f) {
+			scale = 1.0f;
+		}
+		if (o->scale != scale) {
+			struct wlr_output_state state = {0};
+			wlr_output_state_set_scale(&state, scale);
+			wlr_output_commit_state(o, &state);
+			wlr_output_state_finish(&state);
+			wlr_xcursor_manager_load(server->seat->xcursor_manager, scale);
+		}
+		if (output->scene_output) {
+			output_layout_add(output, 0, 0);
+		}
+		wlr_log(WLR_DEBUG, "Mirroring on output %s (%dx%d, scale %.2f)", o->name, o->width, o->height,
+			o->scale);
+	}
+	updating = false;
+}
+
+void
+server_usable_box(struct cg_server *server, struct wlr_box *box)
+{
+	wlr_output_layout_get_box(server->output_layout, NULL, box);
+	if (server->output_mode != CAGE_MULTI_OUTPUT_MODE_MIRROR) {
+		return;
+	}
+	bool first = true;
+	struct cg_output *output;
+	wl_list_for_each (output, &server->outputs, link) {
+		struct wlr_box ob;
+		wlr_output_layout_get_box(server->output_layout, output->wlr_output, &ob);
+		if (wlr_box_empty(&ob)) {
+			continue;
+		}
+		if (first) {
+			*box = ob;
+			first = false;
+		} else {
+			if (ob.width < box->width) {
+				box->width = ob.width;
+			}
+			if (ob.height < box->height) {
+				box->height = ob.height;
+			}
+		}
+	}
+}
